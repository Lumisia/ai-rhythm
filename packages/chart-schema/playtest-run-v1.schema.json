{
  "$defs": {
    "AudioFileRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "AudioFileRef",
      "type": "object"
    },
    "MissingChartRef": {
      "additionalProperties": false,
      "description": "이번 실행에서 발행하지 못한 조합. 프론트가 목록에서 빠지는 근거다.",
      "properties": {
        "keyMode": {
          "enum": [
            4,
            6,
            7
          ],
          "title": "Keymode",
          "type": "integer"
        },
        "difficulty": {
          "enum": [
            "EASY",
            "NORMAL",
            "HARD",
            "EXPERT"
          ],
          "title": "Difficulty",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "keyMode",
        "difficulty",
        "reason"
      ],
      "title": "MissingChartRef",
      "type": "object"
    },
    "RunAudioRefs": {
      "additionalProperties": false,
      "properties": {
        "game": {
          "$ref": "#/$defs/AudioFileRef"
        },
        "noDrums": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioFileRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "keys": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioFileRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "game"
      ],
      "title": "RunAudioRefs",
      "type": "object"
    },
    "RunChartRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "keyMode": {
          "enum": [
            4,
            6,
            7
          ],
          "title": "Keymode",
          "type": "integer"
        },
        "difficulty": {
          "enum": [
            "EASY",
            "NORMAL",
            "HARD",
            "EXPERT"
          ],
          "title": "Difficulty",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "keyMode",
        "difficulty"
      ],
      "title": "RunChartRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "runId": {
      "format": "uuid",
      "title": "Runid",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "generatedAt": {
      "format": "date-time",
      "title": "Generatedat",
      "type": "string"
    },
    "workerVersion": {
      "minLength": 1,
      "title": "Workerversion",
      "type": "string"
    },
    "audio": {
      "$ref": "#/$defs/RunAudioRefs"
    },
    "charts": {
      "items": {
        "$ref": "#/$defs/RunChartRef"
      },
      "minItems": 1,
      "title": "Charts",
      "type": "array"
    },
    "missingCharts": {
      "items": {
        "$ref": "#/$defs/MissingChartRef"
      },
      "title": "Missingcharts",
      "type": "array"
    },
    "keysoundManifestPath": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Keysoundmanifestpath"
    },
    "generationReportPath": {
      "title": "Generationreportpath",
      "type": "string"
    }
  },
  "required": [
    "runId",
    "title",
    "generatedAt",
    "workerVersion",
    "audio",
    "charts",
    "generationReportPath"
  ],
  "title": "PlaytestRunManifest",
  "type": "object"
}
