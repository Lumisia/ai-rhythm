+def test_resnap_sidecar_uses_integer_milliseconds_for_lane_order_times(tmp_path):
+    osu_path = tmp_path / "beatmap.osu"
+    osu_path.write_bytes(b"osu-output")
+    collisions = [
+        {
+            "lane": 1,
+            "previousObjectId": 1308,
+            "currentObjectId": 1310,
+            "proposedPreviousEndMs": 360_800.0,
+            "proposedCurrentStartMs": 360_765.0,
+            "rawPreviousEndMs": 360_800.0,
+            "rawCurrentStartMs": 360_800.0,
+            "reason": "LANE_ORDER_RAW_RESTORED",
+        }
+    ]
+
+    sidecar_path = make_postprocessor().write_resnap_diagnostics(
+        osu_path,
+        seed=31,
+        collisions=collisions,
+    )
+    payload = json.loads(sidecar_path.read_text(encoding="utf-8"))
+    collision = payload["collisions"][0]
+
+    assert collision["proposedPreviousEndMs"] == 360_800
+    assert type(collision["proposedPreviousEndMs"]) is int
+    assert collision["proposedCurrentStartMs"] == 360_765
+    assert type(collision["proposedCurrentStartMs"]) is int
+    assert collision["rawPreviousEndMs"] == 360_800
+    assert type(collision["rawPreviousEndMs"]) is int
+    assert collision["rawCurrentStartMs"] == 360_800
+    assert type(collision["rawCurrentStartMs"]) is int
+    assert collisions[0]["proposedPreviousEndMs"] == 360_800.0
+    assert collisions[0]["proposedCurrentStartMs"] == 360_765.0
+    assert collisions[0]["rawPreviousEndMs"] == 360_800.0
+    assert collisions[0]["rawCurrentStartMs"] == 360_800.0
+
+
