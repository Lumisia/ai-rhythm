+    def _mania_prompt_group_signatures(
+            self,
+            context: dict[str, Any],
+            frame_time: float,
+            mania_keycount: int,
+    ) -> tuple[tuple[int, int, str], ...]:
+        """Return every canonical group in the frame, even if tokens trim it."""
+        frame_end = frame_time + self.miliseconds_per_sequence
+        groups = canonical_mania_groups(
+            context["events"],
+            context["event_times"],
+            keycount=mania_keycount,
+        )
+        signatures: list[tuple[int, int, str]] = []
+        for group in groups:
+            if not frame_time <= group.time_ms < frame_end:
+                continue
+            encoded_time = self._encode(
+                [Event(EventType.TIME_SHIFT, group.time_ms)],
+                frame_time,
+            )
+            signatures.append(
+                (
+                    int(encoded_time[0, 0].item()),
+                    group.lane,
+                    group.event_type.value,
+                )
+            )
+        return tuple(signatures)
