diff --git a/tests/test_mania_event_times.py b/tests/test_mania_event_times.py
index 183e530..b4a610f 100644
--- a/tests/test_mania_event_times.py
+++ b/tests/test_mania_event_times.py
@@ -1,3 +1,4 @@
+import json
 from datetime import timedelta
 from types import SimpleNamespace
 
@@ -80,3 +81,53 @@ def test_resnap_updates_event_tokens_and_explicit_times_together():
 
     assert snapped_events[0].value == 125
     assert snapped_times == [125, 125, 125, 125, 125]
+
+
+def test_resnap_reports_distinct_pre_times_collapsed_to_same_mania_lane():
+    events = [
+        Event(EventType.TIME_SHIFT, 110), Event(EventType.SNAPPING, 4),
+        Event(EventType.POS_X, 64), Event(EventType.POS_Y, 192),
+        Event(EventType.CIRCLE, 0), Event(EventType.TIME_SHIFT, 140),
+        Event(EventType.SNAPPING, 4), Event(EventType.POS_X, 64),
+        Event(EventType.POS_Y, 192), Event(EventType.HOLD_NOTE, 0),
+    ]
+    _, _, collisions = make_postprocessor().resnap_events(
+        events, [110] * 5 + [140] * 5, make_timing(), key_count=4,
+    )
+    assert collisions == [
+        {"lane": 0, "noteKind": "TAP", "preTimeMs": 110,
+         "postTimeMs": 125, "snapDivisor": 4},
+        {"lane": 0, "noteKind": "HOLD", "preTimeMs": 140,
+         "postTimeMs": 125, "snapDivisor": 4},
+    ]
+
+
+def test_resnap_does_not_report_same_time_on_different_mania_lanes():
+    events = [
+        Event(EventType.TIME_SHIFT, 110), Event(EventType.SNAPPING, 4),
+        Event(EventType.POS_X, 64), Event(EventType.POS_Y, 192),
+        Event(EventType.CIRCLE, 0), Event(EventType.TIME_SHIFT, 140),
+        Event(EventType.SNAPPING, 4), Event(EventType.POS_X, 192),
+        Event(EventType.POS_Y, 192), Event(EventType.CIRCLE, 0),
+    ]
+    _, _, collisions = make_postprocessor().resnap_events(
+        events, [110] * 5 + [140] * 5, make_timing(), key_count=4,
+    )
+    assert collisions == []
+
+
+def test_resnap_sidecar_is_written_next_to_generated_osu(tmp_path):
+    osu_path = tmp_path / "beatmap.osu"
+    collisions = [
+        {"lane": 0, "noteKind": "TAP", "preTimeMs": 110,
+         "postTimeMs": 125, "snapDivisor": 4}
+    ]
+    sidecar_path = make_postprocessor().write_resnap_diagnostics(
+        osu_path, seed=31, collisions=collisions,
+    )
+    assert sidecar_path == osu_path.with_suffix(".resnap.json")
+    assert json.loads(sidecar_path.read_text(encoding="utf-8")) == {
+        "version": "resnap-collisions-v1",
+        "seed": 31,
+        "collisions": collisions,
+    }
