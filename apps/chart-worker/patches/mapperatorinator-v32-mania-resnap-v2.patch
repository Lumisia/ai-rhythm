@@ -0,0 +1,181 @@
+import json
+from datetime import timedelta
+from types import SimpleNamespace
+
+from slider import TimingPoint
+
+from osuT5.osuT5.event import Event, EventType
+from osuT5.osuT5.inference.postprocessor import BeatmapConfig, Postprocessor
+
+
+def make_postprocessor() -> Postprocessor:
+    args = SimpleNamespace(
+        offset=0,
+        bpm=120,
+        timing_leniency=0,
+        train=SimpleNamespace(data=SimpleNamespace(
+            types_first=False,
+            add_positions=True,
+            mania_bpm_normalized_scroll_speed=False,
+            add_sv=False,
+        )),
+        start_time=None,
+        end_time=3_000,
+        snap_near_perfect_overlaps=False,
+    )
+    return Postprocessor(args)
+
+
+def make_timing() -> list[TimingPoint]:
+    return [TimingPoint(
+        timedelta(milliseconds=0),
+        500,
+        4,
+        2,
+        -1,
+        100,
+        None,
+        False,
+    )]
+
+
+def test_explicit_event_times_preserve_a_same_timestamp_second_group():
+    events = [
+        Event(EventType.TIME_SHIFT, 1_000),
+        Event(EventType.POS_X, 64),
+        Event(EventType.POS_Y, 192),
+        Event(EventType.CIRCLE, 0),
+        Event(EventType.POS_X, 192),
+        Event(EventType.POS_Y, 192),
+        Event(EventType.HOLD_NOTE, 0),
+        Event(EventType.TIME_SHIFT, 2_000),
+        Event(EventType.POS_X, 192),
+        Event(EventType.POS_Y, 192),
+        Event(EventType.HOLD_NOTE_END, 0),
+    ]
+
+    result = make_postprocessor().generate(
+        events,
+        BeatmapConfig(mode=3, circle_size=4),
+        event_times=[1_000] * 7 + [2_000] * 4,
+    )
+
+    assert "192,192,1000,128,0,2000:0:0:-1:0:" in result
+    assert "192,192,0,128" not in result
+
+
+def test_resnap_updates_event_tokens_and_explicit_times_together():
+    events = [
+        Event(EventType.TIME_SHIFT, 110),
+        Event(EventType.SNAPPING, 4),
+        Event(EventType.POS_X, 64),
+        Event(EventType.POS_Y, 192),
+        Event(EventType.CIRCLE, 0),
+    ]
+
+    snapped_events, snapped_times = make_postprocessor().resnap_events(
+        events,
+        [110, 110, 110, 110, 110],
+        make_timing(),
+    )
+
+    assert snapped_events[0].value == 125
+    assert snapped_times == [125, 125, 125, 125, 125]
+
+
+def test_resnap_reports_distinct_pre_times_collapsed_to_same_mania_lane():
+    events = [
+        Event(EventType.TIME_SHIFT, 110), Event(EventType.SNAPPING, 4),
+        Event(EventType.POS_X, 64), Event(EventType.POS_Y, 192),
+        Event(EventType.CIRCLE, 0), Event(EventType.TIME_SHIFT, 140),
+        Event(EventType.SNAPPING, 4), Event(EventType.POS_X, 64),
+        Event(EventType.POS_Y, 192), Event(EventType.HOLD_NOTE, 0),
+    ]
+    _, _, collisions = make_postprocessor().resnap_events(
+        events, [110] * 5 + [140] * 5, make_timing(), key_count=4,
+    )
+    assert collisions == [
+        {"lane": 0, "noteKind": "TAP", "preTimeMs": 110,
+         "postTimeMs": 125, "snapDivisor": 4,
+         "reason": "RAW_TIME_COLLISION_PRESERVED"},
+        {"lane": 0, "noteKind": "HOLD", "preTimeMs": 140,
+         "postTimeMs": 125, "snapDivisor": 4,
+         "reason": "RAW_TIME_COLLISION_PRESERVED"},
+    ]
+
+
+def test_resnap_does_not_report_same_time_on_different_mania_lanes():
+    events = [
+        Event(EventType.TIME_SHIFT, 110), Event(EventType.SNAPPING, 4),
+        Event(EventType.POS_X, 64), Event(EventType.POS_Y, 192),
+        Event(EventType.CIRCLE, 0), Event(EventType.TIME_SHIFT, 140),
+        Event(EventType.SNAPPING, 4), Event(EventType.POS_X, 192),
+        Event(EventType.POS_Y, 192), Event(EventType.CIRCLE, 0),
+    ]
+    _, _, collisions = make_postprocessor().resnap_events(
+        events, [110] * 5 + [140] * 5, make_timing(), key_count=4,
+    )
+    assert collisions == []
+
+
+def test_resnap_preserves_same_timestamp_chord_when_snap_targets_disagree():
+    events = [
+        Event(EventType.TIME_SHIFT, 110), Event(EventType.SNAPPING, 4),
+        Event(EventType.POS_X, 64), Event(EventType.POS_Y, 192),
+        Event(EventType.CIRCLE, 0), Event(EventType.TIME_SHIFT, 110),
+        Event(EventType.SNAPPING, 3), Event(EventType.POS_X, 192),
+        Event(EventType.POS_Y, 192), Event(EventType.CIRCLE, 0),
+    ]
+
+    snapped_events, snapped_times, collisions = make_postprocessor().resnap_events(
+        events, [110] * 10, make_timing(), key_count=4,
+    )
+
+    assert [
+        event.value for event in snapped_events
+        if event.type == EventType.TIME_SHIFT
+    ] == [110, 110]
+    assert snapped_times == [110] * 10
+    assert {collision["reason"] for collision in collisions} == {
+        "SNAP_TARGET_CONFLICT_PRESERVED"
+    }
+
+
+def test_resnap_restores_distinct_raw_times_collapsed_on_same_lane():
+    events = [
+        Event(EventType.TIME_SHIFT, 110), Event(EventType.SNAPPING, 4),
+        Event(EventType.POS_X, 64), Event(EventType.POS_Y, 192),
+        Event(EventType.CIRCLE, 0), Event(EventType.TIME_SHIFT, 140),
+        Event(EventType.SNAPPING, 4), Event(EventType.POS_X, 64),
+        Event(EventType.POS_Y, 192), Event(EventType.HOLD_NOTE, 0),
+    ]
+
+    snapped_events, snapped_times, collisions = make_postprocessor().resnap_events(
+        events, [110] * 5 + [140] * 5, make_timing(), key_count=4,
+    )
+
+    assert [
+        event.value for event in snapped_events
+        if event.type == EventType.TIME_SHIFT
+    ] == [110, 140]
+    assert snapped_times == [110] * 5 + [140] * 5
+    assert {collision["reason"] for collision in collisions} == {
+        "RAW_TIME_COLLISION_PRESERVED"
+    }
+
+
+def test_resnap_sidecar_is_written_next_to_generated_osu(tmp_path):
+    osu_path = tmp_path / "beatmap.osu"
+    collisions = [
+        {"lane": 0, "noteKind": "TAP", "preTimeMs": 110,
+         "postTimeMs": 125, "snapDivisor": 4}
+    ]
+    sidecar_path = make_postprocessor().write_resnap_diagnostics(
+        osu_path, seed=31, collisions=collisions,
+    )
+    assert sidecar_path == osu_path.with_suffix(".resnap.json")
+    assert json.loads(sidecar_path.read_text(encoding="utf-8")) == {
+        "version": "resnap-collisions-v2-preserve-raw",
+        "seed": 31,
+        "collisions": collisions,
+    }
