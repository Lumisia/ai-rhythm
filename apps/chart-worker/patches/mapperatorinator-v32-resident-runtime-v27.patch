diff --git a/tests/test_resident_worker.py b/tests/test_resident_worker.py
new file mode 100644
index 0000000..275f60e
--- /dev/null
+++ b/tests/test_resident_worker.py
@@ -0,0 +1,269 @@
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+from osuT5.osuT5.inference.resident_worker import (
+    TERMINAL_MARKER_NAME,
+    ResidentExecutionResult,
+    ResidentWorker,
+    _validate_resolved_audio_path,
+    _validate_resolved_output_path,
+)
+from osuT5.osuT5.inference.tail_repair import (
+    MAPPERATORINATOR_INVOCATION_RESULT_PREFIX,
+    ManiaTailRepairExhausted,
+)
+
+
+def _song_record(label: str = "song") -> dict[str, object]:
+    body = {
+        "audioSha256": "a" * 64,
+        "configDigest": "b" * 64,
+        "songId": label,
+    }
+    song_hash = hashlib.sha256(
+        json.dumps(body, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    ).hexdigest()
+    return {"version": 1, "type": "BEGIN_SONG", "songHash": song_hash, **body}
+
+
+def _request(
+    song_hash: str,
+    *,
+    workdir: str = "run-1",
+    argv: list[str] | None = None,
+) -> dict[str, object]:
+    body = {
+        "argv": ["inference.py", "seed=1"] if argv is None else argv,
+        "songHash": song_hash,
+        "workdir": workdir,
+    }
+    request_hash = hashlib.sha256(
+        json.dumps(body, sort_keys=True, separators=(",", ":")).encode("utf-8")
+    ).hexdigest()
+    invocation_id = hashlib.sha256(
+        f"chart-worker-resident-invocation-v1:{request_hash}".encode("ascii")
+    ).hexdigest()
+    return {
+        "version": 1,
+        "type": "INVOKE",
+        "invocationId": invocation_id,
+        "requestHash": request_hash,
+        **body,
+    }
+
+
+def test_resolved_output_path_is_validated_before_inference(tmp_path: Path):
+    workdir = tmp_path / "accepted"
+    workdir.mkdir()
+
+    assert (
+        _validate_resolved_output_path(
+            SimpleNamespace(output_path=str(workdir)),
+            workdir,
+        )
+        == workdir.resolve(strict=True)
+    )
+    with pytest.raises(ValueError, match="accepted workdir"):
+        _validate_resolved_output_path(
+            SimpleNamespace(output_path=str(tmp_path / "different")),
+            workdir,
+        )
+
+
+def test_resolved_audio_path_must_be_a_bound_job_root_file(tmp_path: Path):
+    job_root = tmp_path / "jobs"
+    audio = job_root / "audio" / "game.flac"
+    audio.parent.mkdir(parents=True)
+    audio.write_bytes(b"audio")
+
+    assert (
+        _validate_resolved_audio_path(SimpleNamespace(audio_path=str(audio)), job_root)
+        == audio.resolve(strict=True)
+    )
+    outside = tmp_path / "outside.flac"
+    outside.write_bytes(b"outside")
+    with pytest.raises(ValueError, match="job root"):
+        _validate_resolved_audio_path(SimpleNamespace(audio_path=str(outside)), job_root)
+
+
+def test_worker_commits_terminal_marker_and_replays_without_execution(tmp_path: Path):
+    calls: list[tuple[list[str], Path]] = []
+
+    def execute(argv: list[str], workdir: Path) -> ResidentExecutionResult:
+        calls.append((list(argv), workdir))
+        (workdir / "generated.osu").write_bytes(b"osu file")
+        return ResidentExecutionResult(returncode=0, stdout="done", stderr="")
+
+    worker = ResidentWorker(job_root=tmp_path.resolve(), execute=execute)
+    song = _song_record()
+    started = worker.handle(song)
+    request = _request(started[0]["songHash"])
+
+    first = worker.handle(request)
+    replay = worker.handle(request)
+
+    assert [record["type"] for record in first] == ["ACCEPTED", "SUCCESS"]
+    assert first[1]["replayed"] is False
+    assert first[1]["artifacts"][0]["relativePath"] == "generated.osu"
+    assert [record["type"] for record in replay] == ["SUCCESS"]
+    assert replay[0]["replayed"] is True
+    assert len(calls) == 1
+    marker = tmp_path / "run-1" / TERMINAL_MARKER_NAME
+    assert marker.is_file()
+    assert json.loads(marker.read_text(encoding="utf-8"))["requestHash"] == request["requestHash"]
+
+
+def test_worker_refuses_replay_when_hashed_artifact_changes(tmp_path: Path):
+    calls = 0
+
+    def execute(argv: list[str], workdir: Path) -> ResidentExecutionResult:
+        nonlocal calls
+        calls += 1
+        (workdir / "generated.osu").write_bytes(b"original")
+        return ResidentExecutionResult(returncode=0, stdout="done", stderr="")
+
+    worker = ResidentWorker(job_root=tmp_path.resolve(), execute=execute)
+    song_hash = worker.handle(_song_record())[0]["songHash"]
+    request = _request(song_hash)
+    worker.handle(request)
+    (tmp_path / "run-1" / "generated.osu").write_bytes(b"tampered")
+
+    replay = worker.handle(request)
+
+    assert replay[0]["type"] == "REJECTED"
+    assert replay[0]["code"] == "UNKNOWN_COMPLETION"
+    assert calls == 1
+
+
+def test_worker_rejects_different_request_for_existing_terminal(tmp_path: Path):
+    worker = ResidentWorker(
+        job_root=tmp_path.resolve(),
+        execute=lambda argv, workdir: (
+            (workdir / "generated.osu").write_bytes(b"osu")
+            and ResidentExecutionResult(0, "ok", "")
+        ),
+    )
+    song_hash = worker.handle(_song_record())[0]["songHash"]
+    first = _request(song_hash, workdir="same", argv=["inference.py", "seed=1"])
+    conflict = _request(song_hash, workdir="same", argv=["inference.py", "seed=2"])
+    worker.handle(first)
+
+    result = worker.handle(conflict)
+
+    assert result[0]["type"] == "REJECTED"
+    assert result[0]["code"] == "INVOCATION_CONFLICT"
+
+
+@pytest.mark.parametrize("contents", [b"partial output", b"{broken marker"])
+def test_worker_treats_nonempty_or_corrupt_output_as_unknown(
+    tmp_path: Path,
+    contents: bytes,
+):
+    calls = 0
+
+    def execute(argv, workdir):
+        nonlocal calls
+        calls += 1
+        return ResidentExecutionResult(0, "ok", "")
+
+    worker = ResidentWorker(job_root=tmp_path.resolve(), execute=execute)
+    song_hash = worker.handle(_song_record())[0]["songHash"]
+    request = _request(song_hash)
+    workdir = tmp_path / "run-1"
+    workdir.mkdir()
+    if contents.startswith(b"{"):
+        (workdir / TERMINAL_MARKER_NAME).write_bytes(contents)
+    else:
+        (workdir / "partial.osu").write_bytes(contents)
+
+    result = worker.handle(request)
+
+    assert result[0]["type"] == "REJECTED"
+    assert result[0]["code"] == "UNKNOWN_COMPLETION"
+    assert calls == 0
+
+
+def test_worker_serializes_tail_exhaustion_for_live_chart_parser(tmp_path: Path):
+    failure = ManiaTailRepairExhausted(
+        reason="UNCLOSED_HOLD_AT_STREAM_END",
+        requested_end_ms=1000,
+        effective_cut_ms=1000,
+        earliest_generated_source_window_id=1,
+        repair_trigger_reason="PRE_TRIM_INVALID",
+        repair_trigger_source_window_id=3,
+        repair_start_window_id=1,
+        repair_window_ids=[1],
+        repair_attempts=2,
+    )
+
+    def execute(argv, workdir):
+        raise failure
+
+    worker = ResidentWorker(job_root=tmp_path.resolve(), execute=execute)
+    song_hash = worker.handle(_song_record())[0]["songHash"]
+    records = worker.handle(_request(song_hash))
+
+    assert [record["type"] for record in records] == ["ACCEPTED", "FAILURE"]
+    terminal = records[1]
+    assert terminal["returncode"] == 1
+    assert terminal["stdout"].startswith(MAPPERATORINATOR_INVOCATION_RESULT_PREFIX)
+    payload = json.loads(terminal["stdout"].split("=", 1)[1])
+    assert payload == failure.to_terminal_record()
+
+
+def test_song_end_clears_request_identity_but_worker_accepts_next_song(tmp_path: Path):
+    worker = ResidentWorker(
+        job_root=tmp_path.resolve(),
+        execute=lambda argv, workdir: ResidentExecutionResult(1, "", "not invoked"),
+    )
+    first = worker.handle(_song_record("first"))[0]
+    ended = worker.handle(
+        {"version": 1, "type": "END_SONG", "songHash": first["songHash"]}
+    )
+    second = worker.handle(_song_record("second"))[0]
+
+    assert ended[0]["type"] == "SONG_ENDED"
+    assert second["type"] == "SONG_STARTED"
+    assert second["songHash"] != first["songHash"]
+
+
+def test_worker_forwards_exact_song_boundaries_to_runtime_hooks(tmp_path: Path):
+    boundaries: list[object] = []
+    worker = ResidentWorker(
+        job_root=tmp_path.resolve(),
+        execute=lambda argv, workdir: ResidentExecutionResult(1, "", "not invoked"),
+        begin_song=lambda record: boundaries.append(("begin", record)),
+        end_song=lambda: boundaries.append("end"),
+    )
+    song = _song_record("bounded")
+    started = worker.handle(song)[0]
+    worker.handle({"version": 1, "type": "END_SONG", "songHash": started["songHash"]})
+
+    assert boundaries[0][0] == "begin"
+    assert boundaries[0][1] == song
+    assert boundaries[1] == "end"
+
+
+def test_worker_rejects_forged_request_hash_before_acceptance(tmp_path: Path):
+    calls = 0
+
+    def execute(argv, workdir):
+        nonlocal calls
+        calls += 1
+        return ResidentExecutionResult(0, "ok", "")
+
+    worker = ResidentWorker(job_root=tmp_path.resolve(), execute=execute)
+    song_hash = worker.handle(_song_record())[0]["songHash"]
+    request = _request(song_hash)
+    request["requestHash"] = "0" * 64
+
+    result = worker.handle(request)
+
+    assert result[0]["type"] == "REJECTED"
+    assert result[0]["code"] == "INVALID_REQUEST"
+    assert calls == 0
