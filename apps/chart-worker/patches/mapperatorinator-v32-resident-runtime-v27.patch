+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+import torch
+
+# The inference entrypoint imports training-only helpers through osuT5.utils.__init__.
+# This CPU contract test does not exercise W&B and the packaged chart runtime does not
+# install it, so prevent that unrelated optional training import from blocking collection.
+_wandb_stub = types.ModuleType("wandb")
+_wandb_stub.__spec__ = importlib.machinery.ModuleSpec("wandb", loader=None)
+sys.modules.setdefault("wandb", _wandb_stub)
+
+import inference
+from config import InferenceConfig
+from osuT5.osuT5.inference.encoder_cache import ExactEncoderCache
+from osuT5.osuT5.inference.resident_runtime import (
+    ModelManifestError,
+    ResidentInferenceRuntime,
+    verify_model_manifest,
+)
+from osuT5.osuT5.utils import model_utils
+
+_REVISION = "74f22583400d259bf424819e11027c17933efe54"
+_UPSTREAM = "2a70eb89004da20e39b0fcbaad2686b264d5a040"
+_PATCH_SET = "hold-v26"
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(65536), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _model_root(tmp_path: Path) -> Path:
+    root = tmp_path / "snapshot"
+    root.mkdir()
+    files = {
+        "config.json": b"{}\n",
+        "tokenizer.json": b'{"version":1}\n',
+        "model.safetensors": b"fixed-test-weights",
+    }
+    for relative, payload in files.items():
+        (root / relative).write_bytes(payload)
+    manifest = {
+        "version": 1,
+        "revision": _REVISION,
+        "upstreamCommit": _UPSTREAM,
+        "patchSetId": _PATCH_SET,
+        "files": [
+            {
+                "path": relative,
+                "size": (root / relative).stat().st_size,
+                "sha256": _sha256(root / relative),
+            }
+            for relative in sorted(files)
+        ],
+    }
+    (root / "model-manifest-v1.json").write_text(
+        json.dumps(manifest, sort_keys=True, separators=(",", ":")),
+        encoding="utf-8",
+    )
+    return root.resolve()
+
+
+def _args(root: Path, **overrides):
+    values = {
+        "model_path": str(root),
+        "precision": "fp16",
+        "device": "cuda",
+        "gamemode": 3,
+        "auto_select_gamemode_model": True,
+        "lora_path": None,
+        "use_server": False,
+        "mania_hold_state_mode": "incremental",
+        "parallel": False,
+        "seed": 123,
+    }
+    values.update(overrides)
+    return SimpleNamespace(**values)
+
+
+def _runtime(root: Path) -> ResidentInferenceRuntime:
+    return ResidentInferenceRuntime(
+        model_root=root,
+        revision=_REVISION,
+        upstream_commit=_UPSTREAM,
+        patch_set_id=_PATCH_SET,
+    )
+
+
+def test_manifest_verification_binds_every_file_and_identity(tmp_path: Path):
+    root = _model_root(tmp_path)
+
+    verified = verify_model_manifest(
+        root,
+        expected_revision=_REVISION,
+        expected_upstream_commit=_UPSTREAM,
+        expected_patch_set_id=_PATCH_SET,
+    )
+
+    assert verified.root == root
+    assert verified.revision == _REVISION
+    assert verified.file_count == 3
+    assert len(verified.manifest_sha256) == 64
+
+
+@pytest.mark.parametrize("mutation", ["missing", "hash", "extra", "revision"])
+def test_manifest_verification_fails_closed(tmp_path: Path, mutation: str):
+    root = _model_root(tmp_path)
+    if mutation == "missing":
+        (root / "tokenizer.json").unlink()
+    elif mutation == "hash":
+        (root / "model.safetensors").write_bytes(b"changed")
+    elif mutation == "extra":
+        (root / "untracked.bin").write_bytes(b"not in manifest")
+
+    expected_revision = "0" * 40 if mutation == "revision" else _REVISION
+    with pytest.raises(ModelManifestError):
+        verify_model_manifest(
+            root,
+            expected_revision=expected_revision,
+            expected_upstream_commit=_UPSTREAM,
+            expected_patch_set_id=_PATCH_SET,
+        )
+
+
+def test_manifest_rejects_duplicate_json_keys(tmp_path: Path):
+    root = _model_root(tmp_path)
+    manifest_path = root / "model-manifest-v1.json"
+    original = manifest_path.read_text(encoding="utf-8")
+    manifest_path.write_text(original.replace('"version":1', '"version":1,"version":1'), encoding="utf-8")
+
+    with pytest.raises(ModelManifestError, match="duplicate"):
+        verify_model_manifest(
+            root,
+            expected_revision=_REVISION,
+            expected_upstream_commit=_UPSTREAM,
+            expected_patch_set_id=_PATCH_SET,
