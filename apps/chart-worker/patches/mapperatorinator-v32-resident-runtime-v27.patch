+
+def test_registry_reuses_a_after_b_without_cross_request_state(tmp_path: Path):
+    root = _model_root(tmp_path)
+    runtime = _runtime(root)
+    loads: list[tuple[int, int]] = []
+
+    def loader(args):
+        value = (args.gamemode, len(loads))
+        loads.append(value)
+        return {"identity": value}
+
+    args_a = _args(root, gamemode=3)
+    args_b = _args(root, gamemode=0)
+
+    result_a1 = runtime.model_bundle(args_a, loader, loads_separate_timing_model=False)
+    result_b = runtime.model_bundle(args_b, loader, loads_separate_timing_model=False)
