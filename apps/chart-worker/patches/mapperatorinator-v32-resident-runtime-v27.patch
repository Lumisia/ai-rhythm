+        return "result"
+
+    monkeypatch.setattr(inference, "generate", fake_generate)
+
+    result = inference.execute_inference(args, runtime=FakeRuntime())
+
+    assert result == "result"
+    assert calls[0:4] == [
+        "compile",
+        ("prepare", 42),
+        ("bundle", 42, "load_inference_models"),
+        ("encoder-cache", 42),
+    ]
+    generated = calls[4]
+    assert generated[0] == "generate"
+    assert generated[1]["model"] == "model"
+    assert generated[1]["tokenizer"] == "tokenizer"
+    assert generated[1]["encoder_cache"] is FakeRuntime.cache
+    assert generated[1]["encoder_model_identity"] == ("a" * 64, "b" * 64)
