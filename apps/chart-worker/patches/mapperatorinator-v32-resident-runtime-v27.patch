+    class FakeRuntime:
+        cache = ExactEncoderCache(max_entries=2, max_bytes=1024)
+
+        def prepare_invocation(self, observed):
+            calls.append(("prepare", observed.seed))
+
+        def model_bundle(self, observed, loader, *, loads_separate_timing_model):
+            assert loads_separate_timing_model is False
+            calls.append(("bundle", observed.seed, loader.__name__))
+            return bundle
+
+        def encoder_cache_context(self, observed, *, loads_separate_timing_model):
+            assert loads_separate_timing_model is False
+            calls.append(("encoder-cache", observed.seed))
+            return self.cache, "a" * 64, "b" * 64
+
+    monkeypatch.setattr(inference, "compile_args", lambda observed: calls.append("compile"))
+    monkeypatch.setattr(inference, "get_config", lambda observed: ("generation", "beatmap"))
+
+    def fake_generate(observed, **kwargs):
