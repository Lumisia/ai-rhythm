+def _canonical_resnap_collision(collision: dict) -> dict:
+    if type(collision) is not dict:
+        raise TypeError("resnap collision must be an exact dict")
+    normalized = dict(collision)
+    for field in _RESNAP_COLLISION_TIME_FIELDS:
+        if field not in normalized or normalized[field] is None:
+            continue
+        value = normalized[field]
+        if isinstance(value, bool):
+            raise TypeError(f"{field} must be a numeric millisecond value")
+        if isinstance(value, (int, np.integer)):
+            normalized[field] = int(value)
+            continue
+        if not isinstance(value, (float, np.floating)):
+            raise TypeError(f"{field} must be a numeric millisecond value")
+        numeric = float(value)
+        if not math.isfinite(numeric):
+            raise ValueError(f"{field} must be finite")
+        normalized[field] = int(round(numeric))
+    return normalized
 
 
