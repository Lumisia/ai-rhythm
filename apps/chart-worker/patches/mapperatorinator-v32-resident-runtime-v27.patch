+def test_fractional_generated_time_is_binned_at_the_nearest_millisecond(monkeypatch):
+    class HistogramBuilt(RuntimeError):
+        pass
+
+    class FakeProcessor:
+        @staticmethod
+        def _create_tokens_per_second_meter():
+            return None
+
+        @staticmethod
+        def generate(**_kwargs):
+            return [
+                (
+                    [
+                        Event(EventType.TIME_SHIFT, 100.5),
+                        Event(EventType.BEAT),
+                    ],
+                    [],
+                )
+            ]
+
+    generator = object.__new__(super_timing_generator.SuperTimingGenerator)
+    generator.sample_rate = 1_000
+    generator.miliseconds_per_sequence = 2
+    generator.iterations = 1
+    generator.types_first = False
+    generator.bpm_change_threshold = 0.6
+    generator.args = SimpleNamespace(
+        train=SimpleNamespace(data=SimpleNamespace(add_timing=False))
+    )
+    generator.preprocessor = SimpleNamespace(segment=lambda *_args: object())
+    generator.processor = FakeProcessor()
+
+    monkeypatch.setattr(np.random, "randint", lambda *_args: 0)
+    monkeypatch.setattr(
+        super_timing_generator,
+        "gaussian_filter1d",
+        lambda *_args, **_kwargs: (_ for _ in ()).throw(HistogramBuilt()),
+    )
+
+    with pytest.raises(HistogramBuilt):
+        generator.generate(
+            np.zeros(1_000, dtype=np.float32),
+            SimpleNamespace(),
+            verbose=False,
+        )
