+
+    assert os.environ["HF_HUB_OFFLINE"] == "1"
+    assert os.environ["TRANSFORMERS_OFFLINE"] == "1"
+    with pytest.raises(ValueError, match="use_server=false"):
+        runtime.prepare_invocation(_args(root, use_server=True))
+    with pytest.raises(ValueError, match="incremental"):
+        runtime.prepare_invocation(_args(root, mania_hold_state_mode="full_scan"))
+    with pytest.raises(ValueError, match="parallel=false"):
