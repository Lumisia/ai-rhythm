@@ -0,0 +1,402 @@
+"""Fail-closed offline identity and process-lifetime model registry for resident inference."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+import multiprocessing
+import os
+import random
+from collections.abc import Callable
+from dataclasses import asdict, dataclass, is_dataclass
+from enum import Enum
+from pathlib import Path, PurePosixPath
+from typing import Any, TypeVar
+
+import numpy as np
+import torch
+
+from .encoder_cache import ExactEncoderCache
+
+_MANIFEST_NAME = "model-manifest-v1.json"
+_MAX_MANIFEST_FILES = 100_000
+_HEX = frozenset("0123456789abcdef")
+_Bundle = TypeVar("_Bundle")
+_SONG_ENCODER_CACHE_MAX_ENTRIES = 8
+_SONG_ENCODER_CACHE_MAX_BYTES = 2 * 1024 * 1024 * 1024
+
+
+class ModelManifestError(ValueError):
+    """The local model snapshot is missing, floating, corrupt, or incompletely bound."""
+
+
+def _require_plain_sha(value: object, *, length: int, name: str) -> str:
+    if type(value) is not str or len(value) != length or any(c not in _HEX for c in value):
+        raise ModelManifestError(f"{name} must be an exact {length}-character lowercase hex SHA")
+    return value
+
+
+def _sha256_file(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _reject_duplicate_json_keys(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
+    value: dict[str, Any] = {}
+    for key, item in pairs:
+        if key in value:
+            raise ModelManifestError(f"duplicate JSON key in model manifest: {key}")
+        value[key] = item
+    return value
+
+
+def _safe_relative_path(value: object) -> PurePosixPath:
+    if type(value) is not str or not value or "\\" in value:
+        raise ModelManifestError("manifest file path must be a non-empty POSIX relative path")
+    relative = PurePosixPath(value)
+    if relative.is_absolute() or any(part in ("", ".", "..") for part in relative.parts):
+        raise ModelManifestError(f"unsafe manifest path: {value!r}")
+    if relative.as_posix() == _MANIFEST_NAME:
+        raise ModelManifestError("the manifest must not list itself")
+    return relative
+
+
+@dataclass(frozen=True, slots=True)
+class VerifiedModelManifest:
+    root: Path
+    revision: str
+    upstream_commit: str
+    patch_set_id: str
+    manifest_sha256: str
+    file_count: int
+    total_bytes: int
+
+
+def verify_model_manifest(
+    model_root: Path,
+    *,
+    expected_revision: str,
+    expected_upstream_commit: str,
+    expected_patch_set_id: str,
+) -> VerifiedModelManifest:
+    """Verify identity plus the exact regular-file set beneath an absolute local snapshot."""
+
+    if not isinstance(model_root, Path) or not model_root.is_absolute():
+        raise ModelManifestError("model_root must be an absolute Path")
+    if model_root.is_symlink() or not model_root.is_dir():
+        raise ModelManifestError("model_root must be an existing non-symlink directory")
+    root = model_root.resolve(strict=True)
+    revision = _require_plain_sha(expected_revision, length=40, name="expected_revision")
+    upstream_commit = _require_plain_sha(
+        expected_upstream_commit,
+        length=40,
+        name="expected_upstream_commit",
+    )
+    if type(expected_patch_set_id) is not str or not expected_patch_set_id:
+        raise ModelManifestError("expected_patch_set_id must be a non-empty plain string")
+
+    manifest_path = root / _MANIFEST_NAME
+    if manifest_path.is_symlink() or not manifest_path.is_file():
+        raise ModelManifestError(f"missing regular {_MANIFEST_NAME}")
+    manifest_bytes = manifest_path.read_bytes()
+    try:
+        manifest = json.loads(
+            manifest_bytes,
+            object_pairs_hook=_reject_duplicate_json_keys,
+        )
+    except ModelManifestError:
+        raise
+    except (json.JSONDecodeError, UnicodeDecodeError, ValueError, RecursionError) as error:
+        raise ModelManifestError("model manifest is not bounded valid JSON") from error
+    if type(manifest) is not dict or set(manifest) != {
+        "version",
+        "revision",
+        "upstreamCommit",
+        "patchSetId",
+        "files",
+    }:
+        raise ModelManifestError("model manifest has an unsupported schema")
+    if type(manifest["version"]) is not int or manifest["version"] != 1:
+        raise ModelManifestError("model manifest version must be 1")
+    if manifest["revision"] != revision:
+        raise ModelManifestError("model manifest revision does not match the pinned revision")
+    if manifest["upstreamCommit"] != upstream_commit:
+        raise ModelManifestError("model manifest upstream commit does not match")
+    if manifest["patchSetId"] != expected_patch_set_id:
+        raise ModelManifestError("model manifest patch set does not match")
+
+    files = manifest["files"]
+    if type(files) is not list or not files or len(files) > _MAX_MANIFEST_FILES:
+        raise ModelManifestError("model manifest files must be a bounded non-empty list")
+    expected_paths: set[str] = set()
+    total_bytes = 0
+    for entry in files:
+        if type(entry) is not dict or set(entry) != {"path", "size", "sha256"}:
+            raise ModelManifestError("model manifest file entry has an unsupported schema")
+        relative = _safe_relative_path(entry["path"])
+        relative_text = relative.as_posix()
+        if relative_text in expected_paths:
+            raise ModelManifestError(f"duplicate manifest path: {relative_text}")
+        expected_paths.add(relative_text)
+        size = entry["size"]
+        if type(size) is not int or size < 0:
+            raise ModelManifestError(f"invalid size for {relative_text}")
+        expected_sha = _require_plain_sha(
+            entry["sha256"],
+            length=64,
+            name=f"sha256 for {relative_text}",
+        )
+        path = root.joinpath(*relative.parts)
+        if path.is_symlink() or not path.is_file():
+            raise ModelManifestError(f"missing regular model file: {relative_text}")
+        resolved = path.resolve(strict=True)
+        if not resolved.is_relative_to(root):
+            raise ModelManifestError(f"model file escapes root: {relative_text}")
+        actual_size = path.stat().st_size
+        if actual_size != size:
+            raise ModelManifestError(f"size mismatch for {relative_text}")
+        if _sha256_file(path) != expected_sha:
+            raise ModelManifestError(f"SHA-256 mismatch for {relative_text}")
+        total_bytes += actual_size
+
+    actual_paths: set[str] = set()
+    for path in root.rglob("*"):
+        if path.is_symlink():
+            raise ModelManifestError(f"symlinks are not allowed in model root: {path}")
+        if path.is_file() and path != manifest_path:
+            actual_paths.add(path.relative_to(root).as_posix())
+    if actual_paths != expected_paths:
+        missing = sorted(expected_paths - actual_paths)
+        extra = sorted(actual_paths - expected_paths)
+        raise ModelManifestError(f"manifest file set mismatch: missing={missing}, extra={extra}")
+
+    return VerifiedModelManifest(
+        root=root,
+        revision=revision,
+        upstream_commit=upstream_commit,
+        patch_set_id=expected_patch_set_id,
+        manifest_sha256=hashlib.sha256(manifest_bytes).hexdigest(),
+        file_count=len(expected_paths),
+        total_bytes=total_bytes,
+    )
+
+
+def _canonical_value(value: Any) -> Any:
+    if value is None or type(value) in (str, bool, int):
+        return value
+    if type(value) is float:
+        if not math.isfinite(value):
+            raise ValueError("model-load identity cannot contain non-finite floats")
+        return {"floatHex": value.hex()}
+    if isinstance(value, Path):
+        return {"path": value.as_posix()}
+    if isinstance(value, Enum):
+        return {"enum": f"{type(value).__module__}.{type(value).__qualname__}", "value": value.value}
+    if is_dataclass(value):
+        return _canonical_value(asdict(value))
+    if type(value) in (list, tuple):
+        return [_canonical_value(item) for item in value]
+    if type(value) is dict:
+        if any(type(key) is not str for key in value):
+            raise TypeError("model-load identity mappings require plain string keys")
+        return {key: _canonical_value(value[key]) for key in sorted(value)}
+    raise TypeError(f"unsupported model-load identity value: {type(value).__name__}")
+
+
+@dataclass(frozen=True, slots=True)
+class ModelKey:
+    manifest_sha256: str
+    config_sha256: str
+    loads_separate_timing_model: bool
+
+
+class ResidentInferenceRuntime:
+    """Process-lifetime exact-key registry; all song/request state remains outside it."""
+
+    def __init__(
+        self,
+        *,
+        model_root: Path,
+        revision: str,
+        upstream_commit: str,
+        patch_set_id: str,
+    ) -> None:
+        os.environ["HF_HUB_OFFLINE"] = "1"
+        os.environ["TRANSFORMERS_OFFLINE"] = "1"
+        self.manifest = verify_model_manifest(
+            model_root,
+            expected_revision=revision,
+            expected_upstream_commit=upstream_commit,
+            expected_patch_set_id=patch_set_id,
+        )
+        multiprocessing.set_start_method("spawn", force=True)
+        torch.set_grad_enabled(False)
+        torch.set_float32_matmul_precision("high")
+        self._registry: dict[ModelKey, Any] = {}
+        self._registry_load_count = 0
+        self._song_encoder_cache: ExactEncoderCache | None = None
+        self._song_identity: tuple[str, str] | None = None
+
+    @property
+    def registry_load_count(self) -> int:
+        return self._registry_load_count
+
+    def _require_local_path(self, value: object, *, name: str, allow_none: bool) -> str | None:
+        if value is None and allow_none:
+            return None
+        if type(value) is not str or not value:
+            raise ValueError(f"{name} must be a non-empty absolute local path")
+        path = Path(value)
+        if not path.is_absolute():
+            raise ValueError(f"{name} must be absolute")
+        resolved = path.resolve(strict=True)
+        if not resolved.is_relative_to(self.manifest.root):
+            raise ValueError(f"{name} must resolve beneath the verified model root")
+        return resolved.relative_to(self.manifest.root).as_posix() or "."
+
+    def _model_key(
+        self,
+        args: Any,
+        *,
+        loads_separate_timing_model: bool,
+    ) -> ModelKey:
+        if type(loads_separate_timing_model) is not bool:
+            raise TypeError("loads_separate_timing_model must be an exact bool")
+        model_path = self._require_local_path(args.model_path, name="model_path", allow_none=False)
+        lora_path = self._require_local_path(
+            getattr(args, "lora_path", None),
+            name="lora_path",
+            allow_none=True,
+        )
+        identity = {
+            "modelPath": model_path,
+            "loraPath": lora_path,
+            "revision": self.manifest.revision,
+            "upstreamCommit": self.manifest.upstream_commit,
+            "patchSetId": self.manifest.patch_set_id,
+            "precision": getattr(args, "precision", None),
+            "device": getattr(args, "device", None),
+            "attnImplementation": getattr(args, "attn_implementation", None),
+            "gamemode": getattr(args, "gamemode", None),
+            "autoSelectGamemodeModel": getattr(args, "auto_select_gamemode_model", None),
+            "fastDecoderLoop": getattr(args, "fast_decoder_loop", None),
+            "generatePositions": getattr(args, "generate_positions", None),
+        }
+        encoded = json.dumps(
+            _canonical_value(identity),
+            ensure_ascii=True,
+            sort_keys=True,
+            separators=(",", ":"),
+            allow_nan=False,
+        ).encode("utf-8")
+        return ModelKey(
+            manifest_sha256=self.manifest.manifest_sha256,
+            config_sha256=hashlib.sha256(encoded).hexdigest(),
+            loads_separate_timing_model=loads_separate_timing_model,
+        )
+
+    def prepare_invocation(self, args: Any) -> None:
+        if getattr(args, "use_server", None) is not False:
+            raise ValueError("resident inference requires use_server=false")
+        if getattr(args, "mania_hold_state_mode", None) != "incremental":
+            raise ValueError("resident inference requires mania_hold_state_mode=incremental")
+        if getattr(args, "parallel", None) is not False:
+            raise ValueError("resident inference requires parallel=false")
+        if getattr(args, "generate_positions", False) is not False:
+            raise ValueError(
+                "resident inference requires generate_positions=false until diffusion "
+                "weights have a separate verified registry identity"
+            )
+        seed = getattr(args, "seed", None)
+        if type(seed) is not int or not 0 <= seed <= 2**32 - 1:
+            raise ValueError("resident invocation seed must be an exact uint32")
+        random.seed(seed)
+        np.random.seed(seed)
+        torch.manual_seed(seed)
+        if torch.cuda.is_available():
+            torch.cuda.manual_seed_all(seed)
+
+    def begin_song(self, record: dict[str, object]) -> None:
+        if self._song_encoder_cache is not None:
+            raise RuntimeError("resident runtime already has an active song")
+        if type(record) is not dict:
+            raise TypeError("song identity must be a dict")
+        audio_sha256 = _require_plain_sha(
+            record.get("audioSha256"), length=64, name="audioSha256"
+        )
+        config_digest = _require_plain_sha(
+            record.get("configDigest"), length=64, name="configDigest"
+        )
+        self._song_identity = (audio_sha256, config_digest)
+        self._song_encoder_cache = ExactEncoderCache(
+            max_entries=_SONG_ENCODER_CACHE_MAX_ENTRIES,
+            max_bytes=_SONG_ENCODER_CACHE_MAX_BYTES,
+        )
+
+    def end_song(self) -> None:
+        cache = self._song_encoder_cache
+        if cache is None:
+            raise RuntimeError("resident runtime has no active song")
+        cache.clear()
+        self._song_encoder_cache = None
+        self._song_identity = None
+
+    def encoder_cache_context(
+        self,
+        args: Any,
+        *,
+        loads_separate_timing_model: bool,
+    ) -> tuple[ExactEncoderCache, str, str]:
+        cache = self._song_encoder_cache
+        if cache is None:
+            raise RuntimeError("encoder cache requires an active song")
+        key = self._model_key(
+            args,
+            loads_separate_timing_model=loads_separate_timing_model,
+        )
+        return cache, key.manifest_sha256, key.config_sha256
+
+    def validate_invocation_audio(self, path: Path) -> None:
+        if not isinstance(path, Path) or not path.is_absolute() or not path.is_file():
+            raise ValueError("invocation audio must be an existing absolute file")
+        if self._song_identity is None:
+            raise RuntimeError("invocation audio requires an active song")
+        if _sha256_file(path) != self._song_identity[0]:
+            raise ValueError("invocation audio does not match the active song")
+
+    def model_bundle(
+        self,
+        args: Any,
+        loader: Callable[[Any], _Bundle],
+        *,
+        loads_separate_timing_model: bool,
+    ) -> _Bundle:
+        key = self._model_key(
+            args,
+            loads_separate_timing_model=loads_separate_timing_model,
+        )
+        existing = self._registry.get(key)
+        if existing is not None:
+            return existing
+        if not loads_separate_timing_model:
+            # A bundle that already contains the exact same main model plus a
+            # separate timing model is a safe superset for a later MAP-only
+            # request. The reverse direction is intentionally not allowed.
+            superset_key = ModelKey(
+                manifest_sha256=key.manifest_sha256,
+                config_sha256=key.config_sha256,
+                loads_separate_timing_model=True,
+            )
+            superset = self._registry.get(superset_key)
+            if superset is not None:
+                return superset
+        loaded = loader(args)
+        if loaded is None:
+            raise RuntimeError("model loader returned no bundle")
+        self._registry[key] = loaded
+        self._registry_load_count += 1
+        return loaded
