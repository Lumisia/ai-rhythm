+"""Resident child protocol state and hash-bound terminal marker ownership."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import sys
+import traceback
+import uuid
+from collections.abc import Callable
+from dataclasses import dataclass
+from io import BufferedReader, BufferedWriter
+from pathlib import Path, PurePosixPath
+
+from .tail_repair import ManiaTailRepairExhausted, format_mania_tail_terminal_line
+
+TERMINAL_MARKER_NAME = "resident-terminal-v1.json"
+_MAX_TERMINAL_LINE_BYTES = 1_048_576
+_HEX = frozenset("0123456789abcdef")
+
+
+def _digest_json(value: dict[str, object]) -> str:
+    payload = json.dumps(
+        value,
+        ensure_ascii=True,
+        sort_keys=True,
+        separators=(",", ":"),
+        allow_nan=False,
+    ).encode("utf-8")
+    return hashlib.sha256(payload).hexdigest()
+
+
+def _is_digest(value: object) -> bool:
+    return type(value) is str and len(value) == 64 and all(c in _HEX for c in value)
+
+
+def _sha256_path(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _json_without_duplicate_keys(pairs: list[tuple[str, object]]) -> dict[str, object]:
+    result: dict[str, object] = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError(f"duplicate JSON key: {key}")
+        result[key] = value
+    return result
+
+
+@dataclass(frozen=True, slots=True)
+class ResidentExecutionResult:
+    returncode: int
+    stdout: str
+    stderr: str
+
+    def __post_init__(self) -> None:
+        if type(self.returncode) is not int:
+            raise TypeError("returncode must be a plain int")
+        if type(self.stdout) is not str or type(self.stderr) is not str:
+            raise TypeError("stdout and stderr must be plain strings")
+
+
+ExecuteResidentRequest = Callable[[list[str], Path], ResidentExecutionResult]
+
+
+class ResidentWorker:
+    """Synchronous one-owner worker; the model registry lives in the injected executor."""
+
+    def __init__(
+        self,
+        *,
+        job_root: Path,
+        execute: ExecuteResidentRequest,
+        begin_song: Callable[[dict[str, object]], None] | None = None,
+        end_song: Callable[[], None] | None = None,
+    ) -> None:
+        if not isinstance(job_root, Path) or not job_root.is_absolute():
+            raise ValueError("job_root must be absolute")
+        if job_root.is_symlink() or not job_root.is_dir():
+            raise ValueError("job_root must be an existing non-symlink directory")
+        self._job_root = job_root.resolve(strict=True)
+        self._execute = execute
+        self._begin_song_hook = begin_song
+        self._end_song_hook = end_song
+        self._song_hash: str | None = None
+
+    @staticmethod
+    def ready_record() -> dict[str, object]:
+        return {"version": 1, "type": "READY"}
+
+    @staticmethod
+    def _reject(request: dict[str, object], *, code: str, reason: str) -> list[dict[str, object]]:
+        invocation_id = request.get("invocationId")
+        request_hash = request.get("requestHash")
+        if not _is_digest(invocation_id):
+            invocation_id = "0" * 64
+        if not _is_digest(request_hash):
+            request_hash = "0" * 64
+        return [
+            {
+                "version": 1,
+                "type": "REJECTED",
+                "code": code,
+                "invocationId": invocation_id,
+                "requestHash": request_hash,
+                "reason": reason,
+            }
+        ]
+
+    def _begin_song(self, record: dict[str, object]) -> list[dict[str, object]]:
+        if set(record) != {
+            "version",
+            "type",
+            "songHash",
+            "songId",
+            "audioSha256",
+            "configDigest",
+        }:
+            raise ValueError("BEGIN_SONG schema is invalid")
+        if self._song_hash is not None:
+            raise ValueError("a song is already active")
+        if (
+            type(record["songId"]) is not str
+            or not record["songId"]
+            or not _is_digest(record["audioSha256"])
+            or not _is_digest(record["configDigest"])
+        ):
+            raise ValueError("BEGIN_SONG identity is invalid")
+        song_body = {
+            "audioSha256": record["audioSha256"],
+            "configDigest": record["configDigest"],
+            "songId": record["songId"],
+        }
+        song_hash = _digest_json(song_body)
+        if record["songHash"] != song_hash:
+            raise ValueError("BEGIN_SONG hash does not match its identity")
+        if self._begin_song_hook is not None:
+            self._begin_song_hook(dict(record))
+        self._song_hash = song_hash
+        return [{"version": 1, "type": "SONG_STARTED", "songHash": song_hash}]
+
+    def _end_song(self, record: dict[str, object]) -> list[dict[str, object]]:
+        if set(record) != {"version", "type", "songHash"}:
+            raise ValueError("END_SONG schema is invalid")
+        if self._song_hash is None or record["songHash"] != self._song_hash:
+            raise ValueError("END_SONG does not match the active song")
+        song_hash = self._song_hash
+        if self._end_song_hook is not None:
+            self._end_song_hook()
+        self._song_hash = None
+        return [{"version": 1, "type": "SONG_ENDED", "songHash": song_hash}]
+
+    def _resolve_workdir(self, value: object) -> Path:
+        if type(value) is not str or not value or "\\" in value:
+            raise ValueError("workdir must be a non-empty POSIX relative path")
+        relative = PurePosixPath(value)
+        if relative.is_absolute() or any(part in ("", ".", "..") for part in relative.parts):
+            raise ValueError("workdir is unsafe")
+        path = self._job_root.joinpath(*relative.parts)
+        if path.is_symlink():
+            raise ValueError("workdir must not be a symlink")
+        resolved = path.resolve(strict=False)
+        if not resolved.is_relative_to(self._job_root) or resolved == self._job_root:
+            raise ValueError("workdir escapes job_root")
+        return resolved
+
+    @staticmethod
+    def _read_marker(marker: Path) -> dict[str, object] | None:
+        try:
+            payload = marker.read_bytes()
+            if len(payload) > _MAX_TERMINAL_LINE_BYTES:
+                return None
+            record = json.loads(payload, object_pairs_hook=_json_without_duplicate_keys)
+        except (OSError, json.JSONDecodeError, UnicodeDecodeError, ValueError, RecursionError):
+            return None
+        if type(record) is not dict or set(record) != {
+            "version",
+            "type",
+            "invocationId",
+            "requestHash",
+            "returncode",
+            "stdout",
+            "stderr",
+            "replayed",
+            "artifacts",
+        }:
+            return None
+        if (
+            type(record["version"]) is not int
+            or record["version"] != 1
+            or record["type"] not in ("SUCCESS", "FAILURE")
+            or not _is_digest(record["invocationId"])
+            or not _is_digest(record["requestHash"])
+            or type(record["returncode"]) is not int
+            or type(record["stdout"]) is not str
+            or type(record["stderr"]) is not str
+            or record["replayed"] is not False
+            or type(record["artifacts"]) is not list
+        ):
+            return None
+        if (record["type"] == "SUCCESS") != (record["returncode"] == 0):
+            return None
+        return record
+
+    @staticmethod
+    def _collect_artifacts(workdir: Path) -> list[dict[str, object]]:
+        artifacts: list[dict[str, object]] = []
+        for path in sorted(workdir.rglob("*"), key=lambda item: item.as_posix()):
+            if path.is_symlink():
+                raise ValueError(f"artifact tree contains symlink: {path}")
+            if not path.is_file():
+                continue
+            relative = path.relative_to(workdir).as_posix()
+            if relative == TERMINAL_MARKER_NAME or (
+                relative.startswith(f".{TERMINAL_MARKER_NAME}.") and relative.endswith(".tmp")
+            ):
+                continue
+            artifacts.append(
+                {
+                    "relativePath": relative,
+                    "size": path.stat().st_size,
+                    "sha256": _sha256_path(path),
+                }
+            )
+        return artifacts
+
+    @classmethod
+    def _artifacts_match(cls, workdir: Path, expected: object) -> bool:
+        if type(expected) is not list:
+            return False
+        try:
+            actual = cls._collect_artifacts(workdir)
+        except (OSError, ValueError):
+            return False
+        return actual == expected
+
+    @staticmethod
+    def _write_marker(marker: Path, terminal: dict[str, object]) -> None:
+        payload = json.dumps(
+            terminal,
+            ensure_ascii=True,
+            sort_keys=True,
+            separators=(",", ":"),
+            allow_nan=False,
+        ).encode("utf-8")
+        if len(payload) > _MAX_TERMINAL_LINE_BYTES:
+            raise ValueError("terminal marker exceeds 1 MiB")
+        temporary = marker.with_name(f".{marker.name}.{uuid.uuid4().hex}.tmp")
+        try:
+            with temporary.open("xb") as stream:
+                stream.write(payload)
+                stream.flush()
+                os.fsync(stream.fileno())
+            os.replace(temporary, marker)
+            if os.name == "posix":
+                directory_fd = os.open(marker.parent, os.O_RDONLY)
+                try:
+                    os.fsync(directory_fd)
+                finally:
+                    os.close(directory_fd)
+        finally:
+            if temporary.exists():
+                temporary.unlink()
+
+    @staticmethod
+    def _terminal(
+        request: dict[str, object],
+        result: ResidentExecutionResult,
+        artifacts: list[dict[str, object]],
+    ) -> dict[str, object]:
+        terminal = {
+            "version": 1,
+            "type": "SUCCESS" if result.returncode == 0 else "FAILURE",
+            "invocationId": request["invocationId"],
+            "requestHash": request["requestHash"],
+            "returncode": result.returncode,
+            "stdout": result.stdout,
+            "stderr": result.stderr,
+            "replayed": False,
+            "artifacts": artifacts,
+        }
+        payload = json.dumps(
+            terminal,
+            ensure_ascii=True,
+            sort_keys=True,
+            separators=(",", ":"),
+            allow_nan=False,
+        ).encode("utf-8")
+        if len(payload) > _MAX_TERMINAL_LINE_BYTES:
+            terminal.update(
+                {
+                    "type": "FAILURE",
+                    "returncode": 1,
+                    "stdout": "",
+                    "stderr": "resident terminal payload exceeded 1 MiB",
+                }
+            )
+        return terminal
+
+    def _invoke(self, request: dict[str, object]) -> list[dict[str, object]]:
+        required = {
+            "version",
+            "type",
+            "invocationId",
+            "requestHash",
+            "argv",
+            "songHash",
+            "workdir",
+        }
+        if set(request) != required or self._song_hash is None:
+            return self._reject(request, code="INVALID_REQUEST", reason="invalid schema or no song")
+        argv = request["argv"]
+        if (
+            type(argv) is not list
+            or not argv
+            or any(type(part) is not str or not part for part in argv)
+            or request["songHash"] != self._song_hash
+        ):
+            return self._reject(request, code="INVALID_REQUEST", reason="invalid argv or song")
+        body = {
+            "argv": argv,
+            "songHash": request["songHash"],
+            "workdir": request["workdir"],
+        }
+        request_hash = _digest_json(body)
+        invocation_id = hashlib.sha256(
+            f"chart-worker-resident-invocation-v1:{request_hash}".encode("ascii")
+        ).hexdigest()
+        if request["requestHash"] != request_hash or request["invocationId"] != invocation_id:
+            return self._reject(request, code="INVALID_REQUEST", reason="request identity mismatch")
+        try:
+            workdir = self._resolve_workdir(request["workdir"])
+        except ValueError as error:
+            return self._reject(request, code="INVALID_REQUEST", reason=str(error))
+        marker = workdir / TERMINAL_MARKER_NAME
+        if workdir.exists():
+            if not workdir.is_dir() or workdir.is_symlink():
+                return self._reject(request, code="UNKNOWN_COMPLETION", reason="unsafe workdir")
+            entries = list(workdir.iterdir())
+            if marker.exists():
+                existing = self._read_marker(marker)
+                if existing is None:
+                    return self._reject(request, code="UNKNOWN_COMPLETION", reason="corrupt marker")
+                if not self._artifacts_match(workdir, existing["artifacts"]):
+                    return self._reject(
+                        request,
+                        code="UNKNOWN_COMPLETION",
+                        reason="terminal artifact set or hash does not match",
+                    )
+                if (
+                    existing["invocationId"] != invocation_id
+                    or existing["requestHash"] != request_hash
+                ):
+                    return self._reject(
+                        request,
+                        code="INVOCATION_CONFLICT",
+                        reason="workdir belongs to a different invocation",
+                    )
+                replayed = dict(existing)
+                replayed["replayed"] = True
+                return [replayed]
+            if entries:
+                return self._reject(
+                    request,
+                    code="UNKNOWN_COMPLETION",
+                    reason="nonempty workdir has no terminal marker",
+                )
+        else:
+            workdir.mkdir(parents=True)
+
+        accepted = {
+            "version": 1,
+            "type": "ACCEPTED",
+            "invocationId": invocation_id,
+            "requestHash": request_hash,
+        }
+        try:
+            result = self._execute(list(argv), workdir)
+        except ManiaTailRepairExhausted as error:
+            result = ResidentExecutionResult(
+                returncode=1,
+                stdout=format_mania_tail_terminal_line(error),
+                stderr="",
+            )
+        except Exception as error:  # noqa: BLE001 - inference failures become definitive terminals
+            traceback.print_exc(file=sys.stderr)
+            result = ResidentExecutionResult(
+                returncode=1,
+                stdout="",
+                stderr=f"{type(error).__name__}: {error}"[-2000:],
+            )
+        artifacts = self._collect_artifacts(workdir)
+        if result.returncode == 0 and not any(
+            artifact["relativePath"].lower().endswith(".osu") for artifact in artifacts
+        ):
+            result = ResidentExecutionResult(
+                returncode=1,
+                stdout="",
+                stderr="resident success produced no .osu artifact",
+            )
+        terminal = self._terminal(request, result, artifacts)
+        self._write_marker(marker, terminal)
+        return [accepted, terminal]
+
+    def handle(self, record: dict[str, object]) -> list[dict[str, object]]:
+        if type(record) is not dict or record.get("version") != 1:
+            raise ValueError("resident record must be a version 1 object")
+        record_type = record.get("type")
+        if record_type == "BEGIN_SONG":
+            return self._begin_song(record)
+        if record_type == "END_SONG":
+            return self._end_song(record)
+        if record_type == "INVOKE":
+            return self._invoke(record)
+        if record_type == "SHUTDOWN" and set(record) == {"version", "type"}:
+            return [{"version": 1, "type": "SHUTDOWN_COMPLETE"}]
+        raise ValueError(f"unsupported resident record type: {record_type!r}")
+
+
+def _emit_record(stream: BufferedWriter, record: dict[str, object]) -> None:
+    payload = json.dumps(
+        record,
+        ensure_ascii=True,
+        sort_keys=True,
+        separators=(",", ":"),
+        allow_nan=False,
+    ).encode("utf-8") + b"\n"
+    if len(payload) > _MAX_TERMINAL_LINE_BYTES:
+        raise ValueError("resident protocol record exceeds 1 MiB")
+    stream.write(payload)
+    stream.flush()
+
+
+def serve_resident_worker(
+    worker: ResidentWorker,
+    *,
+    input_stream: BufferedReader,
+    output_stream: BufferedWriter,
+) -> int:
+    """Serve strict bounded NDJSON until clean SHUTDOWN or input EOF."""
+
+    _emit_record(output_stream, worker.ready_record())
+    while True:
+        line = input_stream.readline(_MAX_TERMINAL_LINE_BYTES + 1)
+        if line == b"":
+            return 0
+        if len(line) > _MAX_TERMINAL_LINE_BYTES or not line.endswith(b"\n"):
+            return 2
+        try:
+            record = json.loads(
+                line.decode("utf-8", errors="strict"),
+                object_pairs_hook=_json_without_duplicate_keys,
+            )
+            if type(record) is not dict:
+                return 2
+            responses = worker.handle(record)
+        except (UnicodeDecodeError, json.JSONDecodeError, ValueError, RecursionError):
+            return 2
+        for response in responses:
+            _emit_record(output_stream, response)
+        if record.get("type") == "SHUTDOWN":
+            return 0
+
+
+def _parse_cli() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description="Mapperatorinator resident inference worker")
+    parser.add_argument("--home", type=Path, required=True)
+    parser.add_argument("--job-root", type=Path, required=True)
+    parser.add_argument("--model-root", type=Path, required=True)
+    parser.add_argument("--model-revision", required=True)
+    parser.add_argument("--upstream-commit", required=True)
+    parser.add_argument("--patch-set-id", required=True)
+    return parser.parse_args()
+
+
+def _validate_resolved_output_path(resolved_args: object, workdir: Path) -> Path:
+    """Bind a composed request to the already accepted invocation directory."""
+    raw_output_path = getattr(resolved_args, "output_path", None)
+    if type(raw_output_path) not in {str, Path}:
+        raise ValueError("resolved output_path must identify the accepted workdir")
+    output_path = Path(raw_output_path)
+    if not output_path.is_absolute():
+        raise ValueError("resolved output_path must identify the accepted workdir")
+    try:
+        resolved_output = output_path.resolve(strict=True)
+        resolved_workdir = workdir.resolve(strict=True)
+    except OSError as error:
+        raise ValueError("resolved output_path must identify the accepted workdir") from error
+    if resolved_output != resolved_workdir:
+        raise ValueError("resolved output_path does not match the accepted workdir")
+    return resolved_output
+
+
+def _validate_resolved_audio_path(resolved_args: object, job_root: Path) -> Path:
+    """Require the composed request audio to be an immutable job-root asset."""
+    raw_audio_path = getattr(resolved_args, "audio_path", None)
+    if type(raw_audio_path) is not str:
+        raise ValueError("resolved audio_path must be a file beneath the accepted job root")
+    audio_path = Path(raw_audio_path)
+    if not audio_path.is_absolute() or audio_path.is_symlink() or not audio_path.is_file():
+        raise ValueError("resolved audio_path must be a file beneath the accepted job root")
+    resolved_audio = audio_path.resolve(strict=True)
+    resolved_job_root = job_root.resolve(strict=True)
+    if not resolved_audio.is_relative_to(resolved_job_root):
+        raise ValueError("resolved audio_path must be a file beneath the accepted job root")
+    return resolved_audio
+
+
+def main() -> int:
+    args = _parse_cli()
+    home = args.home.resolve(strict=True)
+    job_root = args.job_root.resolve(strict=True)
+    protocol_input = sys.stdin.buffer
+    protocol_output = sys.stdout.buffer
+    # No imported inference code may write to protocol stdout.
+    sys.stdout = sys.stderr
+
+    from .resident_runtime import ResidentInferenceRuntime
+
+    runtime = ResidentInferenceRuntime(
+        model_root=args.model_root.resolve(strict=True),
+        revision=args.model_revision,
+        upstream_commit=args.upstream_commit,
+        patch_set_id=args.patch_set_id,
+    )
+    # Offline variables are now forced before importing inference/Transformers/HF helpers.
+    import inference
+    from hydra import compose, initialize_config_dir
+    from omegaconf import OmegaConf
+
+    config_dir = (home / "configs" / "inference").resolve(strict=True)
+
+    def execute(argv: list[str], workdir: Path) -> ResidentExecutionResult:
+        if (
+            len(argv) < 4
+            or Path(argv[1]).name != "inference.py"
+            or argv[2] != "-cn"
+            or type(argv[3]) is not str
+            or not argv[3]
+        ):
+            raise ValueError("resident argv must preserve the inference.py -cn contract")
+        with initialize_config_dir(config_dir=str(config_dir), version_base="1.1"):
+            config = compose(config_name=argv[3], overrides=argv[4:])
+        resolved_args = OmegaConf.to_object(config)
+        _validate_resolved_output_path(resolved_args, workdir)
+        resolved_audio = _validate_resolved_audio_path(resolved_args, job_root)
+        runtime.validate_invocation_audio(resolved_audio)
+        inference.execute_inference(resolved_args, runtime=runtime)
+        runtime.validate_invocation_audio(resolved_audio)
+        _validate_resolved_output_path(resolved_args, workdir)
+        return ResidentExecutionResult(returncode=0, stdout="", stderr="")
+
+    worker = ResidentWorker(
+        job_root=job_root,
+        execute=execute,
+        begin_song=runtime.begin_song,
+        end_song=runtime.end_song,
+    )
+    return serve_resident_worker(
+        worker,
+        input_stream=protocol_input,
+        output_stream=protocol_output,
+    )
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
