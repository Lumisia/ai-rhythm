+++ b/osuT5/osuT5/inference/encoder_cache.py
@@ -0,0 +1,246 @@
+"""Exact-key, song-bounded CPU cache for precomputed encoder tensors."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+from collections import OrderedDict
+from collections.abc import Mapping
+from dataclasses import dataclass
+from threading import RLock
+
+import torch
+
+_HEX = frozenset("0123456789abcdef")
+
+
+def _require_digest(value: object, *, name: str, allow_none: bool = False) -> str | None:
+    if value is None and allow_none:
+        return None
+    if type(value) is not str or len(value) != 64 or any(char not in _HEX for char in value):
+        raise ValueError(f"{name} must be an exact lowercase SHA-256")
+    return value
+
+
+def _canonical_value(value: object, active: set[int]) -> object:
+    if value is None or type(value) in (str, bool, int):
+        return value
+    if type(value) is float:
+        if not math.isfinite(value):
+            raise ValueError("cache identity floats must be finite")
+        return {"floatHex": value.hex()}
+    if type(value) in (list, tuple):
+        identity = id(value)
+        if identity in active:
+            raise ValueError("cache identity must not contain cycles")
+        active.add(identity)
+        try:
+            return [_canonical_value(item, active) for item in value]
+        finally:
+            active.remove(identity)
+    if type(value) is dict:
+        if any(type(key) is not str for key in value):
+            raise TypeError("cache identity mapping keys must be plain strings")
+        identity = id(value)
+        if identity in active:
+            raise ValueError("cache identity must not contain cycles")
+        active.add(identity)
+        try:
+            return {key: _canonical_value(value[key], active) for key in sorted(value)}
+        finally:
+            active.remove(identity)
+    raise TypeError(f"unsupported cache identity value: {type(value).__name__}")
+
+
+def _json_digest(value: object) -> str:
+    encoded = json.dumps(
+        _canonical_value(value, set()),
+        ensure_ascii=True,
+        sort_keys=True,
+        separators=(",", ":"),
+        allow_nan=False,
+    ).encode("utf-8")
+    return hashlib.sha256(encoded).hexdigest()
+
+
+def _tensor_digest(tensor: torch.Tensor) -> str:
+    if not isinstance(tensor, torch.Tensor) or tensor.device.type != "cpu":
+        raise ValueError("cache identity tensors must be CPU tensors")
+    value = tensor.detach().contiguous()
+    digest = hashlib.sha256()
+    digest.update(str(value.dtype).encode("ascii"))
+    digest.update(json.dumps(list(value.shape), separators=(",", ":")).encode("ascii"))
+    if value.numel():
+        digest.update(value.view(torch.uint8).numpy().tobytes(order="C"))
+    return digest.hexdigest()
+
+
+def _tensor_mapping_digest(values: Mapping[str, torch.Tensor]) -> str:
+    if not isinstance(values, Mapping) or any(type(key) is not str for key in values):
+        raise TypeError("conditioning must be a string-to-tensor mapping")
+    return _json_digest({key: _tensor_digest(values[key]) for key in sorted(values)})
+
+
+@dataclass(frozen=True, slots=True)
+class EncoderCacheKey:
+    model_manifest_sha256: str
+    model_config_sha256: str
+    audio_sha256: str
+    reference_sha256: str | None
+    preprocessing_sha256: str
+    frames_sha256: str
+    conditioning_sha256: str
+    song_positions_sha256: str
+    precision: str
+    encoder_dtype: str
+
+    def __post_init__(self) -> None:
+        for field in (
+            "model_manifest_sha256",
+            "model_config_sha256",
+            "audio_sha256",
+            "preprocessing_sha256",
+            "frames_sha256",
+            "conditioning_sha256",
+            "song_positions_sha256",
+        ):
+            _require_digest(getattr(self, field), name=field)
+        _require_digest(self.reference_sha256, name="reference_sha256", allow_none=True)
+        if type(self.precision) is not str or not self.precision:
+            raise ValueError("precision must be a non-empty plain string")
+        if type(self.encoder_dtype) is not str or not self.encoder_dtype:
+            raise ValueError("encoder_dtype must be a non-empty plain string")
+
+
+def build_encoder_cache_key(
+    *,
+    model_manifest_sha256: str,
+    model_config_sha256: str,
+    audio_sha256: str,
+    reference_sha256: str | None,
+    preprocessing: Mapping[str, object],
+    frames: torch.Tensor,
+    conditioning: Mapping[str, torch.Tensor],
+    song_positions: torch.Tensor | None,
+    precision: str,
+    encoder_dtype: torch.dtype,
+) -> EncoderCacheKey:
+    if not isinstance(preprocessing, Mapping):
+        raise TypeError("preprocessing must be a mapping")
+    if not isinstance(encoder_dtype, torch.dtype):
+        raise TypeError("encoder_dtype must be a torch.dtype")
+    return EncoderCacheKey(
+        model_manifest_sha256=model_manifest_sha256,
+        model_config_sha256=model_config_sha256,
+        audio_sha256=audio_sha256,
+        reference_sha256=reference_sha256,
+        preprocessing_sha256=_json_digest(dict(preprocessing)),
+        frames_sha256=_tensor_digest(frames),
+        conditioning_sha256=_tensor_mapping_digest(conditioning),
+        song_positions_sha256=(
+            _tensor_digest(song_positions) if song_positions is not None else _json_digest(None)
+        ),
+        precision=precision,
+        encoder_dtype=str(encoder_dtype),
+    )
+
+
+@dataclass(frozen=True, slots=True)
+class EncoderCacheStats:
+    hits: int
+    misses: int
+    puts: int
+    evictions: int
+    oversize_bypasses: int
+    entries: int
+    bytes: int
+
+    def to_dict(self) -> dict[str, int]:
+        return {
+            "hits": self.hits,
+            "misses": self.misses,
+            "puts": self.puts,
+            "evictions": self.evictions,
+            "oversizeBypasses": self.oversize_bypasses,
+            "entries": self.entries,
+            "bytes": self.bytes,
+        }
+
+
+class ExactEncoderCache:
+    def __init__(self, *, max_entries: int, max_bytes: int) -> None:
+        if type(max_entries) is not int or not 1 <= max_entries <= 1024:
+            raise ValueError("max_entries must be an exact int in [1, 1024]")
+        if type(max_bytes) is not int or max_bytes <= 0:
+            raise ValueError("max_bytes must be a positive exact int")
+        self._max_entries = max_entries
+        self._max_bytes = max_bytes
+        self._values: OrderedDict[EncoderCacheKey, torch.Tensor] = OrderedDict()
+        self._bytes = 0
+        self._hits = 0
+        self._misses = 0
+        self._puts = 0
+        self._evictions = 0
+        self._oversize_bypasses = 0
+        self._lock = RLock()
+
+    @staticmethod
+    def _tensor_bytes(value: torch.Tensor) -> int:
+        return value.numel() * value.element_size()
+
+    def get(self, key: EncoderCacheKey) -> torch.Tensor | None:
+        if not isinstance(key, EncoderCacheKey):
+            raise TypeError("key must be EncoderCacheKey")
+        with self._lock:
+            stored = self._values.get(key)
+            if stored is None:
+                self._misses += 1
+                return None
+            self._values.move_to_end(key)
+            self._hits += 1
+            return stored.clone()
+
+    def put(self, key: EncoderCacheKey, value: torch.Tensor) -> bool:
+        if not isinstance(key, EncoderCacheKey):
+            raise TypeError("key must be EncoderCacheKey")
+        if not isinstance(value, torch.Tensor) or value.device.type != "cpu":
+            raise ValueError("encoder cache values must be CPU tensors")
+        if value.requires_grad:
+            raise ValueError("encoder cache values must not require gradients")
+        stored = value.detach().contiguous().clone()
+        size = self._tensor_bytes(stored)
+        with self._lock:
+            if size > self._max_bytes:
+                self._oversize_bypasses += 1
+                return False
+            existing = self._values.pop(key, None)
+            if existing is not None:
+                self._bytes -= self._tensor_bytes(existing)
+            while self._values and (
+                len(self._values) >= self._max_entries or self._bytes + size > self._max_bytes
+            ):
+                _, evicted = self._values.popitem(last=False)
+                self._bytes -= self._tensor_bytes(evicted)
+                self._evictions += 1
+            self._values[key] = stored
+            self._bytes += size
+            self._puts += 1
+            return True
+
+    def clear(self) -> None:
+        with self._lock:
+            self._values.clear()
+            self._bytes = 0
+
+    def stats(self) -> EncoderCacheStats:
+        with self._lock:
+            return EncoderCacheStats(
+                hits=self._hits,
+                misses=self._misses,
+                puts=self._puts,
+                evictions=self._evictions,
+                oversize_bypasses=self._oversize_bypasses,
+                entries=len(self._values),
+                bytes=self._bytes,
+            )
