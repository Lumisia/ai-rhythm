+++ b/tests/test_encoder_cache.py
@@ -0,0 +1,211 @@
+from __future__ import annotations
+
+from dataclasses import replace
+from types import SimpleNamespace
+
+import pytest
+import torch
+from osuT5.osuT5.inference import processor as processor_module
+from osuT5.osuT5.inference.encoder_cache import (
+    EncoderCacheKey,
+    ExactEncoderCache,
+    build_encoder_cache_key,
+)
+from osuT5.osuT5.inference.processor import Processor
+
+
+def _key(**overrides) -> EncoderCacheKey:
+    values = {
+        "model_manifest_sha256": "a" * 64,
+        "model_config_sha256": "b" * 64,
+        "audio_sha256": "c" * 64,
+        "reference_sha256": "d" * 64,
+        "preprocessing_sha256": "e" * 64,
+        "frames_sha256": "f" * 64,
+        "conditioning_sha256": "1" * 64,
+        "song_positions_sha256": "2" * 64,
+        "precision": "fp16",
+        "encoder_dtype": "torch.float32",
+    }
+    return EncoderCacheKey(**(values | overrides))
+
+
+@pytest.mark.parametrize(
+    "field",
+    [
+        "model_manifest_sha256",
+        "model_config_sha256",
+        "audio_sha256",
+        "reference_sha256",
+        "preprocessing_sha256",
+        "frames_sha256",
+        "conditioning_sha256",
+        "song_positions_sha256",
+        "precision",
+        "encoder_dtype",
+    ],
+)
+def test_exact_key_changes_are_cache_misses(field: str):
+    cache = ExactEncoderCache(max_entries=4, max_bytes=1024)
+    original = _key()
+    cache.put(original, torch.arange(8, dtype=torch.float32))
+    value = "3" * 64 if field.endswith("sha256") else "different"
+
+    assert cache.get(replace(original, **{field: value})) is None
+
+
+def test_cache_returns_independent_cpu_values_and_tracks_hits():
+    cache = ExactEncoderCache(max_entries=4, max_bytes=1024)
+    key = _key()
+    source = torch.arange(8, dtype=torch.float32)
+
+    assert cache.get(key) is None
+    assert cache.put(key, source) is True
+    source[0] = 99
+    first = cache.get(key)
+    assert first is not None
+    first[1] = 88
+    second = cache.get(key)
+
