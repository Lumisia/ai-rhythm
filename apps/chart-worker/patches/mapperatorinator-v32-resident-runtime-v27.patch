+    prefix = [keycount_token(4), FakeTokenizer.sos_id, 30, 12]
+
+    processor(torch.tensor([prefix]), scores())
+    after_sustain = processor(
+        torch.tensor([prefix + [sustain_token]]),
+        scores(),
+    )
+
+    for token in (50, 51, 52, sustain_token):
+        assert torch.isneginf(after_sustain[0, token])
+
+    next_group = processor(
+        torch.tensor([prefix + [sustain_token, 31, 12]]),
+        scores(),
+    )
+    assert not torch.isneginf(next_group[0, sustain_token])
+    assert not torch.isneginf(next_group[0, 50])
+
+
+def test_hold_state_can_force_sustain_as_the_last_group_completion_token():
+    prefix = [keycount_token(4), FakeTokenizer.sos_id, 30, 12]
+    processor = ManiaHoldStateLogitsProcessor(
+        FakeTokenizer(),
+        (),
+        max_sequence_length=len(prefix) + 1,
+    )
+    candidate_scores = scores()
+    candidate_scores[0, 50:53] = -torch.inf
+    sustain_token = FakeTokenizer.event_start[EventType.HOLD_NOTE_SUSTAIN]
+
+    result = processor(torch.tensor([prefix]), candidate_scores)
+
+    assert not torch.isneginf(result[0, sustain_token])
+
+
