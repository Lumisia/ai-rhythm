+@dataclass(frozen=True, slots=True)
+class ManiaTemporalHorizon:
+    current_time_token: int | None
+    effective_cut_time_token: int
+    remaining_decoder_slots: int
+    minimum_close_tokens: int
+    can_start_hold: bool
+    can_advance_time: bool
+
+
+def compute_mania_temporal_horizon(
+        *,
+        current_time_token: int | None,
+        effective_cut_time_token: int,
+        remaining_decoder_slots: int,
+        minimum_close_tokens: int,
+) -> ManiaTemporalHorizon:
+    """Return whether a new HOLD can still advance and close before the cut.
+
+    ``remaining_decoder_slots`` is measured after the prospective HOLD_START.
+    A new HOLD requires a strictly later TIME_SHIFT plus its COLUMN and
+    HOLD_END. Existing open HOLDs may share that later TIME_SHIFT.
+    """
+    if current_time_token is not None and type(current_time_token) is not int:
+        raise TypeError("current_time_token must be an exact integer or None")
+    if type(effective_cut_time_token) is not int:
+        raise TypeError("effective_cut_time_token must be an exact integer")
+    if type(remaining_decoder_slots) is not int:
+        raise TypeError("remaining_decoder_slots must be an exact integer")
+    if remaining_decoder_slots < 0:
+        raise ValueError("remaining_decoder_slots must be non-negative")
+    if type(minimum_close_tokens) is not int:
+        raise TypeError("minimum_close_tokens must be an exact integer")
+    if minimum_close_tokens <= 0:
+        raise ValueError("minimum_close_tokens must be positive")
+    can_advance_time = (
+        current_time_token is None
+        or current_time_token < effective_cut_time_token
+    )
+    return ManiaTemporalHorizon(
+        current_time_token=current_time_token,
+        effective_cut_time_token=effective_cut_time_token,
+        remaining_decoder_slots=remaining_decoder_slots,
+        minimum_close_tokens=minimum_close_tokens,
+        can_start_hold=(
+            current_time_token is not None
+            and can_advance_time
+            and remaining_decoder_slots >= minimum_close_tokens
+        ),
+        can_advance_time=can_advance_time,
+    )
+
