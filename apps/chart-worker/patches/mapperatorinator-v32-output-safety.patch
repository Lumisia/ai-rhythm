diff --git a/tests/test_mania_output_safety.py b/tests/test_mania_output_safety.py
new file mode 100644
--- /dev/null
+++ b/tests/test_mania_output_safety.py
@@ -0,0 +1,95 @@
+from datetime import timedelta
+from types import SimpleNamespace
+
+import pytest
+from slider import TimingPoint
+
+from osuT5.osuT5.event import Event, EventType
+from osuT5.osuT5.inference.postprocessor import BeatmapConfig, Postprocessor
+from osuT5.osuT5.inference.processor import Processor
+
+
+def make_postprocessor():
+    args = SimpleNamespace(
+        offset=0,
+        bpm=120,
+        timing_leniency=0,
+        train=SimpleNamespace(data=SimpleNamespace(
+            types_first=False,
+            add_positions=True,
+            mania_bpm_normalized_scroll_speed=False,
+            add_sv=False,
+        )),
+        start_time=None,
+        end_time=2_000,
+        snap_near_perfect_overlaps=False,
+    )
+    return Postprocessor(args)
+
+
+def test_overlapping_mania_holds_are_paired_by_lane():
+    events = [
+        Event(EventType.TIME_SHIFT, 0),
+        Event(EventType.POS_X, 64),
+        Event(EventType.POS_Y, 192),
+        Event(EventType.HOLD_NOTE, 0),
+        Event(EventType.TIME_SHIFT, 100),
+        Event(EventType.POS_X, 192),
+        Event(EventType.POS_Y, 192),
+        Event(EventType.HOLD_NOTE, 0),
+        Event(EventType.TIME_SHIFT, 500),
+        Event(EventType.POS_X, 64),
+        Event(EventType.POS_Y, 192),
+        Event(EventType.HOLD_NOTE_END, 0),
+        Event(EventType.TIME_SHIFT, 600),
+        Event(EventType.POS_X, 192),
+        Event(EventType.POS_Y, 192),
+        Event(EventType.HOLD_NOTE_END, 0),
+    ]
+
+    result = make_postprocessor().generate(
+        events,
+        BeatmapConfig(mode=3, circle_size=4),
+    )
+
+    hold_rows = [row for row in result.splitlines() if ",128," in row]
+    assert hold_rows == [
+        "64,192,0,128,0,500:0:0:-1:0:",
+        "192,192,100,128,0,600:0:0:-1:0:",
+    ]
+
+
+def test_resnap_never_returns_a_negative_tick():
+    timing = [
+        TimingPoint(
+            timedelta(milliseconds=120),
+            500,
+            4,
+            2,
+            -1,
+            100,
+            None,
+            False,
+        )
+    ]
+
+    assert make_postprocessor().resnap(0, timing, 4) == 0
+
+
+def test_unknown_descriptor_is_rejected_instead_of_becoming_unk():
+    processor = Processor.__new__(Processor)
+    for name in (
+        "add_gamemode_token", "add_style_token", "add_diff_token", "add_mapper_token",
+        "add_year_token", "add_hitsounded_token", "add_song_length_token",
+        "add_global_sv_token", "add_cs_token", "add_keycount_token",
+        "add_hold_note_ratio_token", "add_scroll_speed_ratio_token", "add_sv",
+    ):
+        setattr(processor, name, False)
+    processor.add_descriptors = True
+    processor.tokenizer = SimpleNamespace(descriptor_idx={}, descriptor_unk=77)
+
+    with pytest.raises(ValueError, match="missing"):
+        processor.get_class_vector(
+            SimpleNamespace(gamemode=0, descriptors=["missing"]),
+            1_000,
+        )
