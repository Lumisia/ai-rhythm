+def effective_generation_limit(model, configured_max_length):
+    """Return the generation limit enforced by both the model and caller."""
+    model_max_length = int(model.config.max_target_positions)
+    if configured_max_length is None:
+        generation_config = getattr(model, "generation_config", None)
+        configured_max_length = getattr(generation_config, "max_length", None)
+    if configured_max_length is None:
+        return model_max_length
+    return min(int(configured_max_length), model_max_length)
+
