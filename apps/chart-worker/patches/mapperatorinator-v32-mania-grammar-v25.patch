+def test_discontinuity_without_contract_clears_state_and_later_reactivates():
+    oracle = ManiaHoldStateLogitsProcessor(
+        FakeTokenizer(), (), hold_state_mode="full_scan"
+    )
+    candidate = ManiaHoldStateLogitsProcessor(
+        FakeTokenizer(), (), hold_state_mode="incremental"
+    )
+    prefixes = [
+        [keycount_token(4), 1, 30],
+        [keycount_token(4), 1, 30, 10],
+        [1, 30],
+    ]
+    for prefix in prefixes:
+        oracle_error, oracle_result = _processor_call(oracle, prefix)
+        candidate_error, candidate_result = _processor_call(candidate, prefix)
+        assert candidate_error is oracle_error
+        if oracle_error is None:
+            assert torch.equal(candidate_result, oracle_result)
+
+    assert candidate._incremental_state is None
+    assert candidate.telemetry()["stateResetRows"] == 1
+
+    reactivated = [1, 30, 10, 50, keycount_token(4)]
+    oracle_error, oracle_result = _processor_call(oracle, reactivated)
+    candidate_error, candidate_result = _processor_call(candidate, reactivated)
+    assert candidate_error is oracle_error
+    assert torch.equal(candidate_result, oracle_result)
+    assert candidate._incremental_state.prompt_length == 3
+
+    connected = reactivated + [30, 10, 50]
+    for end in range(len(reactivated) + 1, len(connected) + 1):
+        oracle_error, oracle_result = _processor_call(oracle, connected[:end])
+        candidate_error, candidate_result = _processor_call(
+            candidate, connected[:end]
+        )
+        assert candidate_error is oracle_error
+        if oracle_error is None:
+            assert torch.equal(candidate_result, oracle_result)
+
