+def test_incremental_state_matches_full_scan_oracle_for_1024_seeded_cases():
+    rng = random.Random(20260812)
+    event_tokens = {
+        EventType.CIRCLE: 50,
+        EventType.HOLD_NOTE: 51,
+        EventType.HOLD_NOTE_END: 52,
+    }
+
+    for case_index in range(1024):
+        keycount = rng.randint(1, 4)
+        lane = rng.randrange(keycount)
+        column = 10 + lane
+        time_token = rng.randint(30, 34)
+        scenario = case_index % 10
+        initial_open = (lane,) if scenario in {3, 6} else ()
+        processor = ManiaHoldStateLogitsProcessor(FakeTokenizer(), initial_open)
+
+        if scenario == 0:  # Candidate time is inside a prompt HOLD timeline.
+            prompt = torch.tensor([
+                keycount_token(keycount), 1,
+                time_token, column, 51,
+                time_token + 2, column, 52,
+            ])
+            current = torch.cat((prompt, torch.tensor([time_token + 1, column])))
+        elif scenario == 1:  # A generated exact duplicate remains illegal.
+            prompt = torch.tensor([keycount_token(keycount), 1])
+            current = torch.tensor([
+                keycount_token(keycount), 1,
+                time_token, column, 50,
+                time_token, column,
+            ])
+        elif scenario == 2:  # A fixed prompt duplicate remains idempotent.
+            prompt = torch.tensor([
+                keycount_token(keycount), 1, time_token, column, 50,
+            ])
+            current = torch.tensor([
+                keycount_token(keycount), 1,
+                time_token, column, 50,
+                time_token, column, 50,
+                time_token, column,
+            ])
+        elif scenario == 3:  # END+START is legal; adding TAP is not.
+            prompt = torch.tensor([
+                keycount_token(keycount), 1,
+                time_token, column, 52,
+                time_token, column, 51,
+            ])
+            current = torch.cat((prompt, torch.tensor([time_token, column])))
+        elif scenario == 4:  # Prompt events after the candidate are replayed later.
+            prompt = torch.tensor([
+                keycount_token(keycount), 1,
+                time_token + 2, column, 51,
+                time_token + 4, column, 52,
+            ])
+            current = torch.cat((prompt, torch.tensor([time_token, column])))
+        elif scenario == 5:  # A new SOS drops the pre-SOS parsed timeline.
+            prompt = torch.tensor([
+                keycount_token(keycount), 1, time_token, column, 51,
+            ])
+            current = torch.cat((prompt, torch.tensor([1, time_token, column])))
+        elif scenario == 6:  # Orphan/overlap failures compare by exception class.
+            prompt = torch.tensor([
+                keycount_token(keycount), 1, time_token, column, 51,
+            ])
+            current = prompt.clone()
+        elif scenario == 7:  # Same-length replacement forces a rebuild.
+            prompt = torch.tensor([
+                keycount_token(keycount), 1, time_token, column,
+            ])
+            current = torch.tensor([
+                keycount_token(keycount), 1, time_token + 1, column,
+            ])
+        elif scenario == 8:  # Shorter replacement cannot retain stale groups.
+            prompt = torch.tensor([
+                keycount_token(keycount), 1,
+                time_token, column, 51,
+                time_token + 2, column, 52,
+            ])
+            current = torch.tensor([
+                keycount_token(keycount), 1, time_token + 1, column,
+            ])
+        else:  # Normal one-token growth exercises the suffix-only path.
+            prompt = torch.tensor([keycount_token(keycount), 1])
+            current = prompt.clone()
+
+        state = hold_logits._IncrementalManiaRowState.from_prompt(processor, prompt)
+        if scenario == 9:
+            for token in (time_token, column):
+                current = torch.cat((current, torch.tensor([token])))
+                state.ingest_suffix(processor, current)
+        else:
+            state.ingest_suffix(processor, current)
+
+        oracle_error, oracle = _capture_result(
+            lambda: _full_scan_row_oracle(processor, current, len(prompt))
+        )
+        state_error, state_final = _capture_result(
+            lambda: state.final_open_columns(frozenset(initial_open))
+        )
+        assert state_error is oracle_error, case_index
+        if oracle_error is not None:
+            continue
+
+        assert state.keycount == oracle["keycount"], case_index
+        assert state.current_time_token == oracle["current_time_token"], case_index
+        assert state.current_lane == oracle["current_lane"], case_index
+        assert state.seen_groups == oracle["seen_groups"], case_index
+        assert state.generated_groups == oracle["generated_groups"], case_index
+        assert state_final == oracle["final_open_columns"], case_index
+
+        candidate_event = rng.choice(tuple(event_tokens))
+        oracle_candidate_error, oracle_candidate = _capture_result(
+            lambda: _oracle_candidate_final_open_columns(
+                processor, oracle, candidate_event
+            )
+        )
+        state_candidate_error, state_candidate = _capture_result(
+            lambda: state.candidate_final_open_columns(
+                frozenset(initial_open), candidate_event
+            )
+        )
+        assert state_candidate_error is oracle_candidate_error, case_index
+        assert state_candidate == oracle_candidate, case_index
+
