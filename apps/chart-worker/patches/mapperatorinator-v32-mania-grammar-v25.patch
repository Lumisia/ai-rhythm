+def test_connected_append_does_not_rescan_or_transfer_historical_row(monkeypatch):
+    processor = ManiaHoldStateLogitsProcessor(
+        FakeTokenizer(), (), hold_state_mode="incremental"
+    )
+    prefix = torch.tensor([[keycount_token(4), 1, 30]])
+    processor(prefix, scores())
+
+    def unexpected_contract_scan(_tokens):
+        raise AssertionError("connected append rescanned keycount/SOS history")
+
+    monkeypatch.setattr(
+        processor,
+        "_row_has_grammar_contract",
+        unexpected_contract_scan,
+    )
+    token_transfer_sizes = []
+    original_token_values = hold_logits._IncrementalManiaRowState._token_values
+
+    def record_token_values(tokens):
+        token_transfer_sizes.append(int(tokens.numel()))
+        return original_token_values(tokens)
+
+    monkeypatch.setattr(
+        hold_logits._IncrementalManiaRowState,
+        "_token_values",
+        staticmethod(record_token_values),
+    )
+
+    processor(
+        torch.tensor([[keycount_token(4), 1, 30, 10]]),
+        scores(),
+    )
+
+    assert token_transfer_sizes == [1]
+
