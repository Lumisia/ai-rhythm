+def test_actual_processor_masks_match_over_1000_seeded_prefix_candidates():
+    rng = random.Random(419_003)
+    event_tokens = [50, 51, 52]
+    generated_templates = (
+        (),
+        (30,),
+        (30, 10),
+        (30, 10, 50),
+        (30, 10, 51),
+        (30, 10, 52),
+        (30, 10, 51, 31, 10),
+        (32, 10, 52, 31, 10),
+        (30, 10, 50, 30, 10),
+        (30, 10, 50, 30, 10, 50),
+        (10,),
+        (10, 51),
+        (30, 10, 51, 30, 10),
+        (30, 10, 52, 30, 10),
+        (30, 10, 51, 32, 10, 52, 31, 10),
+    )
+
+    incremental_rows = 0
+    candidate_queries = 0
+    compared_calls = 0
+    for case_index in range(1_024):
+        keycount = rng.randint(1, 4)
+        lane = rng.randrange(keycount)
+        initial_open = (lane,) if rng.randrange(4) == 0 else ()
+        prompt_time = rng.choice((None, 30, 31))
+        future_prompt = rng.randrange(5) == 0
+        prompt_signatures = (
+            (
+                32,
+                lane,
+                rng.choice(
+                    (EventType.HOLD_NOTE.value, EventType.HOLD_NOTE_END.value)
+                ),
+            ),
+        ) if future_prompt else ()
+        prompt = [keycount_token(keycount), 1]
+        if rng.randrange(3) == 0:
+            prompt += [30, 10 + lane, rng.choice(event_tokens)]
+        template = list(rng.choice(generated_templates))
+        template = [10 + lane if token == 10 else token for token in template]
+        if rng.randrange(8) == 0:
+            template += [rng.choice((30, 31, 32)), 10 + lane]
+        prefix = prompt + template
+
+        kwargs = dict(
+            prompt_group_signatures=prompt_signatures,
+            prompt_current_time_token=prompt_time,
+            require_closed_holds_at_eos=bool(rng.randrange(2)),
+            max_sequence_length=len(prefix) + rng.randrange(0, 7),
+        )
+        oracle = ManiaHoldStateLogitsProcessor(
+            FakeTokenizer(), initial_open, hold_state_mode="full_scan", **kwargs
+        )
+        candidate = ManiaHoldStateLogitsProcessor(
+            FakeTokenizer(), initial_open, hold_state_mode="incremental", **kwargs
+        )
+        connected_prefixes = [prompt]
+        for end in range(len(prompt) + 1, len(prefix) + 1):
+            connected_prefixes.append(prefix[:end])
+
+        for call_index, connected_prefix in enumerate(connected_prefixes):
+            oracle_error, oracle_result = _processor_call(
+                oracle, connected_prefix
+            )
+            candidate_error, candidate_result = _processor_call(
+                candidate, connected_prefix
+            )
+            compared_calls += 1
+            assert candidate_error is oracle_error, (case_index, call_index)
+            if oracle_error is not None:
+                break
+            assert torch.equal(candidate_result, oracle_result), (
+                case_index,
+                call_index,
+            )
+
+        telemetry = candidate.telemetry()
+        assert telemetry["stateResetRows"] == 0, case_index
+        assert telemetry["unsupportedFallbackRows"] == 0, case_index
+        incremental_rows += telemetry["incrementalRows"]
+        candidate_queries += telemetry["candidateTreeQueries"]
+
+    assert compared_calls >= 1_024
+    assert incremental_rows >= 1_500
+    assert candidate_queries >= 300
