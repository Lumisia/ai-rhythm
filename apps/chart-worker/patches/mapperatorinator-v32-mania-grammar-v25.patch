+        [1, 30, 10, 50, keycount_token(4), 30, 10],
+        [1, 30, 10, 50, keycount_token(4), 30, 10, 50],
+    ]
+
+    for call_index, prefix in enumerate(prefixes):
+        oracle_error, oracle_result = _processor_call(oracle, prefix)
+        candidate_error, candidate_result = _processor_call(candidate, prefix)
+        assert candidate_error is oracle_error, call_index
+        if oracle_error is None:
+            assert torch.equal(candidate_result, oracle_result), call_index
+
+    assert candidate.prompt_length == 2
+    assert candidate._incremental_state.prompt_length == 2
