+def _compose_hold_transitions(
+        left: HoldTransition,
+        right: HoldTransition,
+) -> HoldTransition:
+    """Apply left, then right, for CLOSED and OPEN inputs."""
+    def apply(state: int) -> int:
+        intermediate = left[state]
+        return _INVALID if intermediate == _INVALID else right[intermediate]
+
+    return apply(_CLOSED), apply(_OPEN)
+
