+class _LaneHoldTransitionTree:
+    def __init__(self, time_start: int, time_end: int) -> None:
+        if time_end < time_start:
+            raise ValueError("time_end must be greater than or equal to time_start")
+        self.time_start = time_start
+        self.time_end = time_end
+        leaf_count = 1 + time_end - time_start
+        self._size = 1
+        while self._size < leaf_count:
+            self._size *= 2
+        self._tree = [_IDENTITY_TRANSITION] * (2 * self._size)
+        self._event_types = [frozenset() for _ in range(leaf_count)]
+
+    def _leaf_index(self, time_token: int | None) -> int:
+        if time_token is None:
+            return 0
+        if not self.time_start <= time_token < self.time_end:
+            raise ValueError(
+                f"time token {time_token} is outside "
+                f"[{self.time_start}, {self.time_end})"
+            )
+        return 1 + time_token - self.time_start
+
+    @property
+    def transition(self) -> HoldTransition:
+        return self._tree[1]
+
+    def add(self, time_token: int | None, event_type: EventType) -> None:
+        leaf_index = self._leaf_index(time_token)
+        event_types = self._event_types[leaf_index] | {event_type}
+        self._event_types[leaf_index] = event_types
+        node = self._size + leaf_index
+        self._tree[node] = _mania_bucket_transition(event_types)
+        while node > 1:
+            node //= 2
+            self._tree[node] = _compose_hold_transitions(
+                self._tree[2 * node],
+                self._tree[2 * node + 1],
+            )
+
+    def query_with_candidate(
+            self,
+            time_token: int | None,
+            event_type: EventType,
+    ) -> HoldTransition:
+        leaf_index = self._leaf_index(time_token)
+        transition = _mania_bucket_transition(
+            self._event_types[leaf_index] | {event_type}
+        )
+        node = self._size + leaf_index
+        while node > 1:
+            if node % 2 == 0:
+                transition = _compose_hold_transitions(
+                    transition,
+                    self._tree[node + 1],
+                )
+            else:
+                transition = _compose_hold_transitions(
+                    self._tree[node - 1],
+                    transition,
+                )
+            node //= 2
+        return transition
+
