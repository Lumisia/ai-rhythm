+def _full_scan_row_oracle(processor, tokens, prompt_length):
+    token_log = [int(token) for token in tokens.tolist()]
+    keycount_tokens = [
+        token
+        for token in token_log
+        if processor.keycount_start <= token < processor.keycount_end
+    ]
+    if not keycount_tokens:
+        raise ValueError("mania row has no keycount token")
+    keycount = keycount_tokens[-1] - processor.keycount_start + processor.keycount_min
+    sos_positions = [
+        position for position, token in enumerate(token_log)
+        if token == processor.sos_id
+    ]
+    if not sos_positions:
+        raise ValueError("mania row has no SOS token")
+
+    current_time_token = processor.prompt_current_time_token
+    current_lane = None
+    seen_groups = set(processor.prompt_group_signatures)
+    generated_groups = set()
+    for position in range(sos_positions[-1] + 1, len(token_log)):
+        if position == prompt_length and processor.has_prompt_current_time_contract:
+            current_time_token = processor.prompt_current_time_token
+        token = token_log[position]
+        if processor.time_start <= token < processor.time_end:
+            current_time_token = token
+            current_lane = None
+        elif processor.column_start <= token < processor.column_end:
+            current_lane = token - processor.column_start
+        elif token in processor.event_type_by_token:
+            if current_lane is None:
+                raise ValueError("mania note type in prompt has no gameplay column")
+            signature = (
+                current_time_token,
+                current_lane,
+                processor.event_type_by_token[token],
+            )
+            if signature not in seen_groups:
+                seen_groups.add(signature)
+                if position >= prompt_length:
+                    generated_groups.add(signature)
+            elif position >= prompt_length and signature in generated_groups:
+                raise ValueError("duplicate mania group generated within one window")
+            current_lane = None
+
+    if len(token_log) <= prompt_length and processor.has_prompt_current_time_contract:
+        current_time_token = processor.prompt_current_time_token
+
+    groups = [
+        CanonicalManiaGroup(
+            -1 if time_token is None else time_token,
+            lane,
+            event_type,
+            (),
+        )
+        for time_token, lane, event_type in seen_groups
+    ]
+    final_open_columns = replay_mania_hold_state(
+        groups,
+        keycount=keycount,
+        initial_open_columns=processor.initial_open_columns,
+    )
+    return {
+        "keycount": keycount,
+        "current_time_token": current_time_token,
+        "current_lane": current_lane,
+        "seen_groups": seen_groups,
+        "generated_groups": generated_groups,
+        "final_open_columns": final_open_columns,
+    }
+
+
+def _oracle_candidate_final_open_columns(processor, oracle, event_type):
+    if oracle["current_lane"] is None:
+        raise ValueError("mania note type in prompt has no gameplay column")
+    signature = (
+        oracle["current_time_token"],
+        oracle["current_lane"],
+        event_type,
+    )
+    if signature in oracle["generated_groups"]:
+        raise ValueError("duplicate mania group generated within one window")
+    groups = [
+        CanonicalManiaGroup(
+            -1 if time_token is None else time_token,
+            lane,
+            group_event_type,
+            (),
+        )
+        for time_token, lane, group_event_type in oracle["seen_groups"] | {signature}
+    ]
+    return replay_mania_hold_state(
+        groups,
+        keycount=oracle["keycount"],
+        initial_open_columns=processor.initial_open_columns,
+    )
