+def _mania_bucket_transition(
+        event_types: frozenset[EventType],
+) -> HoldTransition:
+    """Summarize one time/lane bucket in END, START, TAP order."""
+    transition = _IDENTITY_TRANSITION
+    ordered_events = (
+        (EventType.HOLD_NOTE_END, (_INVALID, _CLOSED)),
+        (EventType.HOLD_NOTE, (_OPEN, _INVALID)),
+        (EventType.CIRCLE, (_CLOSED, _INVALID)),
+    )
+    for event_type, event_transition in ordered_events:
+        if event_type in event_types:
+            transition = _compose_hold_transitions(
+                transition,
+                event_transition,
+            )
+    return transition
+
