index 0000000..1fdc0f4
--- /dev/null
+++ b/osuT5/osuT5/inference/generation_telemetry.py
@@ -0,0 +1,131 @@
+"""Opt-in, hash-bound generation evidence for bounded performance experiments."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+import os
+import uuid
+from pathlib import Path
+from typing import Any
+
+
+GENERATION_TELEMETRY_SUFFIX = ".generation.json"
+_MAX_TELEMETRY_BYTES = 1_048_576
+
+
+def _sha256_path(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _plain_json(value: Any, *, path: str) -> Any:
+    if value is None or type(value) in (bool, int, str):
+        return value
+    if type(value) is float:
+        if not math.isfinite(value):
+            raise ValueError(f"{path} contains a non-finite float")
+        return value
+    if type(value) in (list, tuple):
+        return [
+            _plain_json(item, path=f"{path}[{index}]")
+            for index, item in enumerate(value)
+        ]
+    if type(value) is dict:
+        if any(type(key) is not str for key in value):
+            raise TypeError(f"{path} contains a non-string key")
+        return {
+            key: _plain_json(value[key], path=f"{path}.{key}")
+            for key in sorted(value)
+        }
+    raise TypeError(f"{path} contains unsupported type {type(value).__name__}")
+
+
+def write_generation_telemetry(
+    output_osu_path: Path,
+    *,
+    audio_path: Path,
+    reference_path: Path | None,
+    generation: dict[str, Any],
+    processor_stats: dict[str, Any],
+    runtime_stats: dict[str, Any] | None,
+) -> Path:
+    """Write one canonical sidecar only after the bound .osu exists.
+
+    This is deliberately opt-in at the inference configuration layer. It is an
+    evidence artifact, not an alternative success signal: the .osu SHA-256 and
+    both input identities are embedded so stale or cross-run telemetry cannot be
+    mistaken for the current output.
+    """
+
+    for name, path in (("output_osu_path", output_osu_path), ("audio_path", audio_path)):
+        if not isinstance(path, Path) or not path.is_file() or path.is_symlink():
+            raise FileNotFoundError(f"{name} must be an existing regular file")
+    if output_osu_path.suffix.lower() != ".osu":
+        raise ValueError("generation telemetry requires an .osu output")
+    if reference_path is not None and (
+        not isinstance(reference_path, Path)
+        or not reference_path.is_file()
+        or reference_path.is_symlink()
+    ):
+        raise FileNotFoundError("reference_path must be an existing regular file or None")
+    if type(generation) is not dict or type(processor_stats) is not dict:
+        raise TypeError("generation and processor_stats must be plain dicts")
+    if runtime_stats is not None and type(runtime_stats) is not dict:
+        raise TypeError("runtime_stats must be a plain dict or None")
+
+    payload = _plain_json(
+        {
+            "version": 1,
+            "output": {
+                "fileName": output_osu_path.name,
+                "size": output_osu_path.stat().st_size,
+                "sha256": _sha256_path(output_osu_path),
+            },
+            "input": {
+                "audioSha256": _sha256_path(audio_path),
+                "referenceSha256": (
+                    _sha256_path(reference_path) if reference_path is not None else None
+                ),
+            },
+            "generation": generation,
+            "processorStats": processor_stats,
+            "runtimeStats": runtime_stats,
+        },
+        path="telemetry",
+    )
+    encoded = (
+        json.dumps(
+            payload,
+            ensure_ascii=True,
+            sort_keys=True,
+            separators=(",", ":"),
+            allow_nan=False,
+        )
+        + "\n"
+    ).encode("utf-8")
+    if len(encoded) > _MAX_TELEMETRY_BYTES:
+        raise ValueError("generation telemetry exceeds 1 MiB")
+
+    sidecar = output_osu_path.with_suffix(GENERATION_TELEMETRY_SUFFIX)
+    temporary = sidecar.with_name(f".{sidecar.name}.{uuid.uuid4().hex}.tmp")
+    try:
+        with temporary.open("xb") as stream:
+            stream.write(encoded)
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(temporary, sidecar)
+        if os.name == "posix":
+            directory_fd = os.open(sidecar.parent, os.O_RDONLY)
+            try:
+                os.fsync(directory_fd)
+            finally:
+                os.close(directory_fd)
+    finally:
+        if temporary.exists():
+            temporary.unlink()
+    return sidecar
