diff --git a/tests/test_generation_telemetry.py b/tests/test_generation_telemetry.py
new file mode 100644
index 0000000..2a6d06f
--- /dev/null
+++ b/tests/test_generation_telemetry.py
@@ -0,0 +1,126 @@
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+
+import pytest
+
+from osuT5.osuT5.inference.generation_telemetry import (
+    GENERATION_TELEMETRY_SUFFIX,
+    write_generation_telemetry,
+)
+
+
+def _sha256(payload: bytes) -> str:
+    return hashlib.sha256(payload).hexdigest()
+
+
+def test_generation_telemetry_is_hash_bound_and_canonical(tmp_path: Path):
+    audio = tmp_path / "clip.flac"
+    reference = tmp_path / "timing.osu"
+    output = tmp_path / "generated.osu"
+    audio.write_bytes(b"bounded audio")
+    reference.write_bytes(b"timing authority")
+    output.write_bytes(b"osu file")
+    generation = {
+        "seed": 7,
+        "gamemode": 3,
+        "keycount": 4,
+        "difficulty": 1.0,
+        "outputTypes": ["map"],
+        "maniaHoldStateMode": "incremental",
+        "useServer": False,
+        "parallel": False,
+        "fastDecoderLoop": True,
+        "precision": "fp16",
+        "startTimeMs": None,
+        "endTimeMs": None,
+        "lastAttackTimeMs": 47_000,
+        "addToBeatmap": False,
+    }
+    processor_stats = {
+        "encoderWindows": 20,
+        "encoderCacheHit": False,
+        "tailRepairAttempts": 0,
+        "compiledDecode": [{"terminationReason": "EOS"}],
+    }
+    runtime_stats = {
+        "resident": True,
+        "registryLoadCount": 1,
+        "modelManifestSha256": "a" * 64,
+        "modelConfigSha256": "b" * 64,
+    }
+
+    sidecar = write_generation_telemetry(
+        output,
+        audio_path=audio,
+        reference_path=reference,
+        generation=generation,
+        processor_stats=processor_stats,
+        runtime_stats=runtime_stats,
+    )
+
+    assert sidecar == output.with_suffix(GENERATION_TELEMETRY_SUFFIX)
+    payload = json.loads(sidecar.read_text(encoding="utf-8"))
+    assert payload == {
+        "version": 1,
+        "output": {
+            "fileName": output.name,
+            "size": len(b"osu file"),
+            "sha256": _sha256(b"osu file"),
+        },
+        "input": {
+            "audioSha256": _sha256(b"bounded audio"),
+            "referenceSha256": _sha256(b"timing authority"),
+        },
+        "generation": generation,
+        "processorStats": processor_stats,
+        "runtimeStats": runtime_stats,
+    }
+    assert sidecar.read_bytes().endswith(b"\n")
+
+
+@pytest.mark.parametrize(
+    "processor_stats",
+    [
+        {"elapsed": float("nan")},
+        {"bad": {1, 2}},
+        {"bad": {1: "non-string key"}},
+    ],
+)
+def test_generation_telemetry_rejects_non_json_evidence_atomically(
+    tmp_path: Path,
+    processor_stats: dict,
+):
+    audio = tmp_path / "clip.flac"
+    output = tmp_path / "generated.osu"
+    audio.write_bytes(b"audio")
+    output.write_bytes(b"osu")
+
+    with pytest.raises((TypeError, ValueError)):
+        write_generation_telemetry(
+            output,
+            audio_path=audio,
+            reference_path=None,
+            generation={"maniaHoldStateMode": "incremental"},
+            processor_stats=processor_stats,
+            runtime_stats=None,
+        )
+
+    assert not output.with_suffix(GENERATION_TELEMETRY_SUFFIX).exists()
+
+
+def test_generation_telemetry_requires_existing_osu_and_audio(tmp_path: Path):
+    audio = tmp_path / "missing.flac"
+    output = tmp_path / "missing.osu"
+
+    with pytest.raises(FileNotFoundError):
+        write_generation_telemetry(
+            output,
+            audio_path=audio,
+            reference_path=None,
+            generation={},
+            processor_stats={},
+            runtime_stats=None,
+        )
