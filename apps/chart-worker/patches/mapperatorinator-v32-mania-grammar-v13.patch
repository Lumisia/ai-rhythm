+    def _mania_prompt_current_time_token(
+            self,
+            context: dict[str, Any],
+            frame_time: float,
+    ) -> int | None:
+        """Return the token for the append boundary inherited by a partial group."""
+        if not context["event_times"]:
+            return None
+        current_time = context["event_times"][-1]
+        relative_time = int(
+            (current_time - frame_time) / MILISECONDS_PER_STEP
+        )
+        timeshift_range = self.tokenizer.event_range[EventType.TIME_SHIFT]
+        if not (
+            timeshift_range.min_value
+            <= relative_time
+            <= timeshift_range.max_value
+        ):
+            return None
+        encoded_time = self._encode(
+            [Event(EventType.TIME_SHIFT, current_time)],
+            frame_time,
+        )
+        return int(encoded_time[0, 0].item())
+
