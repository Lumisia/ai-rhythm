+++ b/tests/test_mania_keycount_logits_processor.py
@@ -0,0 +1,72 @@
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from osuT5.osuT5.event import EventType
+from osuT5.osuT5.inference.logit_processors import ManiaKeycountLogitsProcessor
+
+
+class FakeTokenizer:
+    event_start = {
+        EventType.MANIA_COLUMN: 10,
+        EventType.MANIA_KEYCOUNT: 100,
+    }
+    event_end = {
+        EventType.MANIA_COLUMN: 28,
+        EventType.MANIA_KEYCOUNT: 118,
+    }
+    event_range = {
+        EventType.MANIA_KEYCOUNT: SimpleNamespace(min_value=1),
+    }
+
+
+def keycount_token(keycount: int) -> int:
+    return FakeTokenizer.event_start[EventType.MANIA_KEYCOUNT] + keycount - 1
+
+
+@pytest.mark.parametrize("keycount", [4, 6, 7])
+def test_masks_only_columns_outside_requested_keycount(keycount: int):
+    processor = ManiaKeycountLogitsProcessor(FakeTokenizer())
+    input_ids = torch.tensor([[1, keycount_token(keycount), 5]])
+    scores = torch.arange(32, dtype=torch.float32).unsqueeze(0)
+
+    result = processor(input_ids, scores)
+
+    column_start = FakeTokenizer.event_start[EventType.MANIA_COLUMN]
+    column_end = FakeTokenizer.event_end[EventType.MANIA_COLUMN]
+    assert torch.equal(
+        result[0, column_start:column_start + keycount],
+        scores[0, column_start:column_start + keycount],
+    )
+    assert torch.isneginf(result[0, column_start + keycount:column_end]).all()
+    assert torch.equal(result[0, :column_start], scores[0, :column_start])
+    assert torch.equal(result[0, column_end:], scores[0, column_end:])
+    assert torch.equal(scores, torch.arange(32, dtype=torch.float32).unsqueeze(0))
+
+
+def test_leaves_rows_without_a_keycount_condition_unchanged():
+    processor = ManiaKeycountLogitsProcessor(FakeTokenizer())
+    input_ids = torch.tensor([[1, 5, 6]])
+    scores = torch.arange(32, dtype=torch.float32).unsqueeze(0)
+
+    assert torch.equal(processor(input_ids, scores), scores)
+
+
+def test_uses_each_batch_rows_own_keycount():
+    processor = ManiaKeycountLogitsProcessor(FakeTokenizer())
+    input_ids = torch.tensor(
+        [
+            [1, keycount_token(4), 5],
+            [1, keycount_token(7), 5],
+        ]
+    )
+    scores = torch.zeros((2, 32), dtype=torch.float32)
+
+    result = processor(input_ids, scores)
+
+    column_start = FakeTokenizer.event_start[EventType.MANIA_COLUMN]
+    column_end = FakeTokenizer.event_end[EventType.MANIA_COLUMN]
+    assert torch.isneginf(result[0, column_start + 4:column_end]).all()
+    assert not torch.isneginf(result[1, column_start + 4:column_start + 7]).any()
+    assert torch.isneginf(result[1, column_start + 7:column_end]).all()
