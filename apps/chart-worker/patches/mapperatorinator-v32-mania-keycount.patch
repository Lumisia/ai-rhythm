+class ManiaKeycountLogitsProcessor(LogitsProcessor):
+    """Prevent mania column tokens outside the requested keycount."""
+
+    def __init__(self, tokenizer: Tokenizer):
+        self.keycount_start = tokenizer.event_start[EventType.MANIA_KEYCOUNT]
+        self.keycount_end = tokenizer.event_end[EventType.MANIA_KEYCOUNT]
+        self.keycount_min = tokenizer.event_range[EventType.MANIA_KEYCOUNT].min_value
+        self.column_start = tokenizer.event_start[EventType.MANIA_COLUMN]
+        self.column_end = tokenizer.event_end[EventType.MANIA_COLUMN]
+
+    def __call__(
+            self,
+            input_ids: torch.LongTensor,
+            scores: torch.FloatTensor,
+    ) -> torch.FloatTensor:
+        scores_processed = scores.clone()
+        for row in range(input_ids.shape[0]):
+            tokens = input_ids[row]
+            keycount_tokens = tokens[
+                (tokens >= self.keycount_start) & (tokens < self.keycount_end)
+            ]
+            if keycount_tokens.numel() == 0:
+                continue
+            keycount = (
+                int(keycount_tokens[-1].item())
+                - self.keycount_start
+                + self.keycount_min
+            )
+            invalid_start = min(self.column_start + keycount, self.column_end)
+            scores_processed[row, invalid_start:self.column_end] = -torch.inf
+        return scores_processed
+
+
 class TimeshiftBias(LogitsProcessor):
     def __init__(self, timeshift_bias: float, time_start: int, time_end: int):
         self.timeshift_bias = timeshift_bias
