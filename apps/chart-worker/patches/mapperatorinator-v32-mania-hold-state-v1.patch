+def _apply_mania_hold_transition(
+        open_columns: set[int],
+        lane: int,
+        event_type: EventType,
+) -> None:
+    """Apply one serializable mania lane transition or fail explicitly."""
+    if event_type == EventType.CIRCLE:
+        if lane in open_columns:
+            raise ValueError(f"TAP while HOLD is active in lane {lane}")
+        return
+    if event_type == EventType.HOLD_NOTE:
+        if lane in open_columns:
+            raise ValueError(f"overlapping HOLD_START in lane {lane}")
+        open_columns.add(lane)
+        return
+    if event_type == EventType.HOLD_NOTE_END:
+        if lane not in open_columns:
+            raise ValueError(f"HOLD_END without HOLD_START in lane {lane}")
+        open_columns.remove(lane)
+
+
+def mania_open_hold_columns_before(
+        events: list[Event],
+        event_times: list[float],
+        boundary_time: float,
+        keycount: int,
+) -> tuple[int, ...]:
+    """Return lanes with a HOLD open immediately before ``boundary_time``.
+
+    Exact event signatures can be repeated by overlapping generation windows;
+    they are state-idempotent here. Canonical origin validation remains the
+    authority for deciding whether such duplicates may be published.
+    """
+    if len(events) != len(event_times):
+        raise ValueError("events and event_times must have equal length")
+
+    note_types = {
+        EventType.CIRCLE,
+        EventType.HOLD_NOTE,
+        EventType.HOLD_NOTE_END,
+    }
+    current_lane: int | None = None
+    groups: set[tuple[int, int, EventType]] = set()
+    for event, event_time in zip(events, event_times):
+        if event.type == EventType.TIME_SHIFT:
+            current_lane = None
+        elif event.type == EventType.MANIA_COLUMN:
+            current_lane = int(event.value)
+        elif event.type in note_types:
+            if current_lane is None:
+                raise ValueError(
+                    f"mania note has no gameplay column: type={event.type.name}, "
+                    f"time={event_time}"
+                )
+            if event_time < boundary_time:
+                groups.add((int(round(event_time)), current_lane, event.type))
+            current_lane = None
+
+    open_columns: set[int] = set()
+    order = {
+        EventType.HOLD_NOTE_END: 0,
+        EventType.HOLD_NOTE: 1,
+        EventType.CIRCLE: 2,
+    }
+    for time_ms, lane, event_type in sorted(
+            groups,
+            key=lambda group: (group[0], group[1], order[group[2]]),
+    ):
+        if not 0 <= lane < keycount:
+            raise ValueError(
+                f"mania lane {lane} is outside keycount {keycount} at {time_ms}"
+            )
+        _apply_mania_hold_transition(open_columns, lane, event_type)
+    return tuple(sorted(open_columns))
+
+
+class ManiaHoldStateLogitsProcessor(LogitsProcessor):
+    """Mask only lane transitions that cannot form a playable HOLD stream."""
+
+    def __init__(
+            self,
+            tokenizer: Tokenizer,
+            initial_open_columns: tuple[int, ...] | None,
+    ):
+        self.initial_open_columns = (
+            None
+            if initial_open_columns is None
+            else frozenset(int(lane) for lane in initial_open_columns)
+        )
+        self.sos_id = tokenizer.sos_id
+        self.keycount_start = tokenizer.event_start[EventType.MANIA_KEYCOUNT]
+        self.keycount_end = tokenizer.event_end[EventType.MANIA_KEYCOUNT]
+        self.keycount_min = tokenizer.event_range[EventType.MANIA_KEYCOUNT].min_value
+        self.column_start = tokenizer.event_start[EventType.MANIA_COLUMN]
+        self.column_end = tokenizer.event_end[EventType.MANIA_COLUMN]
+        self.time_start = tokenizer.event_start[EventType.TIME_SHIFT]
+        self.time_end = tokenizer.event_end[EventType.TIME_SHIFT]
+        self.tap_token = tokenizer.event_start[EventType.CIRCLE]
+        self.hold_start_token = tokenizer.event_start[EventType.HOLD_NOTE]
+        self.hold_end_token = tokenizer.event_start[EventType.HOLD_NOTE_END]
+        self.event_type_by_token = {
+            self.tap_token: EventType.CIRCLE,
+            self.hold_start_token: EventType.HOLD_NOTE,
+            self.hold_end_token: EventType.HOLD_NOTE_END,
+        }
+
+    def __call__(
+            self,
+            input_ids: torch.LongTensor,
+            scores: torch.FloatTensor,
+    ) -> torch.FloatTensor:
+        if self.initial_open_columns is None:
+            return scores
+
+        scores_processed = scores.clone()
+        for row in range(input_ids.shape[0]):
+            tokens = input_ids[row]
+            keycount_tokens = tokens[
+                (tokens >= self.keycount_start) & (tokens < self.keycount_end)
+            ]
+            sos_indices = torch.nonzero(tokens == self.sos_id, as_tuple=False).flatten()
+            if keycount_tokens.numel() == 0 or sos_indices.numel() == 0:
+                continue
+            keycount = (
+                int(keycount_tokens[-1].item())
+                - self.keycount_start
+                + self.keycount_min
+            )
+            open_columns = set(self.initial_open_columns)
+            if any(not 0 <= lane < keycount for lane in open_columns):
+                raise ValueError(
+                    f"initial open HOLD lane is outside keycount {keycount}: "
+                    f"{sorted(open_columns)}"
+                )
+
+            current_lane: int | None = None
+            current_time_token: int | None = None
+            seen_groups: set[tuple[int | None, int, EventType]] = set()
+            start = int(sos_indices[-1].item()) + 1
+            for token_tensor in tokens[start:]:
+                token = int(token_tensor.item())
+                if self.time_start <= token < self.time_end:
+                    current_time_token = token
+                    current_lane = None
+                elif self.column_start <= token < self.column_end:
+                    current_lane = token - self.column_start
+                elif token in self.event_type_by_token:
+                    if current_lane is None:
+                        raise ValueError(
+                            "mania note type in prompt has no gameplay column"
+                        )
+                    event_type = self.event_type_by_token[token]
+                    signature = (current_time_token, current_lane, event_type)
+                    if signature not in seen_groups:
+                        _apply_mania_hold_transition(
+                            open_columns,
+                            current_lane,
+                            event_type,
+                        )
+                        seen_groups.add(signature)
+                    current_lane = None
+
+            if current_lane is None:
+                scores_processed[row, self.tap_token] = -torch.inf
+                scores_processed[row, self.hold_start_token] = -torch.inf
+                scores_processed[row, self.hold_end_token] = -torch.inf
+                continue
+            if not 0 <= current_lane < keycount:
+                raise ValueError(
+                    f"current mania lane {current_lane} is outside keycount {keycount}"
+                )
+            if current_lane in open_columns:
+                scores_processed[row, self.tap_token] = -torch.inf
+                scores_processed[row, self.hold_start_token] = -torch.inf
+            else:
+                scores_processed[row, self.hold_end_token] = -torch.inf
+        return scores_processed
+
