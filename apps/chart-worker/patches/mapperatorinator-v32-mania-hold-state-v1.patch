+
+
+class FakeTokenizer:
+    sos_id = 1
+    context_sos = {}
+    event_start = {
+        EventType.MANIA_COLUMN: 10,
+        EventType.TIME_SHIFT: 30,
+        EventType.CIRCLE: 50,
+        EventType.HOLD_NOTE: 51,
+        EventType.HOLD_NOTE_END: 52,
+        EventType.MANIA_KEYCOUNT: 100,
+    }
+    event_end = {
+        EventType.MANIA_COLUMN: 28,
+        EventType.TIME_SHIFT: 40,
+        EventType.MANIA_KEYCOUNT: 118,
+    }
+    event_range = {
+        EventType.MANIA_KEYCOUNT: SimpleNamespace(min_value=1),
+    }
+
+
+def keycount_token(keycount: int) -> int:
+    return FakeTokenizer.event_start[EventType.MANIA_KEYCOUNT] + keycount - 1
+
+
+def scores() -> torch.Tensor:
+    return torch.zeros((1, 128), dtype=torch.float32)
+
+
+def test_closed_lane_masks_orphan_hold_end_only():
+    processor = ManiaHoldStateLogitsProcessor(FakeTokenizer(), ())
+    input_ids = torch.tensor([[keycount_token(4), 1, 30, 12]])
+
+    result = processor(input_ids, scores())
+
+    assert not torch.isneginf(result[0, 50])
+    assert not torch.isneginf(result[0, 51])
+    assert torch.isneginf(result[0, 52])
+
+
+def test_open_lane_masks_tap_and_overlapping_hold_start_only():
+    processor = ManiaHoldStateLogitsProcessor(FakeTokenizer(), (2,))
+    input_ids = torch.tensor([[keycount_token(4), 1, 30, 12]])
+
+    result = processor(input_ids, scores())
+
+    assert torch.isneginf(result[0, 50])
+    assert torch.isneginf(result[0, 51])
+    assert not torch.isneginf(result[0, 52])
+
+
+def test_state_processor_also_masks_note_types_until_group_has_column():
+    processor = ManiaHoldStateLogitsProcessor(FakeTokenizer(), ())
+    input_ids = torch.tensor([[keycount_token(4), 1, 30]])
+
+    result = processor(input_ids, scores())
+
+    assert torch.isneginf(result[0, 50:53]).all()
+
