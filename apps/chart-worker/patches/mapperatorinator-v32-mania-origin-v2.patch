+    def _build_mania_objects(
+            self,
+            groups: list[Group],
+            group_indices: list[list[int]],
+            event_origins: list[EventOrigin] | None,
+            key_count: int,
+    ) -> tuple[list[ManiaObject], set[int], list[dict]]:
+        """Build one validated gameplay object stream before serialization.
+
+        Only byte-for-byte-equivalent note groups from disjoint generated
+        windows are idempotent. All other overlapping or orphan HOLD events are
+        malformed candidates and must be rejected instead of silently dropped.
+        """
+        note_types = {
+            EventType.CIRCLE,
+            EventType.HOLD_NOTE,
+            EventType.HOLD_NOTE_END,
+        }
+        group_origins: list[tuple[EventOrigin, ...]] = []
+        for indices in group_indices:
+            if event_origins is None:
+                group_origins.append(())
+                continue
+            unique = []
+            for index in indices:
+                origin = event_origins[index]
+                if origin not in unique:
+                    unique.append(origin)
+            group_origins.append(tuple(unique))
+
+        def describe_group(group_id: int) -> dict:
+            group = groups[group_id]
+            return {
+                "groupId": group_id,
+                "type": group.event_type.name,
+                "timeMs": int(round(group.time)),
+                "origins": [
+                    origin.to_dict() for origin in group_origins[group_id]
+                ],
+            }
+
+        duplicate_group_ids: set[int] = set()
+        duplicates: list[dict] = []
+        first_by_signature: dict[tuple, int] = {}
+        for group_id, group in enumerate(groups):
+            if group.event_type not in note_types:
+                continue
+            if group.x is None:
+                origins = group_origins[group_id]
+                origin_summary = [
+                    {
+                        "kind": origin.kind,
+                        "sourceWindowId": origin.source_window_id,
+                        "sourceTokenIndex": origin.source_token_index,
+                        "referenceEventIndex": origin.reference_event_index,
+                    }
+                    for origin in origins
+                ]
+                raise ValueError(
+                    f"mania note group {group_id} has no gameplay column: "
+                    f"type={group.event_type.name}, time={group.time}, "
+                    f"origins={origin_summary}"
+                )
+            lane = self._mania_lane(group.x, key_count)
+            signature = (group.event_type, lane, group.time)
+            previous_id = first_by_signature.get(signature)
+            if previous_id is None:
+                first_by_signature[signature] = group_id
+                continue
+            previous_windows = {
+                origin.source_window_id
+                for origin in group_origins[previous_id]
+                if origin.kind == "GENERATED"
+                and origin.source_window_id is not None
+            }
+            current_windows = {
+                origin.source_window_id
+                for origin in group_origins[group_id]
+                if origin.kind == "GENERATED"
+                and origin.source_window_id is not None
+            }
+            if (
+                    previous_windows
+                    and current_windows
+                    and previous_windows.isdisjoint(current_windows)
+            ):
+                duplicate_group_ids.add(group_id)
+                duplicates.append({
+                    "keptGroupId": previous_id,
+                    "droppedGroupId": group_id,
+                    "reason": "EXACT_CROSS_WINDOW_DUPLICATE",
+                })
+                continue
+            raise ValueError(
+                f"exact duplicate mania group is not cross-window idempotent: "
+                f"groups {previous_id} and {group_id}, "
+                f"type={group.event_type.name}, lane={lane}, time={group.time}"
+            )
+
+        objects: list[ManiaObject] = []
+        active_by_lane: dict[int, int] = {}
+        ordered_group_ids = sorted(
+            range(len(groups)),
+            key=lambda group_id: (
+                groups[group_id].time,
+                (
+                    self._mania_lane(groups[group_id].x, key_count)
+                    if groups[group_id].x is not None
+                    else -1
+                ),
+                {
+                    EventType.HOLD_NOTE_END: 0,
+                    EventType.HOLD_NOTE: 1,
+                    EventType.CIRCLE: 2,
+                }.get(groups[group_id].event_type, 3),
+                group_id,
+            ),
+        )
+        for group_id in ordered_group_ids:
+            group = groups[group_id]
