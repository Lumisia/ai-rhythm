@@ -66,6 +66,68 @@ class ManiaKeycountLogitsProcessor(LogitsProcessor):
         return scores_processed
 
 
+class ManiaColumnBeforeTypeLogitsProcessor(LogitsProcessor):
+    """Enforce the v32 ``time -> column -> note type`` training grammar.
+
+    This deliberately does not infer HOLD state.  A gameplay type without a
+    column is never serializable, whereas an apparent orphan HOLD may depend on
+    cross-window context and belongs in canonical-IR diagnostics.
+    """
+
+    def __init__(self, tokenizer: Tokenizer):
+        self.keycount_start = tokenizer.event_start[EventType.MANIA_KEYCOUNT]
+        self.keycount_end = tokenizer.event_end[EventType.MANIA_KEYCOUNT]
+        self.column_start = tokenizer.event_start[EventType.MANIA_COLUMN]
+        self.column_end = tokenizer.event_end[EventType.MANIA_COLUMN]
+        self.time_start = tokenizer.event_start[EventType.TIME_SHIFT]
+        self.time_end = tokenizer.event_end[EventType.TIME_SHIFT]
+        self.note_type_tokens = torch.tensor([
+            tokenizer.event_start[EventType.CIRCLE],
+            tokenizer.event_start[EventType.HOLD_NOTE],
+            tokenizer.event_start[EventType.HOLD_NOTE_END],
+        ])
+        self.sos_ids = torch.tensor(
+            [tokenizer.sos_id]
+            + list(getattr(tokenizer, "context_sos", {}).values())
+        )
+
+    @staticmethod
+    def _last_index(mask: torch.Tensor) -> int:
+        indices = torch.nonzero(mask, as_tuple=False).flatten()
+        return int(indices[-1].item()) if indices.numel() else -1
+
+    def __call__(
+            self,
+            input_ids: torch.LongTensor,
+            scores: torch.FloatTensor,
+    ) -> torch.FloatTensor:
+        scores_processed = scores.clone()
+        note_types = self.note_type_tokens.to(input_ids.device)
+        sos_ids = self.sos_ids.to(input_ids.device)
+        for row in range(input_ids.shape[0]):
+            tokens = input_ids[row]
+            has_keycount = bool(
+                ((tokens >= self.keycount_start) & (tokens < self.keycount_end))
+                .any()
+                .item()
+            )
+            if not has_keycount:
+                continue
+            last_column = self._last_index(
+                (tokens >= self.column_start) & (tokens < self.column_end)
+            )
+            last_boundary = max(
+                self._last_index(
+                    (tokens >= self.time_start) & (tokens < self.time_end)
+                ),
+                self._last_index(torch.isin(tokens, note_types)),
+                self._last_index(torch.isin(tokens, sos_ids)),
+            )
+            if last_column <= last_boundary:
+                scores_processed[row, note_types] = -torch.inf
+        return scores_processed
+
