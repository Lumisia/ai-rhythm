diff --git a/tests/test_mania_event_origins.py b/tests/test_mania_event_origins.py
new file mode 100644
index 0000000..d235ed0
--- /dev/null
+++ b/tests/test_mania_event_origins.py
@@ -0,0 +1,211 @@
+from types import SimpleNamespace
+
+import torch
+
+from osuT5.osuT5.event import Event, EventType
+from osuT5.osuT5.inference.origin import EventOrigin, merge_origin_streams
+from osuT5.osuT5.inference.processor import GenerationConfig, Processor
+from osuT5.osuT5.tokenizer import ContextType
+
+
+def make_processor() -> Processor:
+    processor = Processor.__new__(Processor)
+    processor.tokenizer = SimpleNamespace(eos_id=999, context_eos={})
+    processor.types_first = False
+    processor.eos_time = 1_000
+    processor.lookahead_time_range = set()
+    processor.lookback_time_range = set()
+    processor.lookahead_max_time = 1_000
+    processor.parser = SimpleNamespace()
+    processor._decode_indexed = lambda _tokens, _frame_time: (
+        [Event(EventType.TIME_SHIFT, 100), Event(EventType.CIRCLE, 0)],
+        [0, 1],
+    )
+    return processor
+
+
+def test_generated_event_origins_survive_decode_and_time_update():
+    processor = make_processor()
+    context = {
+        "context_type": "MAP",
+        "events": [],
+        "event_times": [],
+        "event_origins": [],
+    }
+
+    processor.add_predicted_tokens_to_context(
+        context,
+        torch.tensor([10, 11]),
+        0,
+        source_window_id=7,
+    )
+
+    assert len(context["events"]) == len(context["event_times"]) == 2
+    assert context["event_origins"] == [
+        EventOrigin.generated(7, 0),
+        EventOrigin.generated(7, 1),
+    ]
+
+
+def test_trim_deletes_event_time_and_origin_atomically():
+    processor = make_processor()
+    events = [Event(EventType.CIRCLE, 0), Event(EventType.CIRCLE, 0)]
+    times = [100, 200]
+    origins = [EventOrigin.generated(1, 0), EventOrigin.generated(2, 0)]
+
+    processor._trim_events_before_time(events, times, 150, origins)
+
+    assert len(events) == len(times) == len(origins) == 1
+    assert times == [200]
+    assert origins == [EventOrigin.generated(2, 0)]
+
+
+def test_column_conversion_duplicates_the_parent_origin():
+    processor = make_processor()
+    events = [Event(EventType.MANIA_COLUMN, 0), Event(EventType.CIRCLE, 0)]
+    times = [100, 100]
+    origin = EventOrigin.generated(3, 4)
+
+    converted_events, converted_times, converted_origins = (
+        processor._convert_column_to_position(events, times, 4, [origin, origin])
+    )
+
+    assert [event.type for event in converted_events] == [
+        EventType.POS_X,
+        EventType.POS_Y,
+        EventType.CIRCLE,
+    ]
+    assert converted_times == [100, 100, 100]
+    assert converted_origins == [origin, origin, origin]
+
