+                continue
+            lane = self._mania_lane(group.x, key_count)
+            if group.event_type == EventType.CIRCLE:
+                objects.append(ManiaObject(
+                    object_id=-1,
+                    lane=lane,
+                    kind="TAP",
+                    start_time_ms=int(round(group.time)),
+                    end_time_ms=None,
+                    start_group_id=group_id,
+                    end_group_id=None,
+                    x=int(round(group.x)),
+                    start_origins=group_origins[group_id],
