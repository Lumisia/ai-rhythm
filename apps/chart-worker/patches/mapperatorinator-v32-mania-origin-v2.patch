+            elif group.event_type == EventType.HOLD_NOTE:
+                if lane in active_by_lane:
+                    previous_id = active_by_lane[lane]
+                    raise ValueError(
+                        f"overlapping HOLD_START in lane {lane}: "
+                        f"previous={describe_group(previous_id)}, "
+                        f"current={describe_group(group_id)}"
