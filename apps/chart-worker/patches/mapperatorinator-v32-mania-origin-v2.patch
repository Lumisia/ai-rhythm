new file mode 100644
index 0000000..6a3ba3f
--- /dev/null
+++ b/osuT5/osuT5/inference/origin.py
@@ -0,0 +1,69 @@
+"""Inference-only event provenance kept parallel to training Event objects."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Literal
+
+from ..event import Event
+
+OriginKind = Literal["GENERATED", "REFERENCE"]
+
+
+@dataclass(frozen=True, slots=True)
+class EventOrigin:
+    kind: OriginKind
+    source_window_id: int | None
+    source_token_index: int | None
+    reference_event_index: int | None = None
+
+    @classmethod
+    def generated(cls, window_id: int, token_index: int) -> "EventOrigin":
+        return cls("GENERATED", window_id, token_index)
+
+    @classmethod
+    def reference(cls, event_index: int) -> "EventOrigin":
+        return cls("REFERENCE", None, None, event_index)
+
+    def to_dict(self) -> dict[str, int | str | None]:
+        return {
+            "kind": self.kind,
+            "sourceWindowId": self.source_window_id,
+            "sourceTokenIndex": self.source_token_index,
+            "referenceEventIndex": self.reference_event_index,
+        }
+
+
+OriginStream = tuple[list[Event], list[int], list[EventOrigin]]
+
+
+def validate_origin_stream(stream: OriginStream) -> None:
+    events, event_times, origins = stream
+    if len(events) != len(event_times) or len(events) != len(origins):
+        raise ValueError("events, event_times, and event_origins must have equal length")
+
+
+def merge_origin_streams(left: OriginStream, right: OriginStream) -> OriginStream:
+    """Stable time merge that moves event, time, and origin atomically."""
+    validate_origin_stream(left)
+    validate_origin_stream(right)
+    merged_events: list[Event] = []
+    merged_times: list[int] = []
+    merged_origins: list[EventOrigin] = []
+    i = j = 0
+    while i < len(left[0]) and j < len(right[0]):
+        source, index = (left, i) if left[1][i] <= right[1][j] else (right, j)
+        merged_events.append(source[0][index])
+        merged_times.append(source[1][index])
+        merged_origins.append(source[2][index])
+        if source is left:
+            i += 1
+        else:
+            j += 1
+    for source, start in ((left, i), (right, j)):
+        merged_events.extend(source[0][start:])
+        merged_times.extend(source[1][start:])
+        merged_origins.extend(source[2][start:])
+    result = (merged_events, merged_times, merged_origins)
+    validate_origin_stream(result)
+    return result
