diff --git a/tests/test_mania_event_times.py b/tests/test_mania_event_times.py
new file mode 100644
--- /dev/null
+++ b/tests/test_mania_event_times.py
@@ -0,0 +1,82 @@
+from datetime import timedelta
+from types import SimpleNamespace
+
+from slider import TimingPoint
+
+from osuT5.osuT5.event import Event, EventType
+from osuT5.osuT5.inference.postprocessor import BeatmapConfig, Postprocessor
+
+
+def make_postprocessor() -> Postprocessor:
+    args = SimpleNamespace(
+        offset=0,
+        bpm=120,
+        timing_leniency=0,
+        train=SimpleNamespace(data=SimpleNamespace(
+            types_first=False,
+            add_positions=True,
+            mania_bpm_normalized_scroll_speed=False,
+            add_sv=False,
+        )),
+        start_time=None,
+        end_time=3_000,
+        snap_near_perfect_overlaps=False,
+    )
+    return Postprocessor(args)
+
+
+def make_timing() -> list[TimingPoint]:
+    return [TimingPoint(
+        timedelta(milliseconds=0),
+        500,
+        4,
+        2,
+        -1,
+        100,
+        None,
+        False,
+    )]
+
+
+def test_explicit_event_times_preserve_a_same_timestamp_second_group():
+    events = [
+        Event(EventType.TIME_SHIFT, 1_000),
+        Event(EventType.POS_X, 64),
+        Event(EventType.POS_Y, 192),
+        Event(EventType.CIRCLE, 0),
+        Event(EventType.POS_X, 192),
+        Event(EventType.POS_Y, 192),
+        Event(EventType.HOLD_NOTE, 0),
+        Event(EventType.TIME_SHIFT, 2_000),
+        Event(EventType.POS_X, 192),
+        Event(EventType.POS_Y, 192),
+        Event(EventType.HOLD_NOTE_END, 0),
+    ]
+
+    result = make_postprocessor().generate(
+        events,
+        BeatmapConfig(mode=3, circle_size=4),
+        event_times=[1_000] * 7 + [2_000] * 4,
+    )
+
+    assert "192,192,1000,128,0,2000:0:0:-1:0:" in result
+    assert "192,192,0,128" not in result
+
+
+def test_resnap_updates_event_tokens_and_explicit_times_together():
+    events = [
+        Event(EventType.TIME_SHIFT, 110),
+        Event(EventType.SNAPPING, 4),
+        Event(EventType.POS_X, 64),
+        Event(EventType.POS_Y, 192),
+        Event(EventType.CIRCLE, 0),
+    ]
+
+    snapped_events, snapped_times = make_postprocessor().resnap_events(
+        events,
+        [110, 110, 110, 110, 110],
+        make_timing(),
+    )
+
+    assert snapped_events[0].value == 125
+    assert snapped_times == [125, 125, 125, 125, 125]
