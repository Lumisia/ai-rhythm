+from __future__ import annotations
+
+import random
+
+import numpy as np
+import pytest
+import torch
+from osuT5.osuT5.event import Event, EventType
+from osuT5.osuT5.inference.generation_checkpoint import (
+    CheckpointIdentityMismatch,
+    CheckpointIntegrityError,
+    CheckpointPrefixMismatch,
+    GenerationCheckpointStore,
+    RngSnapshot,
+    UnknownCheckpointError,
+    capture_rng_state,
+    derive_repair_seed,
+    reseed_for_domain_repair,
+    restore_rng_state,
+)
+from osuT5.osuT5.inference.origin import EventOrigin
+
+IDENTITY = "input-config-model-patch:v1:abc123"
+
+
+def _stream(*values: int):
+    events = [Event(EventType.TIME_SHIFT, value) for value in values]
+    times = list(values)
+    origins = [EventOrigin.generated(index, 0) for index in range(len(values))]
+    return events, times, origins
+
+
+def _restore(store: GenerationCheckpointStore, index: int):
+    return store.restore(
+        index,
+        identity_digest=IDENTITY,
+        expected_prefix_digest=store.prefix_digest(index),
+    )
+
+
+def _assert_rng_snapshots_equal(left: RngSnapshot, right: RngSnapshot) -> None:
+    assert left.python_state == right.python_state
+    assert left.numpy_state[0] == right.numpy_state[0]
+    np.testing.assert_array_equal(left.numpy_state[1], right.numpy_state[1])
+    assert left.numpy_state[2:] == right.numpy_state[2:]
+    assert torch.equal(left.torch_cpu_state, right.torch_cpu_state)
+    assert len(left.cuda_rng_states) == len(right.cuda_rng_states)
+    for left_state, right_state in zip(
+            left.cuda_rng_states,
+            right.cuda_rng_states,
+            strict=True,
+    ):
+        assert torch.equal(left_state, right_state)
+
+
+def test_checkpoint_zero_is_immediately_restorable_and_has_no_aliases():
+    events, times, origins = _stream(10)
+    metadata = {"stats": {"tokens": 0}, "labels": ["initial"]}
+    store = GenerationCheckpointStore(
+        identity_digest=IDENTITY,
+        events=events,
+        event_times=times,
+        event_origins=origins,
+        metadata=metadata,
+    )
+
+    events[0].value = 999
+    times[0] = 999
+    metadata["stats"]["tokens"] = 999
+    restored = _restore(store, 0)
+
+    assert restored.next_window_index == 0
+    assert restored.events == [Event(EventType.TIME_SHIFT, 10)]
+    assert restored.event_times == [10]
+    assert restored.event_origins == [EventOrigin.generated(0, 0)]
+    assert restored.metadata == {"stats": {"tokens": 0}, "labels": ["initial"]}
+    assert restored.events[0] is not events[0]
+
+    restored.events[0].value = 123
+    restored.metadata["labels"].append("mutated")
+    restored_again = _restore(store, 0)
+    assert restored_again.events[0].value == 10
+    assert restored_again.metadata["labels"] == ["initial"]
+    assert restored_again.events[0] is not restored.events[0]
+
+
+def test_append_uses_deltas_and_restores_exact_requested_prefix():
+    initial = _stream(10)
+    store = GenerationCheckpointStore(
+        identity_digest=IDENTITY,
+        events=initial[0],
+        event_times=initial[1],
+        event_origins=initial[2],
+        metadata={"window": -1},
+    )
+
+    for next_window_index, values in ((1, (10, 20)), (2, (10, 20, 30)), (3, (10, 20, 30, 40))):
+        events, times, origins = _stream(*values)
+        store.append_checkpoint(
+            next_window_index=next_window_index,
+            events=events,
+            event_times=times,
+            event_origins=origins,
+            metadata={"window": next_window_index - 1},
+        )
+        events[-1].value = 999
+
+    restored = _restore(store, 2)
+    assert [event.value for event in restored.events] == [10, 20, 30]
+    assert restored.event_times == [10, 20, 30]
+    assert restored.metadata == {"window": 1}
+
+    stats = store.storage_stats()
+    assert stats.checkpoint_count == 4
+    assert stats.delta_count == 3
+    assert stats.base_event_count == 1
+    assert stats.delta_event_count == 3
+    assert stats.stored_event_count == 4
+    assert stats.logical_event_count == 4
+    assert stats.delta_event_counts == (1, 1, 1)
+
+
+def test_fork_at_absolute_window_is_independent_and_accepts_next_absolute_index():
+    initial = _stream(10)
+    store = GenerationCheckpointStore(
+        identity_digest=IDENTITY,
+        events=initial[0],
+        event_times=initial[1],
+        event_origins=initial[2],
+        metadata={"window": -1},
+    )
+    for index, values in ((1, (10, 20)), (2, (10, 20, 30))):
+        stream = _stream(*values)
+        store.append_checkpoint(
+            next_window_index=index,
+            events=stream[0],
+            event_times=stream[1],
+            event_origins=stream[2],
+            metadata={"window": index - 1},
+        )
+
+    fork = store.fork_from(
+        2,
+        identity_digest=IDENTITY,
+        expected_prefix_digest=store.prefix_digest(2),
+    )
+    assert fork.latest_next_window_index == 2
+    assert [event.value for event in _restore(fork, 2).events] == [10, 20, 30]
+    fork_stats = fork.storage_stats()
+    assert fork_stats.checkpoint_count == 1
+    assert fork_stats.delta_count == 0
+    assert fork_stats.base_event_count == 3
+    assert fork_stats.stored_event_count == 3
+
+    original_three = _stream(10, 20, 30, 40)
+    store.append_checkpoint(
+        next_window_index=3,
+        events=original_three[0],
+        event_times=original_three[1],
+        event_origins=original_three[2],
+        metadata={"branch": "original"},
+    )
+    branch_events = [
+        Event(EventType.TIME_SHIFT, value) for value in (10, 20, 30, 99)
+    ]
+    branch_times = [10, 20, 30, 99]
+    branch_origins = [
+        EventOrigin.generated(index, 0) for index in range(4)
+    ]
+    fork.append_checkpoint(
+        next_window_index=3,
+        events=branch_events,
+        event_times=branch_times,
+        event_origins=branch_origins,
+        metadata={"branch": "repair"},
+    )
+
+    assert [event.value for event in _restore(store, 3).events] == [10, 20, 30, 40]
+    assert _restore(store, 3).metadata == {"branch": "original"}
+    assert [event.value for event in _restore(fork, 2).events] == [10, 20, 30]
+    assert [event.value for event in _restore(fork, 3).events] == [10, 20, 30, 99]
+    assert _restore(fork, 3).metadata == {"branch": "repair"}
+
+
+def test_fork_validates_identity_and_expected_prefix_digest():
+    initial = _stream(10)
+    store = GenerationCheckpointStore(
+        identity_digest=IDENTITY,
+        events=initial[0],
+        event_times=initial[1],
+        event_origins=initial[2],
+    )
+    digest = store.prefix_digest(0)
+    with pytest.raises(CheckpointIdentityMismatch):
+        store.fork_from(
+            0,
+            identity_digest="different",
+            expected_prefix_digest=digest,
+        )
+    with pytest.raises(CheckpointIntegrityError):
+        store.fork_from(
