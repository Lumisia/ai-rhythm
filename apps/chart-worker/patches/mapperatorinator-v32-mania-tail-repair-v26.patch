+        EventType.MANIA_COLUMN: 10,
+        EventType.TIME_SHIFT: 30,
+        EventType.CIRCLE: 50,
+        EventType.HOLD_NOTE: 51,
+        EventType.HOLD_NOTE_END: 52,
+        EventType.MANIA_KEYCOUNT: 100,
+    }
+    event_end = {
+        EventType.MANIA_COLUMN: 28,
+        EventType.TIME_SHIFT: 40,
+        EventType.MANIA_KEYCOUNT: 118,
+    }
+    event_range = {
+        EventType.MANIA_KEYCOUNT: SimpleNamespace(min_value=1),
+    }
+
+
+def _keycount_token(keycount: int) -> int:
+    return _Tokenizer.event_start[EventType.MANIA_KEYCOUNT] + keycount - 1
+
+
+def _scores(*, rows: int = 1, all_masked: bool = False) -> torch.Tensor:
+    fill = -torch.inf if all_masked else 0.0
+    return torch.full((rows, 128), fill, dtype=torch.float32)
+
+
+def test_insufficient_hold_closure_budget_has_typed_evidence():
+    processor = ManiaHoldStateLogitsProcessor(
+        _Tokenizer(),
+        (1, 3),
+        require_closed_holds_at_eos=True,
+        max_sequence_length=6,
+    )
+
+    with pytest.raises(ManiaDomainError) as caught:
+        processor(
+            torch.tensor([[_keycount_token(4), 1, 30]]),
+            _scores(),
+        )
+
+    error = caught.value
+    assert str(error) == (
+        "insufficient sequence budget to close open mania HOLD lanes: "
+        "remaining=3, required=4, lanes=[1, 3]"
+    )
+    assert error.reason == "INSUFFICIENT_HOLD_CLOSURE_BUDGET"
+    assert error.lane is None
+    assert error.time_ms is None
+    assert error.time_token_id == 30
+    assert error.event_index is None
+    assert error.decoder_token_index == 3
+    assert error.generated_token_index == 0
+    assert error.row_index == 0
+    assert error.source_window_id is None
+    assert error.context == {
+        "remainingTokens": 3,
+        "requiredTokens": 4,
+        "openLanes": (1, 3),
+    }
+
+    enriched = error.with_source_window(7)
+    assert enriched.source_window_id == 7
+    assert enriched.to_dict() | {"sourceWindowId": None} == error.to_dict()
+
+
+def test_exhausted_pending_group_budget_maps_to_no_legal_completion():
+    processor = ManiaHoldStateLogitsProcessor(
+        _Tokenizer(), (), max_sequence_length=4
+    )
+
+    with pytest.raises(ManiaDomainError) as caught:
+        processor(
+            torch.tensor([[_keycount_token(4), 1, 30, 12]]),
+            _scores(),
+        )
+
+    error = caught.value
+    assert str(error) == (
+        "insufficient sequence budget to complete pending mania group: "
+        "remaining=0, lane=2"
+    )
+    assert error.reason == "NO_LEGAL_MANIA_GROUP_COMPLETION"
+    assert error.lane == 2
+    assert error.time_ms is None
+    assert error.time_token_id == 30
+    assert error.event_index is None
+    assert error.decoder_token_index == 4
+    assert error.generated_token_index == 0
+    assert error.row_index == 0
+    assert error.context == {
+        "subtype": "PENDING_GROUP_BUDGET_EXHAUSTED",
+        "remainingTokens": 0,
+        "requiredTokens": 1,
+    }
+
+
+def test_masked_pending_group_note_types_have_typed_failure():
+    processor = ManiaHoldStateLogitsProcessor(
+        _Tokenizer(), (), max_sequence_length=5
+    )
+
+    with pytest.raises(ManiaDomainError) as caught:
+        processor(
+            torch.tensor([[_keycount_token(4), 1, 30, 12]]),
+            _scores(all_masked=True),
+        )
+
+    error = caught.value
+    assert str(error) == (
+        "no legal note type can complete pending mania group: lane=2"
+    )
+    assert error.reason == "NO_LEGAL_MANIA_GROUP_COMPLETION"
+    assert error.lane == 2
+    assert error.time_ms is None
+    assert error.time_token_id == 30
+    assert error.event_index is None
+    assert error.decoder_token_index == 4
+    assert error.generated_token_index == 0
+    assert error.row_index == 0
+    assert error.context == {
+        "subtype": "NO_LEGAL_NOTE_TYPE",
+        "remainingTokens": 1,
+    }
+
+
+def test_second_batch_row_is_preserved_in_typed_budget_evidence():
+    processor = ManiaHoldStateLogitsProcessor(
+        _Tokenizer(),
+        (1, 3),
+        require_closed_holds_at_eos=True,
+        max_sequence_length=6,
+    )
+    rows = torch.tensor(
+        [
+            [0, 0, 0],
+            [_keycount_token(4), 1, 30],
+        ]
+    )
+
+    with pytest.raises(ManiaDomainError) as caught:
+        processor(rows, _scores(rows=2))
+
+    error = caught.value
+    assert error.row_index == 1
+    assert error.decoder_token_index == 3
+    assert error.generated_token_index == 0
+    assert error.time_token_id == 30
+
+
+@pytest.mark.parametrize(
+    ("candidate_reason", "candidate_row"),
+    [
+        ("INSUFFICIENT_HOLD_CLOSURE_BUDGET", 0),
+        ("NO_LEGAL_MANIA_GROUP_COMPLETION", 1),
+    ],
+)
+def test_incremental_verify_rejects_same_exception_class_with_different_evidence(
+        monkeypatch,
+        candidate_reason,
+        candidate_row,
+):
+    processor = ManiaHoldStateLogitsProcessor(
+        _Tokenizer(), (), hold_state_mode="incremental_verify"
+    )
+    processor.prompt_length = 3
+    processor._incremental_state = SimpleNamespace(
+        current_time_token=30,
+        current_lane=2,
+    )
+    oracle = ManiaDomainError(
+        reason="NO_LEGAL_MANIA_GROUP_COMPLETION",
+        message="same legacy message",
+        lane=2,
+        time_token_id=30,
+        decoder_token_index=4,
+        generated_token_index=1,
+        row_index=0,
+        context={"subtype": "NO_LEGAL_NOTE_TYPE"},
+    )
+    candidate = ManiaDomainError(
+        reason=candidate_reason,
+        message="same legacy message",
+        lane=2,
+        time_token_id=30,
+        decoder_token_index=4,
+        generated_token_index=1,
+        row_index=candidate_row,
+        context={"subtype": "NO_LEGAL_NOTE_TYPE"},
+    )
+
+    def fail_with(error):
+        def callback(*_args):
+            raise error
+        return callback
+
+    monkeypatch.setattr(processor, "_apply_full_scan", fail_with(oracle))
+    monkeypatch.setattr(processor, "_apply_incremental", fail_with(candidate))
+
+    with pytest.raises(AssertionError, match="structured evidence"):
+        processor._apply_verified(
+            torch.tensor([[_keycount_token(4), 1, 30, 12]]),
+            _scores(),
+        )
+
+    assert processor._incremental_state is None
+    assert processor.telemetry()["verificationMismatches"] == 1
+
+
+def test_incremental_verify_accepts_identical_structured_domain_evidence(
+        monkeypatch,
+):
+    processor = ManiaHoldStateLogitsProcessor(
+        _Tokenizer(), (), hold_state_mode="incremental_verify"
+    )
+    processor.prompt_length = 3
+    state = SimpleNamespace(current_time_token=30, current_lane=2)
+    processor._incremental_state = state
+
+    def make_error():
+        return ManiaDomainError(
+            reason="NO_LEGAL_MANIA_GROUP_COMPLETION",
+            message="same legacy message",
+            lane=2,
+            time_token_id=30,
+            decoder_token_index=4,
+            generated_token_index=1,
+            row_index=0,
+            context={"subtype": "NO_LEGAL_NOTE_TYPE"},
+        )
+
+    def fail_with(error):
+        def callback(*_args):
+            raise error
+        return callback
+
+    oracle = make_error()
+    candidate = make_error()
+    monkeypatch.setattr(processor, "_apply_full_scan", fail_with(oracle))
+    monkeypatch.setattr(processor, "_apply_incremental", fail_with(candidate))
+
+    with pytest.raises(ManiaDomainError) as caught:
+        processor._apply_verified(
+            torch.tensor([[_keycount_token(4), 1, 30, 12]]),
+            _scores(),
+        )
+
+    assert caught.value is candidate
+    assert processor._incremental_state is state
+    assert processor.telemetry()["verificationRows"] == 1
+    assert processor.telemetry()["verificationMismatches"] == 0
