new file mode 100644
index 0000000..e08042b
--- /dev/null
+++ b/osuT5/osuT5/inference/mania_domain.py
@@ -0,0 +1,300 @@
+"""Typed, immutable failures from the Mania generation domain."""
+
+from __future__ import annotations
+
+import math
+from collections.abc import Mapping
+from types import MappingProxyType
+from typing import Literal
+
+ManiaDomainReason = Literal[
+    "NO_LEGAL_MANIA_GROUP_COMPLETION",
+    "INCOMPLETE_MANIA_GROUP_BEFORE_SCROLL",
+    "INSUFFICIENT_HOLD_CLOSURE_BUDGET",
+]
+
+_MANIA_DOMAIN_REASONS = frozenset(
+    {
+        "NO_LEGAL_MANIA_GROUP_COMPLETION",
+        "INCOMPLETE_MANIA_GROUP_BEFORE_SCROLL",
+        "INSUFFICIENT_HOLD_CLOSURE_BUDGET",
+    }
+)
+
+
+def _optional_non_negative_int(name: str, value: object) -> int | None:
+    if value is None:
+        return None
+    if type(value) is not int:
+        raise TypeError(f"{name} must be an exact int or None")
+    if value < 0:
+        raise ValueError(f"{name} must be non-negative when provided")
+    return value
+
+
+def _required_non_negative_int(name: str, value: object) -> int:
+    if type(value) is not int:
+        raise TypeError(f"{name} must be an exact int")
+    if value < 0:
+        raise ValueError(f"{name} must be non-negative")
+    return value
+
+
+def _optional_finite_number(name: str, value: object) -> int | float | None:
+    if value is None:
+        return None
+    if type(value) not in {int, float}:
+        raise TypeError(f"{name} must be an exact int, float, or None")
+    if not math.isfinite(value):
+        raise ValueError(f"{name} must be finite when provided")
+    return value
+
+
+def _freeze_json(
+        value: object,
+        *,
+        path: str,
+        active_containers: set[int],
+) -> object:
+    value_type = type(value)
+    if value is None or value_type in {str, int}:
+        return value
+    if value_type is bool:
+        raise TypeError(f"{path} boolean values are not accepted as evidence")
+    if value_type is float:
+        if not math.isfinite(value):
+            raise ValueError(f"{path} numbers must be finite")
+        return value
+    if value_type is dict:
+        identity = id(value)
+        if identity in active_containers:
+            raise ValueError(f"{path} contains a container cycle")
+        active_containers.add(identity)
+        try:
+            frozen: dict[str, object] = {}
+            for key, item in value.items():
+                if type(key) is not str:
+                    raise TypeError(f"{path} must use exact string keys")
+                frozen[key] = _freeze_json(
+                    item,
+                    path=f"{path}.{key}",
+                    active_containers=active_containers,
+                )
+            return MappingProxyType(frozen)
+        finally:
+            active_containers.remove(identity)
+    if value_type is list:
+        identity = id(value)
+        if identity in active_containers:
+            raise ValueError(f"{path} contains a container cycle")
+        active_containers.add(identity)
+        try:
+            return tuple(
+                _freeze_json(
+                    item,
+                    path=f"{path}[{index}]",
+                    active_containers=active_containers,
+                )
+                for index, item in enumerate(value)
+            )
+        finally:
+            active_containers.remove(identity)
+    raise TypeError(
+        f"{path} must contain only exact JSON-safe value types"
+    )
+
+
+def _freeze_context(context: Mapping[str, object] | None) -> Mapping[str, object]:
+    if context is None:
+        context = {}
+    if type(context) is not dict:
+        raise TypeError("context must be an exact dict Mapping")
+    frozen = _freeze_json(
+        context,
+        path="context",
+        active_containers=set(),
+    )
+    assert isinstance(frozen, Mapping)
+    return frozen
+
+
+def _thaw_json(value: object) -> object:
+    if isinstance(value, Mapping):
+        return {key: _thaw_json(item) for key, item in value.items()}
+    if type(value) is tuple:
+        return [_thaw_json(item) for item in value]
+    return value
+
+
+class ManiaDomainError(ValueError):
+    """A recoverable Mania failure with unit-explicit evidence.
+
+    ``message`` remains the exception's string representation for compatibility.
+    All evidence is read-only after construction and ``to_dict`` returns a new,
+    JSON-safe mutable projection rather than exposing internal state.
+    """
+
+    version = 1
+    __slots__ = (
+        "_sealed",
+        "_reason",
+        "_message",
+        "_lane",
+        "_time_ms",
+        "_time_token_id",
+        "_event_index",
+        "_decoder_token_index",
+        "_generated_token_index",
+        "_row_index",
+        "_source_window_id",
+        "_context",
+    )
+
+    def __init__(
+            self,
+            *,
+            reason: ManiaDomainReason,
+            message: str,
+            lane: int | None = None,
+            time_ms: int | float | None = None,
+            time_token_id: int | None = None,
+            event_index: int | None = None,
+            decoder_token_index: int | None = None,
+            generated_token_index: int | None = None,
+            row_index: int | None = None,
+            source_window_id: int | None = None,
+            context: Mapping[str, object] | None = None,
+    ) -> None:
+        if type(reason) is not str or reason not in _MANIA_DOMAIN_REASONS:
+            raise ValueError(f"unsupported Mania domain reason: {reason}")
+        if type(message) is not str or not message:
+            raise ValueError(
+                "Mania domain error message must be a non-empty exact str"
+            )
+        lane = _optional_non_negative_int("lane", lane)
+        time_ms = _optional_finite_number("time_ms", time_ms)
+        time_token_id = _optional_non_negative_int(
+            "time_token_id", time_token_id
+        )
+        event_index = _optional_non_negative_int("event_index", event_index)
+        decoder_token_index = _optional_non_negative_int(
+            "decoder_token_index", decoder_token_index
+        )
+        generated_token_index = _optional_non_negative_int(
+            "generated_token_index", generated_token_index
+        )
+        row_index = _optional_non_negative_int("row_index", row_index)
+        source_window_id = _optional_non_negative_int(
+            "source_window_id", source_window_id
+        )
+        frozen_context = _freeze_context(context)
+
+        ValueError.__init__(self, message)
+        object.__setattr__(self, "_reason", reason)
+        object.__setattr__(self, "_message", message)
+        object.__setattr__(self, "_lane", lane)
+        object.__setattr__(self, "_time_ms", time_ms)
+        object.__setattr__(self, "_time_token_id", time_token_id)
+        object.__setattr__(self, "_event_index", event_index)
+        object.__setattr__(self, "_decoder_token_index", decoder_token_index)
+        object.__setattr__(self, "_generated_token_index", generated_token_index)
+        object.__setattr__(self, "_row_index", row_index)
+        object.__setattr__(self, "_source_window_id", source_window_id)
+        object.__setattr__(self, "_context", frozen_context)
+        object.__setattr__(self, "_sealed", True)
+
+    def __setattr__(self, name: str, value: object) -> None:
+        if getattr(self, "_sealed", False):
+            raise AttributeError("ManiaDomainError evidence is read-only")
+        object.__setattr__(self, name, value)
+
+    def __delattr__(self, name: str) -> None:
+        if getattr(self, "_sealed", False):
+            raise AttributeError("ManiaDomainError evidence is read-only")
+        object.__delattr__(self, name)
+
+    @property
+    def reason(self) -> ManiaDomainReason:
+        return self._reason
+
+    @property
+    def message(self) -> str:
+        return self._message
+
+    @property
+    def lane(self) -> int | None:
+        return self._lane
+
+    @property
+    def time_ms(self) -> int | float | None:
+        return self._time_ms
+
+    @property
+    def time_token_id(self) -> int | None:
+        return self._time_token_id
+
+    @property
+    def event_index(self) -> int | None:
+        return self._event_index
+
+    @property
+    def decoder_token_index(self) -> int | None:
+        return self._decoder_token_index
+
+    @property
+    def generated_token_index(self) -> int | None:
+        return self._generated_token_index
+
+    @property
+    def row_index(self) -> int | None:
+        return self._row_index
+
+    @property
+    def source_window_id(self) -> int | None:
+        return self._source_window_id
+
+    @property
+    def context(self) -> Mapping[str, object]:
+        return self._context
+
+    def with_source_window(self, source_window_id: int) -> ManiaDomainError:
+        """Fill an absent source id, accept an identical id, reject conflicts."""
+        source_window_id = _required_non_negative_int(
+            "source_window_id", source_window_id
+        )
+        if self.source_window_id is not None:
+            if self.source_window_id == source_window_id:
+                return self
+            raise ValueError(
+                "conflicting source_window_id: "
+                f"existing={self.source_window_id}, requested={source_window_id}"
+            )
+        return ManiaDomainError(
+            reason=self.reason,
+            message=self.message,
+            lane=self.lane,
+            time_ms=self.time_ms,
+            time_token_id=self.time_token_id,
+            event_index=self.event_index,
+            decoder_token_index=self.decoder_token_index,
+            generated_token_index=self.generated_token_index,
+            row_index=self.row_index,
+            source_window_id=source_window_id,
+            context=_thaw_json(self.context),
+        )
+
