@@ -0,0 +1,871 @@
+"""Append-only generation checkpoints and deterministic RNG restoration.
+
+The store retains one immutable base stream and one immutable delta per committed
+window.  A checkpoint refers to a delta count rather than copying the complete
+event stream, so retained event storage grows linearly with generated events.
+"""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+import math
+import random
+from dataclasses import dataclass
+from typing import Any, Sequence
+
+import numpy as np
+import torch
+
+from ..event import Event, EventType
+from .origin import EventOrigin
+
+_PREFIX_DIGEST_DOMAIN = b"osuT5-generation-prefix-v1\0"
+_REPAIR_SEED_DOMAIN = b"osuT5-mania-tail-repair-seed-v1\0"
+
+
+class GenerationCheckpointError(ValueError):
+    """Base class for checkpoint contract violations."""
+
+
+class CheckpointIdentityMismatch(GenerationCheckpointError):
+    """The caller is trying to restore a checkpoint from another invocation."""
+
+
+class CheckpointIntegrityError(GenerationCheckpointError):
+    """Stored or caller-supplied checkpoint evidence does not verify."""
+
+
+class CheckpointPrefixMismatch(CheckpointIntegrityError):
+    """A new commit does not extend the previously committed exact prefix."""
+
+
+class UnknownCheckpointError(GenerationCheckpointError):
+    """No checkpoint exists for the requested next window."""
+
+
+@dataclass(frozen=True, slots=True)
+class RngSnapshot:
+    python_state: object
+    numpy_state: tuple[Any, ...]
+    torch_cpu_state: torch.Tensor
+    cuda_rng_states: tuple[torch.Tensor, ...]
+
+
+@dataclass(frozen=True, slots=True)
+class RestoredGenerationCheckpoint:
+    next_window_index: int
+    events: list[Event]
+    event_times: list[int | float]
+    event_origins: list[EventOrigin]
+    metadata: Any
+    rng_snapshot: RngSnapshot
+    identity_digest: str
+    prefix_digest: str
+
+
+@dataclass(frozen=True, slots=True)
+class CheckpointStorageStats:
+    checkpoint_count: int
+    delta_count: int
+    base_event_count: int
+    delta_event_count: int
+    stored_event_count: int
+    logical_event_count: int
+    delta_event_counts: tuple[int, ...]
+
+
+@dataclass(frozen=True, slots=True)
+class _EventRecord:
+    event_type: str
+    value_type: str
+    value: int | str | None
+
+
+@dataclass(frozen=True, slots=True)
+class _TimeRecord:
+    value_type: str
+    value: int | str
+
+
+@dataclass(frozen=True, slots=True)
+class _OriginRecord:
+    kind: str
+    source_window_id: int | None
+    source_token_index: int | None
+    reference_event_index: int | None
+
+
+@dataclass(frozen=True, slots=True)
+class _Delta:
+    events: tuple[_EventRecord, ...]
+    event_times: tuple[_TimeRecord, ...]
+    event_origins: tuple[_OriginRecord, ...]
+
+
+@dataclass(frozen=True, slots=True)
+class _CheckpointRecord:
+    next_window_index: int
+    delta_count: int
+    event_count: int
+    prefix_digest: str
+    metadata: Any
+    rng_snapshot: RngSnapshot
+
+
+@dataclass(frozen=True, slots=True)
+class _FrozenMapping:
+    items: tuple[tuple[str, Any], ...]
+
+
+@dataclass(frozen=True, slots=True)
+class _FrozenList:
+    items: tuple[Any, ...]
+
+
+@dataclass(frozen=True, slots=True)
+class _FrozenTuple:
+    items: tuple[Any, ...]
+
+
+def _clone_rng_snapshot(snapshot: RngSnapshot) -> RngSnapshot:
+    if not isinstance(snapshot, RngSnapshot):
+        raise CheckpointIntegrityError("rng snapshot must be an RngSnapshot")
+    try:
+        return RngSnapshot(
+            python_state=copy.deepcopy(snapshot.python_state),
+            numpy_state=copy.deepcopy(snapshot.numpy_state),
+            torch_cpu_state=snapshot.torch_cpu_state.detach().cpu().clone(),
+            cuda_rng_states=tuple(
+                state.detach().cpu().clone() for state in snapshot.cuda_rng_states
+            ),
+        )
+    except Exception as error:
+        raise CheckpointIntegrityError(
+            f"invalid RNG checkpoint representation: {error}"
+        ) from error
+
+
+def capture_rng_state() -> RngSnapshot:
+    """Capture all process-global RNGs used by the current inference path."""
+    cuda_states: tuple[torch.Tensor, ...] = ()
+    if torch.cuda.is_available():
+        cuda_states = tuple(
+            state.detach().cpu().clone()
+            for state in torch.cuda.get_rng_state_all()
+        )
+    return RngSnapshot(
+        python_state=copy.deepcopy(random.getstate()),
+        numpy_state=copy.deepcopy(np.random.get_state()),
+        torch_cpu_state=torch.get_rng_state().detach().cpu().clone(),
+        cuda_rng_states=cuda_states,
+    )
+
+
+def _validate_rng_tensor(state: torch.Tensor, label: str) -> None:
+    if not isinstance(state, torch.Tensor):
+        raise CheckpointIntegrityError(f"{label} RNG state is not a tensor")
+    if state.device.type != "cpu" or state.dtype != torch.uint8 or state.ndim != 1:
+        raise CheckpointIntegrityError(
+            f"{label} RNG state must be a one-dimensional CPU uint8 tensor"
+        )
+
+
+def _validated_rng_snapshot(snapshot: RngSnapshot) -> RngSnapshot:
+    """Validate target states on isolated RNG instances, then clone them."""
+    if not isinstance(snapshot, RngSnapshot):
+        raise CheckpointIntegrityError("rng snapshot must be an RngSnapshot")
+
+    try:
+        python_state = copy.deepcopy(snapshot.python_state)
+        random.Random().setstate(copy.deepcopy(python_state))
+    except Exception as error:
+        raise CheckpointIntegrityError(
+            f"invalid Python RNG state: {error}"
+        ) from error
+
+    try:
+        numpy_state = copy.deepcopy(snapshot.numpy_state)
+        np.random.RandomState().set_state(copy.deepcopy(numpy_state))
+    except Exception as error:
+        raise CheckpointIntegrityError(
+            f"invalid NumPy RNG state: {error}"
+        ) from error
+
+    try:
+        _validate_rng_tensor(snapshot.torch_cpu_state, "Torch CPU")
+        torch_state = snapshot.torch_cpu_state.detach().cpu().clone()
+        torch.Generator(device="cpu").set_state(torch_state.clone())
+    except CheckpointIntegrityError:
+        raise
+    except Exception as error:
+        raise CheckpointIntegrityError(
+            f"invalid Torch CPU RNG state: {error}"
+        ) from error
+
+    if not isinstance(snapshot.cuda_rng_states, tuple):
+        raise CheckpointIntegrityError("CUDA RNG states must be a tuple")
+    cuda_states: list[torch.Tensor] = []
+    if snapshot.cuda_rng_states:
+        if not torch.cuda.is_available():
+            raise CheckpointIntegrityError(
+                "checkpoint has CUDA RNG states but CUDA is unavailable"
+            )
+        current_devices = torch.cuda.device_count()
+        if current_devices != len(snapshot.cuda_rng_states):
+            raise CheckpointIntegrityError(
+                "CUDA RNG device count mismatch: "
+                f"checkpoint={len(snapshot.cuda_rng_states)}, current={current_devices}"
+            )
+    for index, state in enumerate(snapshot.cuda_rng_states):
+        try:
+            _validate_rng_tensor(state, f"CUDA device {index}")
+            state_copy = state.detach().cpu().clone()
+            torch.Generator(device=f"cuda:{index}").set_state(state_copy.clone())
+            cuda_states.append(state_copy)
+        except CheckpointIntegrityError:
+            raise
+        except Exception as error:
+            raise CheckpointIntegrityError(
+                f"invalid CUDA device {index} RNG state: {error}"
+            ) from error
+
+    return RngSnapshot(
+        python_state=python_state,
+        numpy_state=numpy_state,
+        torch_cpu_state=torch_state,
+        cuda_rng_states=tuple(cuda_states),
+    )
+
+
+def _apply_rng_snapshot_collecting_errors(
+        snapshot: RngSnapshot,
+) -> tuple[tuple[str, Exception], ...]:
+    """Apply every state independently so rollback attempts all RNG families."""
+    setters = [
+        (
+            "Python",
+            lambda: random.setstate(copy.deepcopy(snapshot.python_state)),
+        ),
+        (
+            "NumPy",
+            lambda: np.random.set_state(copy.deepcopy(snapshot.numpy_state)),
+        ),
+        (
+            "Torch CPU",
+            lambda: torch.set_rng_state(snapshot.torch_cpu_state.clone()),
+        ),
+    ]
+    setters.extend(
+        (
+            f"CUDA device {index}",
+            lambda index=index, state=state: torch.cuda.set_rng_state(
+                state.clone(), index
+            ),
+        )
+        for index, state in enumerate(snapshot.cuda_rng_states)
+    )
+    errors: list[tuple[str, Exception]] = []
+    for label, setter in setters:
+        try:
+            setter()
+        except Exception as error:
+            errors.append((label, error))
+    return tuple(errors)
+
+
+def restore_rng_state(snapshot: RngSnapshot) -> None:
+    """Restore an exact-resume snapshot without deriving a new repair seed."""
+    target = _validated_rng_snapshot(snapshot)
+    try:
+        previous = capture_rng_state()
+    except Exception as error:
+        raise CheckpointIntegrityError(
+            f"could not capture pre-restore RNG state: {error}"
+        ) from error
+
+    apply_errors = _apply_rng_snapshot_collecting_errors(target)
+    if not apply_errors:
+        return
+
+    rollback_errors = _apply_rng_snapshot_collecting_errors(previous)
+    message = "could not restore RNG checkpoint: " + "; ".join(
+        f"{label}: {error}" for label, error in apply_errors
+    )
+    if rollback_errors:
+        message += "; rollback failures: " + "; ".join(
+            f"{label}: {error}" for label, error in rollback_errors
+        )
+    raise CheckpointIntegrityError(message) from apply_errors[0][1]
+
+
+def derive_repair_seed(
+        *,
+        base_seed: int,
+        attempt: int,
+        repair_start_window: int,
+) -> int:
+    """Derive a stable suffix seed with a versioned SHA-256 domain."""
+    if isinstance(base_seed, bool) or not isinstance(base_seed, int):
+        raise TypeError("base_seed must be an integer")
+    if isinstance(attempt, bool) or not isinstance(attempt, int) or attempt not in (1, 2):
+        raise ValueError("attempt must be 1 or 2")
+    if (
+            isinstance(repair_start_window, bool)
+            or not isinstance(repair_start_window, int)
+            or repair_start_window < 0
+    ):
+        raise ValueError("repair_start_window must be a non-negative integer")
+
+    payload = json.dumps(
+        {
+            "attempt": attempt,
+            "baseSeed": base_seed,
+            "repairStartWindow": repair_start_window,
+            "version": 1,
+        },
+        sort_keys=True,
+        separators=(",", ":"),
+        ensure_ascii=True,
+    ).encode("ascii")
+    digest = hashlib.sha256(_REPAIR_SEED_DOMAIN + payload).digest()
+    return int.from_bytes(digest[:8], "big") & ((1 << 63) - 1)
+
+
+def reseed_for_domain_repair(
+        *,
+        base_seed: int,
+        attempt: int,
+        repair_start_window: int,
+) -> int:
+    """Reseed a deliberately different repair suffix, separate from resume."""
+    seed = derive_repair_seed(
+        base_seed=base_seed,
+        attempt=attempt,
+        repair_start_window=repair_start_window,
+    )
+    random.seed(seed)
+    np.random.seed(seed % (1 << 32))
+    torch.manual_seed(seed)
+    if torch.cuda.is_available():
+        torch.cuda.manual_seed_all(seed)
+    return seed
+
+
+def _checkpoint_rng_snapshot(
+        snapshot: RngSnapshot | None,
+) -> RngSnapshot:
+    if snapshot is None:
+        return _clone_rng_snapshot(capture_rng_state())
+    return _validated_rng_snapshot(snapshot)
+
+
+def _numeric_record(value: object, label: str) -> _TimeRecord:
+    if isinstance(value, bool) or type(value) not in (int, float):
+        raise TypeError(f"{label} must be an int or float")
+    if isinstance(value, float) and not math.isfinite(value):
+        raise ValueError(f"{label} must be finite")
+    if type(value) is int:
+        return _TimeRecord("int", value)
+    return _TimeRecord("float", value.hex())
+
+
+def _restore_numeric(record: _TimeRecord) -> int | float:
+    if not isinstance(record, _TimeRecord):
+        raise CheckpointIntegrityError("stored event time record is invalid")
+    if record.value_type == "int" and type(record.value) is int:
+        return record.value
+    if record.value_type == "float" and type(record.value) is str:
+        try:
+            value = float.fromhex(record.value)
+        except ValueError as error:
+            raise CheckpointIntegrityError(
+                f"stored float event time is invalid: {error}"
+            ) from error
+        if not math.isfinite(value):
+            raise CheckpointIntegrityError("stored float event time must be finite")
+        return value
+    raise CheckpointIntegrityError("stored event time type tag is invalid")
+
+
+def _event_record(event: Event) -> _EventRecord:
+    if not isinstance(event, Event):
+        raise TypeError("checkpoint events must contain Event objects")
+    value = event.value
+    if isinstance(value, bool):
+        raise TypeError("boolean event values are not checkpoint-safe")
+    if type(value) not in (int, float, str) and value is not None:
+        raise TypeError("checkpoint event values must be JSON scalar values")
+    if isinstance(value, float) and not math.isfinite(value):
+        raise ValueError("checkpoint event values must be finite")
+    if type(value) is int:
+        return _EventRecord(event.type.value, "int", value)
+    if type(value) is float:
+        return _EventRecord(event.type.value, "float", value.hex())
+    if type(value) is str:
+        return _EventRecord(event.type.value, "str", value)
+    return _EventRecord(event.type.value, "none", None)
+
+
+def _restore_event_value(record: _EventRecord) -> int | float | str | None:
+    if record.value_type == "int" and type(record.value) is int:
+        return record.value
+    if record.value_type == "float" and type(record.value) is str:
+        try:
+            value = float.fromhex(record.value)
+        except ValueError as error:
+            raise CheckpointIntegrityError(
+                f"stored float event value is invalid: {error}"
+            ) from error
+        if not math.isfinite(value):
+            raise CheckpointIntegrityError("stored float event value must be finite")
+        return value
+    if record.value_type == "str" and type(record.value) is str:
+        return record.value
+    if record.value_type == "none" and record.value is None:
+        return None
+    raise CheckpointIntegrityError("stored event value type tag is invalid")
+
+
+def _origin_record(origin: EventOrigin) -> _OriginRecord:
+    if not isinstance(origin, EventOrigin):
+        raise TypeError("checkpoint origins must contain EventOrigin objects")
+    if type(origin.kind) is not str or origin.kind not in ("GENERATED", "REFERENCE"):
+        raise ValueError("origin kind must be exactly GENERATED or REFERENCE")
+
+    def is_nonnegative_exact_int(value: object) -> bool:
+        return type(value) is int and value >= 0
+
+    if origin.kind == "GENERATED":
+        if not is_nonnegative_exact_int(origin.source_window_id):
+            raise ValueError(
+                "GENERATED origin source_window_id must be a non-negative integer"
+            )
+        if not is_nonnegative_exact_int(origin.source_token_index):
+            raise ValueError(
+                "GENERATED origin source_token_index must be a non-negative integer"
+            )
+        if origin.reference_event_index is not None:
+            raise ValueError(
+                "GENERATED origin reference_event_index must be None"
+            )
+    else:
+        if origin.source_window_id is not None or origin.source_token_index is not None:
+            raise ValueError(
+                "REFERENCE origin source window/token indices must be None"
+            )
+        if not is_nonnegative_exact_int(origin.reference_event_index):
+            raise ValueError(
+                "REFERENCE origin reference_event_index must be a non-negative integer"
+            )
+    return _OriginRecord(
+        origin.kind,
+        origin.source_window_id,
+        origin.source_token_index,
+        origin.reference_event_index,
+    )
+
+
+def _snapshot_stream(
+        events: Sequence[Event],
+        event_times: Sequence[int | float],
+        event_origins: Sequence[EventOrigin],
+) -> tuple[
+    tuple[_EventRecord, ...],
+    tuple[_TimeRecord, ...],
+    tuple[_OriginRecord, ...],
+]:
+    if not (len(events) == len(event_times) == len(event_origins)):
+        raise ValueError(
+            "events, event_times, and event_origins must have equal length"
+        )
+    return (
+        tuple(_event_record(event) for event in events),
+        tuple(
+            _numeric_record(time_ms, f"event_times[{index}]")
+            for index, time_ms in enumerate(event_times)
+        ),
+        tuple(_origin_record(origin) for origin in event_origins),
+    )
+
+
+def _prefix_digest(
+        events: Sequence[_EventRecord],
+        event_times: Sequence[_TimeRecord],
+        origins: Sequence[_OriginRecord],
+) -> str:
+    payload = {
+        "events": [
+            {
+                "type": event.event_type,
+                "value": event.value,
+                "valueType": event.value_type,
+            }
+            for event in events
+        ],
+        "origins": [
+            {
+                "kind": origin.kind,
+                "referenceEventIndex": origin.reference_event_index,
+                "sourceTokenIndex": origin.source_token_index,
+                "sourceWindowId": origin.source_window_id,
+            }
+            for origin in origins
+        ],
+        "times": [
+            {"type": time_ms.value_type, "value": time_ms.value}
+            for time_ms in event_times
+        ],
+        "version": 1,
+    }
+    encoded = json.dumps(
+        payload,
+        sort_keys=True,
+        separators=(",", ":"),
+        ensure_ascii=True,
+        allow_nan=False,
+    ).encode("ascii")
+    return hashlib.sha256(_PREFIX_DIGEST_DOMAIN + encoded).hexdigest()
+
+
+def _freeze_metadata(
+        metadata: Any,
+        *,
+        path: str = "metadata",
+        _active_ids: set[int] | None = None,
+) -> Any:
+    """Convert a checkpoint-safe value tree to a recursively immutable form."""
+    if metadata is None or type(metadata) in (str, int, bool):
+        return metadata
+    if type(metadata) is float:
+        if not math.isfinite(metadata):
+            raise ValueError(f"{path} float values must be finite")
+        return metadata
+    if type(metadata) in (list, tuple, dict):
+        if _active_ids is None:
+            _active_ids = set()
+        object_id = id(metadata)
+        if object_id in _active_ids:
+            raise TypeError(f"{path} contains a cyclic metadata reference")
+        _active_ids.add(object_id)
+        try:
+            if type(metadata) is list:
+                return _FrozenList(tuple(
+                    _freeze_metadata(
+                        value,
+                        path=f"{path}[{index}]",
+                        _active_ids=_active_ids,
+                    )
+                    for index, value in enumerate(metadata)
+                ))
+            if type(metadata) is tuple:
+                return _FrozenTuple(tuple(
+                    _freeze_metadata(
+                        value,
+                        path=f"{path}[{index}]",
+                        _active_ids=_active_ids,
+                    )
+                    for index, value in enumerate(metadata)
+                ))
+            frozen_items: list[tuple[str, Any]] = []
+            for key, value in metadata.items():
+                if type(key) is not str:
+                    raise TypeError(
+                        f"{path} is not checkpoint-safe: dict keys must be strings"
+                    )
+                frozen_items.append((
+                    key,
+                    _freeze_metadata(
+                        value,
+                        path=f"{path}.{key}",
+                        _active_ids=_active_ids,
+                    ),
+                ))
+            return _FrozenMapping(tuple(frozen_items))
+        finally:
+            _active_ids.remove(object_id)
+    raise TypeError(
+        f"{path} is not checkpoint-safe: unsupported type "
+        f"{type(metadata).__name__}"
+    )
+
+
+def _thaw_metadata(metadata: Any) -> Any:
+    if metadata is None or type(metadata) in (str, int, float, bool):
+        return metadata
+    if isinstance(metadata, _FrozenList):
+        return [_thaw_metadata(value) for value in metadata.items]
+    if isinstance(metadata, _FrozenTuple):
+        return tuple(_thaw_metadata(value) for value in metadata.items)
+    if isinstance(metadata, _FrozenMapping):
+        return {
+            key: _thaw_metadata(value)
+            for key, value in metadata.items
+        }
+    raise CheckpointIntegrityError("stored checkpoint metadata is corrupt")
+
+
+class GenerationCheckpointStore:
+    """Append-only exact-prefix checkpoints keyed by the next window index."""
+
+    def __init__(
+            self,
+            *,
+            identity_digest: str,
+            events: Sequence[Event],
+            event_times: Sequence[int | float],
+            event_origins: Sequence[EventOrigin],
+            metadata: Any = None,
+            rng_snapshot: RngSnapshot | None = None,
+    ) -> None:
+        if type(identity_digest) is not str or not identity_digest:
+            raise ValueError("identity_digest must be a non-empty string")
+        self._identity_digest = identity_digest
+        base_events, base_times, base_origins = _snapshot_stream(
+            events, event_times, event_origins
+        )
+        self._base = _Delta(base_events, base_times, base_origins)
+        self._deltas: list[_Delta] = []
+        digest = _prefix_digest(base_events, base_times, base_origins)
+        self._checkpoints: dict[int, _CheckpointRecord] = {
+            0: _CheckpointRecord(
+                next_window_index=0,
+                delta_count=0,
+                event_count=len(base_events),
+                prefix_digest=digest,
+                metadata=_freeze_metadata(metadata),
+                rng_snapshot=_checkpoint_rng_snapshot(rng_snapshot),
+            )
+        }
+        self._latest_next_window_index = 0
+
+    @property
+    def latest_next_window_index(self) -> int:
+        return self._latest_next_window_index
+
+    def _checkpoint(self, next_window_index: int) -> _CheckpointRecord:
+        if isinstance(next_window_index, bool) or not isinstance(next_window_index, int):
+            raise UnknownCheckpointError(
+                f"unknown checkpoint next_window_index={next_window_index!r}"
+            )
+        try:
+            return self._checkpoints[next_window_index]
+        except KeyError as error:
+            raise UnknownCheckpointError(
+                f"unknown checkpoint next_window_index={next_window_index}"
+            ) from error
+
+    def _records_through(
+            self,
+            delta_count: int,
+    ) -> tuple[
+        tuple[_EventRecord, ...],
+        tuple[_TimeRecord, ...],
+        tuple[_OriginRecord, ...],
+    ]:
+        if not 0 <= delta_count <= len(self._deltas):
+            raise CheckpointIntegrityError(
+                f"corrupt checkpoint delta_count={delta_count}"
+            )
+        events = list(self._base.events)
+        times = list(self._base.event_times)
+        origins = list(self._base.event_origins)
+        for delta in self._deltas[:delta_count]:
+            if not (
+                    len(delta.events)
+                    == len(delta.event_times)
+                    == len(delta.event_origins)
+            ):
+                raise CheckpointIntegrityError("corrupt checkpoint delta lengths")
+            events.extend(delta.events)
+            times.extend(delta.event_times)
+            origins.extend(delta.event_origins)
+        return tuple(events), tuple(times), tuple(origins)
+
+    def append_checkpoint(
+            self,
+            *,
+            next_window_index: int,
+            events: Sequence[Event],
+            event_times: Sequence[int | float],
+            event_origins: Sequence[EventOrigin],
+            metadata: Any = None,
+            rng_snapshot: RngSnapshot | None = None,
+    ) -> None:
+        expected_index = self._latest_next_window_index + 1
+        if (
+                isinstance(next_window_index, bool)
+                or not isinstance(next_window_index, int)
+                or next_window_index != expected_index
+        ):
+            raise ValueError(
+                f"expected next_window_index={expected_index}, "
+                f"got {next_window_index!r}"
+            )
+        candidate = _snapshot_stream(events, event_times, event_origins)
+        previous_record = self._checkpoints[self._latest_next_window_index]
+        previous = self._records_through(previous_record.delta_count)
+        previous_count = previous_record.event_count
+        if len(candidate[0]) < previous_count or any(
+                candidate[index][:previous_count] != previous[index]
+                for index in range(3)
+        ):
+            raise CheckpointPrefixMismatch(
+                "new checkpoint must extend the previous exact prefix"
+            )
+
+        delta = _Delta(
+            candidate[0][previous_count:],
+            candidate[1][previous_count:],
+            candidate[2][previous_count:],
+        )
+        digest = _prefix_digest(*candidate)
+        metadata_copy = _freeze_metadata(metadata)
+        rng_copy = _checkpoint_rng_snapshot(rng_snapshot)
+        new_record = _CheckpointRecord(
+            next_window_index=next_window_index,
+            delta_count=len(self._deltas) + 1,
+            event_count=len(candidate[0]),
+            prefix_digest=digest,
+            metadata=metadata_copy,
+            rng_snapshot=rng_copy,
+        )
+
+        self._deltas.append(delta)
+        self._checkpoints[next_window_index] = new_record
+        self._latest_next_window_index = next_window_index
+
+    def prefix_digest(self, next_window_index: int) -> str:
+        return self._checkpoint(next_window_index).prefix_digest
+
+    def restore(
+            self,
+            next_window_index: int,
+            *,
+            identity_digest: str,
+            expected_prefix_digest: str,
+    ) -> RestoredGenerationCheckpoint:
+        record = self._checkpoint(next_window_index)
+        if type(identity_digest) is not str or not identity_digest:
+            raise CheckpointIdentityMismatch(
+                "identity_digest must be a non-empty exact string"
+            )
+        if not str.__eq__(identity_digest, self._identity_digest):
+            raise CheckpointIdentityMismatch(
+                "checkpoint identity digest does not match the current invocation"
+            )
+        if (
+                type(expected_prefix_digest) is not str
+                or len(expected_prefix_digest) != 64
+                or any(character not in "0123456789abcdef" for character in expected_prefix_digest)
+        ):
+            raise CheckpointIntegrityError(
+                "expected prefix digest must be exactly 64 lowercase hex characters"
+            )
+        if not str.__eq__(expected_prefix_digest, record.prefix_digest):
+            raise CheckpointPrefixMismatch(
+                "expected prefix digest does not match checkpoint evidence"
+            )
+
+        events, times, origins = self._records_through(record.delta_count)
+        if len(events) != record.event_count:
+            raise CheckpointIntegrityError(
+                "stored checkpoint event count does not match reconstructed prefix"
+            )
+        actual_digest = _prefix_digest(events, times, origins)
+        if actual_digest != record.prefix_digest:
+            raise CheckpointIntegrityError(
+                "stored prefix digest does not match reconstructed checkpoint"
+            )
+        try:
+            restored_events = [
+                Event(EventType(event.event_type), _restore_event_value(event))
+                for event in events
+            ]
+            restored_origins = [
+                EventOrigin(
+                    origin.kind,
+                    origin.source_window_id,
+                    origin.source_token_index,
+                    origin.reference_event_index,
+                )
+                for origin in origins
+            ]
+        except (TypeError, ValueError) as error:
+            raise CheckpointIntegrityError(
+                f"stored checkpoint record is invalid: {error}"
+            ) from error
+        return RestoredGenerationCheckpoint(
+            next_window_index=record.next_window_index,
+            events=restored_events,
+            event_times=[_restore_numeric(time_ms) for time_ms in times],
+            event_origins=restored_origins,
+            metadata=_thaw_metadata(record.metadata),
+            rng_snapshot=_clone_rng_snapshot(record.rng_snapshot),
+            identity_digest=self._identity_digest,
+            prefix_digest=record.prefix_digest,
+        )
+
+    @classmethod
+    def _from_restored_checkpoint(
+            cls,
+            checkpoint: RestoredGenerationCheckpoint,
+    ) -> GenerationCheckpointStore:
+        """Create an independent store whose base keeps an absolute window key."""
+        branch = GenerationCheckpointStore(
+            identity_digest=checkpoint.identity_digest,
+            events=checkpoint.events,
+            event_times=checkpoint.event_times,
+            event_origins=checkpoint.event_origins,
+            metadata=checkpoint.metadata,
+            rng_snapshot=checkpoint.rng_snapshot,
+        )
+        base_record = branch._checkpoints[0]
+        if not str.__eq__(base_record.prefix_digest, checkpoint.prefix_digest):
+            raise CheckpointIntegrityError(
+                "forked base digest does not match the restored checkpoint"
+            )
+        absolute_index = checkpoint.next_window_index
+        branch._checkpoints = {
+            absolute_index: _CheckpointRecord(
+                next_window_index=absolute_index,
+                delta_count=0,
+                event_count=base_record.event_count,
+                prefix_digest=base_record.prefix_digest,
+                metadata=base_record.metadata,
+                rng_snapshot=base_record.rng_snapshot,
+            )
+        }
+        branch._latest_next_window_index = absolute_index
+        return branch
+
+    def fork_from(
+            self,
+            next_window_index: int,
+            *,
+            identity_digest: str,
+            expected_prefix_digest: str,
+    ) -> GenerationCheckpointStore:
+        """Fork an independently appendable branch from a verified checkpoint."""
+        checkpoint = self.restore(
+            next_window_index,
+            identity_digest=identity_digest,
+            expected_prefix_digest=expected_prefix_digest,
+        )
+        return self._from_restored_checkpoint(checkpoint)
+
+    def storage_stats(self) -> CheckpointStorageStats:
+        delta_counts = tuple(len(delta.events) for delta in self._deltas)
+        base_count = len(self._base.events)
+        delta_count = sum(delta_counts)
+        latest = self._checkpoints[self._latest_next_window_index]
+        return CheckpointStorageStats(
+            checkpoint_count=len(self._checkpoints),
+            delta_count=len(self._deltas),
+            base_event_count=base_count,
+            delta_event_count=delta_count,
+            stored_event_count=base_count + delta_count,
+            logical_event_count=latest.event_count,
+            delta_event_counts=delta_counts,
+        )
