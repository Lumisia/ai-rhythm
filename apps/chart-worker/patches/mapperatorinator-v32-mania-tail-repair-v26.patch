@@ -0,0 +1,1181 @@
+from __future__ import annotations
+
+import io
+import json
+from types import SimpleNamespace
+
+import pytest
+import torch
+from osuT5.osuT5.event import Event, EventType
+from osuT5.osuT5.inference import processor as processor_module
+from osuT5.osuT5.inference import tail_repair
+from osuT5.osuT5.inference.generation_checkpoint import CheckpointIntegrityError
+from osuT5.osuT5.inference.mania_domain import ManiaDomainError
+from osuT5.osuT5.inference.origin import EventOrigin
+from osuT5.osuT5.inference.processor import GenerationConfig
+from osuT5.osuT5.tokenizer import ContextType
+
+
+def _context(context_type: ContextType, *, finished: bool) -> dict[str, object]:
+    return {
+        "context_type": context_type,
+        "finished": finished,
+        "events": [],
+        "event_times": [],
+        "event_origins": [],
+    }
+
+
+@pytest.mark.parametrize(
+    ("overrides", "eligible"),
+    [
+        ({}, True),
+        ({"is_inference_client": True}, False),
+        ({"parallel": True}, False),
+        ({"gamemode": 0, "mania_keycount": None}, False),
+        ({"mania_keycount": None}, False),
+        ({"types_first": True}, False),
+        ({"add_to_beatmap": True}, False),
+        ({"start_time": 100}, False),
+        ({"requested_out_context": [ContextType.TIMING]}, False),
+        ({"requested_out_context": [ContextType.TIMING, ContextType.MAP]}, False),
+        ({"out_context": [_context(ContextType.MAP, finished=True)]}, False),
+        (
+            {
+                "out_context": [
+                    _context(ContextType.MAP, finished=False),
+                    _context(ContextType.TIMING, finished=False),
+                ]
+            },
+            False,
+        ),
+    ],
+)
+def test_tail_repair_eligibility_matrix(overrides, eligible):
+    inputs = {
+        "is_inference_client": False,
+        "parallel": False,
+        "gamemode": 3,
+        "mania_keycount": 4,
+        "types_first": False,
+        "add_to_beatmap": False,
+        "start_time": None,
+        "requested_out_context": [ContextType.MAP],
+        "out_context": [_context(ContextType.MAP, finished=False)],
+    }
+    inputs.update(overrides)
+
+    select_context = getattr(tail_repair, "eligible_mania_tail_context")
+
+    selected = select_context(**inputs)
+    assert (selected is not None) is eligible
+
+
+def test_finished_timing_prerequisite_does_not_count_as_second_unfinished_output():
+    map_context = _context(ContextType.MAP, finished=False)
+    timing_context = _context(ContextType.TIMING, finished=True)
+
+    select_context = getattr(tail_repair, "eligible_mania_tail_context")
+
+    assert select_context(
+        is_inference_client=False,
+        parallel=False,
+        gamemode=3,
+        mania_keycount=4,
+        types_first=False,
+        add_to_beatmap=False,
+        start_time=None,
+        requested_out_context=[ContextType.MAP],
+        out_context=[timing_context, map_context],
+    ) is map_context
+
+
+@pytest.mark.parametrize(
+    ("field", "value"),
+    [
+        ("is_inference_client", 0),
+        ("parallel", 0),
+        ("gamemode", True),
+        ("mania_keycount", True),
+        ("mania_keycount", 0),
+        ("types_first", 0),
+        ("add_to_beatmap", 0),
+        ("requested_out_context", None),
+        ("requested_out_context", (ContextType.MAP,)),
+        ("out_context", (_context(ContextType.MAP, finished=False),)),
+    ],
+)
+def test_tail_repair_eligibility_fails_closed_on_non_exact_inputs(field, value):
+    inputs = {
+        "is_inference_client": False,
+        "parallel": False,
+        "gamemode": 3,
+        "mania_keycount": 4,
+        "types_first": False,
+        "add_to_beatmap": False,
+        "start_time": None,
+        "requested_out_context": [ContextType.MAP],
+        "out_context": [_context(ContextType.MAP, finished=False)],
+    }
+    inputs[field] = value
+
+    assert tail_repair.eligible_mania_tail_context(**inputs) is None
+
+
+@pytest.mark.parametrize(
+    "out_context",
+    [
+        [{}],
+        [{"context_type": ContextType.MAP, "finished": 0}],
+        [{"context_type": "map", "finished": False}],
+        [
+            _context(ContextType.TIMING, finished=True),
+            {"context_type": ContextType.MAP},
+        ],
+    ],
+)
+def test_tail_repair_eligibility_fails_closed_on_malformed_extra_contexts(out_context):
