+def test_terminal_boundary_emits_one_line_for_a_partial_rejoin_failure():
+    stream = io.StringIO()
+
+    def operation():
+        raise tail_repair.ManiaPartialRejoinInvalid(
+            scope="REFERENCE",
+            partial_start_ms=150,
+            partial_end_ms=None,
+            validation_error="reference is unclosed",
+            earliest_generated_source_window_id=None,
+        )
+
+    with pytest.raises(SystemExit) as exited:
+        tail_repair.run_with_mania_tail_terminal(operation, stream=stream)
+
+    assert exited.value.code == 1
+    lines = stream.getvalue().splitlines()
+    assert len(lines) == 1
+    payload = json.loads(
+        lines[0][len(tail_repair.MAPPERATORINATOR_INVOCATION_RESULT_PREFIX):]
+    )
+    assert payload["code"] == "MANIA_PARTIAL_REJOIN_INVALID"
+    assert payload["context"]["scope"] == "REFERENCE"
