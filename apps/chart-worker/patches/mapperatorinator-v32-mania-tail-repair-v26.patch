+"""Transactional final-boundary handling for serialized Mania MAP events."""
+
+from __future__ import annotations
+
+import json
+import math
+from dataclasses import dataclass
+from numbers import Real
+from typing import Callable, Literal, Mapping, NoReturn, Sequence, TextIO, TypeVar
+
+from ..dataset.data_utils import TYPE_EVENTS
+from ..event import Event, EventType
+from ..tokenizer import ContextType
+from .mania_domain import ManiaDomainError
+from .mania_grammar import (
+    MANIA_SUSTAIN_TYPES,
+    CanonicalManiaGroup,
+    canonical_mania_groups,
+    replay_mania_hold_state,
+)
+from .origin import EventOrigin
+
+ManiaTailReason = Literal[
+    "END_BOUNDARY_CROSSES_HOLD",
+    "PRE_TRIM_INVALID",
+    "UNCLOSED_HOLD_AT_STREAM_END",
+]
+
+_TERMINAL_TAIL_REASONS = frozenset({
+    "END_BOUNDARY_CROSSES_HOLD",
+    "PRE_TRIM_INVALID",
+    "NO_LEGAL_MANIA_GROUP_COMPLETION",
+    "INCOMPLETE_MANIA_GROUP_BEFORE_SCROLL",
+    "INSUFFICIENT_HOLD_CLOSURE_BUDGET",
+    "UNCLOSED_HOLD_AT_STREAM_END",
+})
+_MAX_TAIL_WINDOW_ID = 1_000_000
+_MAX_TAIL_REPAIR_WINDOW_COUNT = 4_096
+_MAX_TAIL_REQUESTED_END_MS = 86_400_000
+MAPPERATORINATOR_INVOCATION_RESULT_PREFIX = (
+    "MAPPERATORINATOR_INVOCATION_RESULT="
+)
+_T = TypeVar("_T")
+
+
+def eligible_mania_tail_context(
+        *,
+        is_inference_client: bool,
+        parallel: bool,
+        gamemode: int,
+        mania_keycount: int | None,
+        types_first: bool,
+        add_to_beatmap: bool,
+        start_time: int | None,
+        requested_out_context: list[ContextType] | None,
+        out_context: list[dict[str, object]],
+) -> dict[str, object] | None:
+    """Select the sole repairable whole-map Mania output, or fail closed."""
+    if (
+            type(is_inference_client) is not bool
+            or type(parallel) is not bool
+            or type(types_first) is not bool
+            or type(add_to_beatmap) is not bool
+            or is_inference_client
+            or parallel
+            or types_first
+            or add_to_beatmap
+            or start_time is not None
+            or type(gamemode) is not int
+            or gamemode != 3
+            or type(mania_keycount) is not int
+            or mania_keycount <= 0
+            or type(requested_out_context) is not list
+            or type(out_context) is not list
+            or requested_out_context != [ContextType.MAP]
+            or any(type(context_type) is not ContextType for context_type in requested_out_context)
+    ):
+        return None
+
+    unfinished: list[dict[str, object]] = []
+    for context in out_context:
+        if type(context) is not dict:
+            return None
+        context_type = context.get("context_type")
+        finished = context.get("finished")
+        if type(context_type) is not ContextType or type(finished) is not bool:
+            return None
+        if not finished:
+            unfinished.append(context)
+
+    if len(unfinished) != 1 or unfinished[0]["context_type"] is not ContextType.MAP:
+        return None
+    return unfinished[0]
+
+
+def _terminal_exact_int(failure: object, name: str) -> int:
+    try:
+        value = getattr(failure, name)
+    except AttributeError as error:
+        raise TypeError(f"failure is missing {name}") from error
+    if type(value) is not int:
+        raise TypeError(f"{name} must be an exact int")
+    return value
+
+
+def build_mania_tail_repair_terminal_record(
+        failure: object,
+) -> dict[str, object]:
+    """Build only records accepted by chart-worker's strict terminal parser."""
+    try:
+        reason = getattr(failure, "reason")
+        repair_trigger_reason = getattr(failure, "repair_trigger_reason")
+        repair_window_ids = getattr(failure, "repair_window_ids")
+    except AttributeError as error:
+        raise TypeError("failure is missing terminal repair evidence") from error
+    if type(reason) is not str or reason not in _TERMINAL_TAIL_REASONS:
+        raise ValueError(f"unsupported Mania tail reason: {reason!r}")
+    if (
+            type(repair_trigger_reason) is not str
+            or repair_trigger_reason not in _TERMINAL_TAIL_REASONS
+    ):
+        raise ValueError(
+            f"unsupported Mania tail trigger reason: {repair_trigger_reason!r}"
+        )
+
+    requested_end_ms = _terminal_exact_int(failure, "requested_end_ms")
+    effective_cut_ms = _terminal_exact_int(failure, "effective_cut_ms")
+    earliest_window = _terminal_exact_int(
+        failure, "earliest_generated_source_window_id"
+    )
+    repair_trigger_window = _terminal_exact_int(
+        failure, "repair_trigger_source_window_id"
+    )
+    repair_start = _terminal_exact_int(failure, "repair_start_window_id")
+    repair_attempts = _terminal_exact_int(failure, "repair_attempts")
+    if not 0 <= requested_end_ms <= _MAX_TAIL_REQUESTED_END_MS:
+        raise ValueError("requested_end_ms is outside the terminal protocol")
+    if not 0 <= effective_cut_ms - requested_end_ms <= 10:
+        raise ValueError("effective_cut_ms must be requested_end_ms through +10")
+    if effective_cut_ms > _MAX_TAIL_REQUESTED_END_MS + 10:
+        raise ValueError("effective_cut_ms is outside the terminal protocol")
+    if not 0 <= earliest_window <= _MAX_TAIL_WINDOW_ID:
+        raise ValueError("earliest source window is outside the terminal protocol")
+    if not 0 <= repair_trigger_window <= _MAX_TAIL_WINDOW_ID:
+        raise ValueError("repair trigger window is outside the terminal protocol")
+    expected_start = max(0, repair_trigger_window - 2)
+    if repair_start != expected_start:
+        raise ValueError("repair_start_window_id does not match earliest source")
+    # A repair may be cut to one pass when rewinding to the fault window would
+    # otherwise cost more than the full attempt the repair replaces.
+    if repair_attempts not in (1, 2):
+        raise ValueError("repair_attempts must be 1 or 2")
+    if type(repair_window_ids) is not tuple:
+        raise TypeError("repair_window_ids must be an exact tuple")
+    if not 0 < len(repair_window_ids) <= _MAX_TAIL_REPAIR_WINDOW_COUNT:
+        raise ValueError("repair_window_ids has an invalid length")
+    if any(
+            type(window_id) is not int
+            or not 0 <= window_id <= _MAX_TAIL_WINDOW_ID
+            for window_id in repair_window_ids
+    ):
+        raise TypeError("repair_window_ids must contain exact bounded ints")
+    if (
+            repair_window_ids[0] != expected_start
+            or any(
+                right != left + 1
+            for left, right in zip(
+                    repair_window_ids,
+                    repair_window_ids[1:],
+                )
+            )
+    ):
+        raise ValueError("repair_window_ids must be a contiguous attempted prefix")
+
+    return {
+        "version": 1,
+        "status": "FAILURE",
+        "code": "MANIA_TAIL_REPAIR_EXHAUSTED",
+        "context": {
+            "reason": reason,
+            "signature": f"{reason}:{requested_end_ms}:{earliest_window}",
+            "requestedEndMs": requested_end_ms,
+            "effectiveCutMs": effective_cut_ms,
+            "earliestGeneratedSourceWindowId": earliest_window,
+            "repairTriggerReason": repair_trigger_reason,
+            "repairTriggerSourceWindowId": repair_trigger_window,
+            "repairStartWindowId": repair_start,
+            "repairWindowIds": list(repair_window_ids),
+            "repairAttempts": repair_attempts,
+        },
+    }
+
+
+class ManiaTailRepairExhausted(ValueError):
+    """Definitive result after exactly two suffix repair attempts fail."""
+
+    __slots__ = (
+        "_sealed",
+        "reason",
+        "requested_end_ms",
+        "effective_cut_ms",
+        "earliest_generated_source_window_id",
+        "repair_trigger_reason",
+        "repair_trigger_source_window_id",
+        "repair_start_window_id",
+        "repair_window_ids",
+        "repair_attempts",
+    )
+
+    def __init__(
+            self,
+            *,
+            reason: str,
+            requested_end_ms: int,
+            effective_cut_ms: int,
+            earliest_generated_source_window_id: int,
+            repair_start_window_id: int,
+            repair_window_ids: Sequence[int],
+            repair_attempts: int = 2,
+            repair_trigger_reason: str | None = None,
+            repair_trigger_source_window_id: int | None = None,
+    ) -> None:
+        if repair_trigger_reason is None:
+            repair_trigger_reason = reason
+        if repair_trigger_source_window_id is None:
+            repair_trigger_source_window_id = earliest_generated_source_window_id
+        object.__setattr__(self, "_sealed", False)
+        object.__setattr__(self, "reason", reason)
+        object.__setattr__(self, "requested_end_ms", requested_end_ms)
+        object.__setattr__(self, "effective_cut_ms", effective_cut_ms)
+        object.__setattr__(self, "earliest_generated_source_window_id", (
+            earliest_generated_source_window_id
+        ))
+        object.__setattr__(self, "repair_trigger_reason", repair_trigger_reason)
+        object.__setattr__(
+            self,
+            "repair_trigger_source_window_id",
+            repair_trigger_source_window_id,
+        )
+        object.__setattr__(self, "repair_start_window_id", repair_start_window_id)
+        object.__setattr__(self, "repair_window_ids", tuple(repair_window_ids))
+        object.__setattr__(self, "repair_attempts", repair_attempts)
+        record = build_mania_tail_repair_terminal_record(self)
+        ValueError.__init__(self, str(record["context"]))
+        object.__setattr__(self, "_sealed", True)
+
+    def __setattr__(self, name: str, value: object) -> None:
+        if getattr(self, "_sealed", False):
+            raise AttributeError("ManiaTailRepairExhausted evidence is read-only")
+        object.__setattr__(self, name, value)
+
+    def __delattr__(self, name: str) -> None:
+        if getattr(self, "_sealed", False):
+            raise AttributeError("ManiaTailRepairExhausted evidence is read-only")
+        object.__delattr__(self, name)
+
+    def to_terminal_record(self) -> dict[str, object]:
+        return build_mania_tail_repair_terminal_record(self)
+
+
+def format_mania_tail_terminal_line(
+        failure: ManiaTailRepairExhausted,
+) -> str:
+    payload = json.dumps(
+        build_mania_tail_repair_terminal_record(failure),
+        sort_keys=True,
+        separators=(",", ":"),
+        ensure_ascii=True,
+        allow_nan=False,
+    )
+    return MAPPERATORINATOR_INVOCATION_RESULT_PREFIX + payload
+
+
+ManiaPartialRejoinScope = Literal["REFERENCE", "REJOINED"]
+_MANIA_PARTIAL_REJOIN_SCOPES = frozenset({"REFERENCE", "REJOINED"})
+_MAX_PARTIAL_VALIDATION_ERROR_CHARS = 512
+
+
+class ManiaPartialRejoinInvalid(ValueError):
+    """Definitive PARTIAL_REMAP failure: an interval that cannot rejoin.
+
+    The partial path owns no repair budget and no window controller, so it can
+    never reach the tail-repair terminal.  ``scope`` separates the two causes a
+    caller must act on differently: ``REFERENCE`` means the beatmap being added
+    to is already unusable and no seed can change that, while ``REJOINED`` means
+    this interval's own events did not splice cleanly.
+    """
+
+    def __init__(
+            self,
+            *,
+            scope: str,
+            partial_start_ms: int | None,
+            partial_end_ms: int | None,
+            validation_error: str,
+            earliest_generated_source_window_id: int | None = None,
+    ) -> None:
+        if type(scope) is not str or scope not in _MANIA_PARTIAL_REJOIN_SCOPES:
+            raise ValueError(f"unsupported partial rejoin scope: {scope!r}")
+        if type(validation_error) is not str or not validation_error:
+            raise ValueError("validation_error must be a non-empty exact str")
+        for name, value in (
+                ("partial_start_ms", partial_start_ms),
+                ("partial_end_ms", partial_end_ms),
+                (
+                    "earliest_generated_source_window_id",
+                    earliest_generated_source_window_id,
+                ),
+        ):
+            if value is not None and type(value) is not int:
+                raise TypeError(f"{name} must be an exact int or None")
+        if (
+                earliest_generated_source_window_id is not None
+                and not 0 <= earliest_generated_source_window_id <= _MAX_TAIL_WINDOW_ID
+        ):
+            raise ValueError("earliest source window is outside the protocol")
+        self.scope = scope
+        self.partial_start_ms = partial_start_ms
+        self.partial_end_ms = partial_end_ms
+        self.validation_error = validation_error[
+            :_MAX_PARTIAL_VALIDATION_ERROR_CHARS
+        ]
+        self.earliest_generated_source_window_id = (
+            earliest_generated_source_window_id
+        )
+        # Keep the message each entry point already produced: an interval with
+        # no end boundary is exactly what finalize_mania_partial_start commits.
+        entry_point = (
+            "partial interval" if partial_end_ms is not None else "partial start"
+        )
+        super().__init__(f"{entry_point} rejoin invalid: {validation_error}")
+
+    def to_terminal_record(self) -> dict[str, object]:
+        return {
+            "version": 1,
+            "status": "FAILURE",
+            "code": "MANIA_PARTIAL_REJOIN_INVALID",
+            "context": {
+                "scope": self.scope,
+                "partialStartMs": self.partial_start_ms,
+                "partialEndMs": self.partial_end_ms,
+                "validationError": self.validation_error,
+                "earliestGeneratedSourceWindowId": (
+                    self.earliest_generated_source_window_id
+                ),
+            },
+        }
+
+
+def _format_terminal_line(record: dict[str, object]) -> str:
+    payload = json.dumps(
+        record,
+        sort_keys=True,
+        separators=(",", ":"),
+        ensure_ascii=True,
+        allow_nan=False,
+    )
+    return MAPPERATORINATOR_INVOCATION_RESULT_PREFIX + payload
+
+
+def run_with_mania_tail_terminal(
+        operation: Callable[[], _T],
+        *,
+        stream: TextIO,
+) -> _T:
+    """Convert only definitive Mania failures into one flushed nonzero terminal."""
+    try:
+        return operation()
+    except ManiaTailRepairExhausted as error:
+        print(format_mania_tail_terminal_line(error), file=stream, flush=True)
+        raise SystemExit(1) from error
+    except ManiaPartialRejoinInvalid as error:
+        print(
+            _format_terminal_line(error.to_terminal_record()),
+            file=stream,
+            flush=True,
+        )
+        raise SystemExit(1) from error
+
+
+@dataclass(frozen=True, slots=True)
+class ManiaTailIssue:
+    reason: ManiaTailReason
+    lane: int
+    start_time_ms: int | None
+    end_time_ms: int | None
+    start_origins: tuple[EventOrigin, ...]
+    event_type: str | None = None
+    end_origins: tuple[EventOrigin, ...] = ()
+
+    def to_dict(self) -> dict[str, object]:
+        return {
+            "reason": self.reason,
+            "lane": self.lane,
+            "startTimeMs": self.start_time_ms,
+            "endTimeMs": self.end_time_ms,
+            "eventType": self.event_type,
+            "startOrigins": [origin.to_dict() for origin in self.start_origins],
+            "endOrigins": [origin.to_dict() for origin in self.end_origins],
+        }
+
+
+class ManiaTailRepairRequired(ValueError):
+    """Typed signal that a retained Mania tail cannot be published safely."""
+
+    def __init__(
+            self,
+            *,
+            reason: ManiaTailReason,
+            requested_end_ms: int,
+            effective_cut_ms: int,
+            issues: Sequence[ManiaTailIssue],
+            validation_error: str,
+    ) -> None:
+        self.reason = reason
+        self.requested_end_ms = requested_end_ms
+        self.effective_cut_ms = effective_cut_ms
+        self.issues = tuple(issues)
+        self.validation_error = validation_error
+        generated_windows = [
+            origin.source_window_id
+            for issue in self.issues
+            for origin in issue.start_origins + issue.end_origins
+            if origin.kind == "GENERATED" and origin.source_window_id is not None
+        ]
+        self.earliest_generated_source_window_id = (
+            min(generated_windows) if generated_windows else None
+        )
+        super().__init__(str(self.to_dict()))
+
+    def to_dict(self) -> dict[str, object]:
+        return {
+            "version": 1,
+            "reason": self.reason,
+            "requestedEndMs": self.requested_end_ms,
+            "effectiveCutMs": self.effective_cut_ms,
+            "earliestGeneratedSourceWindowId": (
+                self.earliest_generated_source_window_id
+            ),
+            "validationError": self.validation_error,
+            "issues": [issue.to_dict() for issue in self.issues],
+        }
+
+
+@dataclass(frozen=True, slots=True)
+class _ManiaInspection:
+    groups: tuple[CanonicalManiaGroup, ...]
+    pairs: tuple[tuple[CanonicalManiaGroup, CanonicalManiaGroup], ...]
+    open_starts: tuple[CanonicalManiaGroup, ...]
+    orphan_ends: tuple[CanonicalManiaGroup, ...]
+    signature_origins: tuple[
+        tuple[tuple[int, int, EventType], tuple[EventOrigin, ...]], ...
+    ]
+    invalid_issues: tuple[ManiaTailIssue, ...]
+    validation_error: str | None
+
+    @property
+    def is_closed(self) -> bool:
+        return self.validation_error is None
+
+    def origins_for(
+            self,
+            group: CanonicalManiaGroup,
+    ) -> tuple[EventOrigin, ...]:
+        return next(
+            (
+                origins
+                for signature, origins in self.signature_origins
+                if signature == group.signature
+            ),
+            (),
+        )
+
+
+def _ordered_unique_groups(
+        groups: Sequence[CanonicalManiaGroup],
+) -> tuple[CanonicalManiaGroup, ...]:
+    order = {
+        EventType.HOLD_NOTE_END: 0,
+        EventType.HOLD_NOTE: 1,
+        EventType.CIRCLE: 2,
+    }
+    unique: dict[tuple[int, int, EventType], CanonicalManiaGroup] = {}
+    for group in groups:
+        unique.setdefault(group.signature, group)
+    return tuple(sorted(
+        unique.values(),
+        key=lambda group: (group.time_ms, group.lane, order[group.event_type]),
+    ))
+
+
+def _origins_for_group(
+        group: CanonicalManiaGroup,
+        event_origins: Sequence[EventOrigin],
+) -> tuple[EventOrigin, ...]:
+    origins: list[EventOrigin] = []
+    for index in group.event_indices:
+        origin = event_origins[index]
+        if origin not in origins:
+            origins.append(origin)
+    return tuple(origins)
+
+
+def open_hold_origin_windows(
+        events: Sequence[Event],
+        event_times: Sequence[float],
+        event_origins: Sequence[EventOrigin],
+        *,
+        keycount: int,
+) -> dict[int, int]:
+    """Map every still-open HOLD lane to the window that generated its start.
+
+    Only GENERATED provenance is reported: a repair rewinds generation, so a
+    reference-owned HOLD start cannot be changed by rewinding and must not be
+    offered as a repair target.
+    """
+    try:
+        groups = canonical_mania_groups(events, event_times, keycount=keycount)
+    except ValueError:
+        return {}
+    active: dict[int, CanonicalManiaGroup] = {}
+    for group in _ordered_unique_groups(groups):
+        if group.event_type == EventType.HOLD_NOTE:
+            active[group.lane] = group
+        elif group.event_type == EventType.HOLD_NOTE_END:
+            active.pop(group.lane, None)
+    windows: dict[int, int] = {}
+    for lane, group in active.items():
+        generated = [
+            origin.source_window_id
+            for origin in _origins_for_group(group, event_origins)
+            if origin.kind == "GENERATED" and origin.source_window_id is not None
+        ]
+        if generated:
+            windows[lane] = min(generated)
+    return windows
+
+
+# Only these reasons can be caused by a HOLD that an earlier window left open.
+# INCOMPLETE_MANIA_GROUP_BEFORE_SCROLL is a serialization boundary fault that a
+# rewind past the detection window would not address.
+_HOLD_IMPLICATING_DOMAIN_REASONS = frozenset({
+    "INSUFFICIENT_HOLD_CLOSURE_BUDGET",
+    "NO_LEGAL_MANIA_GROUP_COMPLETION",
+})
+
+
+def mania_domain_fault_window(
+        error: ManiaDomainError,
+        open_hold_windows: Mapping[int, int],
+) -> int | None:
+    """Earliest window that opened a HOLD this error blames, else None.
+
+    ``source_window_id`` records where the grammar noticed the problem.  When an
+    open HOLD is what made the window undecodable, the window that opened it is
+    the fault, and a repair that starts after it freezes the fault in place.
+    """
+    if not open_hold_windows:
+        return None
+    reason = error.reason
+    if reason not in _HOLD_IMPLICATING_DOMAIN_REASONS:
+        return None
+    if reason == "INSUFFICIENT_HOLD_CLOSURE_BUDGET":
+        declared = error.context.get("openLanes")
+        blamed = (
+            [lane for lane in declared if lane in open_hold_windows]
+            if isinstance(declared, (list, tuple))
+            else list(open_hold_windows)
+        )
+    else:
+        blamed = [error.lane] if error.lane in open_hold_windows else []
+    windows = [open_hold_windows[lane] for lane in blamed]
+    return min(windows) if windows else None
+
+
+def _invalid_group_issue(
+        group: CanonicalManiaGroup,
+        event_origins: Sequence[EventOrigin],
+) -> ManiaTailIssue:
+    return ManiaTailIssue(
+        reason="PRE_TRIM_INVALID",
+        lane=group.lane,
+        start_time_ms=group.time_ms,
+        end_time_ms=None,
+        start_origins=_origins_for_group(group, event_origins),
+        event_type=group.event_type.name,
+    )
+
+
+def _first_structural_issue(
+        events: Sequence[Event],
+        event_times: Sequence[float],
+        event_origins: Sequence[EventOrigin],
+        *,
+        keycount: int,
+) -> tuple[int | None, ManiaTailIssue | None]:
+    """Locate parser-invalid gameplay provenance without parsing error text."""
+    pending_lane: int | None = None
+    pending_indices: list[int] = []
+    pending_time_ms: int | None = None
+
+    def incomplete() -> tuple[int, ManiaTailIssue]:
+        first_index = pending_indices[0]
+        origins: list[EventOrigin] = []
+        for index in pending_indices:
+            origin = event_origins[index]
+            if origin not in origins:
+                origins.append(origin)
+        return first_index, ManiaTailIssue(
+            reason="PRE_TRIM_INVALID",
+            lane=pending_lane if pending_lane is not None else -1,
+            start_time_ms=pending_time_ms,
+            end_time_ms=None,
+            start_origins=tuple(origins),
+            event_type="INCOMPLETE_GROUP",
+        )
+
+    for index, event in enumerate(events):
+        if event.type == EventType.TIME_SHIFT:
+            if pending_lane is not None:
+                return incomplete()
+            continue
+        if event.type == EventType.MANIA_COLUMN:
+            if pending_lane is not None:
+                return incomplete()
+            pending_lane = int(event.value)
+            pending_indices = [index]
+            pending_time_ms = int(round(event_times[index]))
+            if not 0 <= pending_lane < keycount:
+                return incomplete()
+            continue
+        if event.type in {
+                EventType.CIRCLE,
+                EventType.HOLD_NOTE,
+                EventType.HOLD_NOTE_END,
+        }:
+            if pending_lane is None:
+                origin = event_origins[index]
+                time_ms = int(round(event_times[index]))
+                return index, ManiaTailIssue(
+                    reason="PRE_TRIM_INVALID",
+                    lane=-1,
+                    start_time_ms=(
+                        None
+                        if event.type == EventType.HOLD_NOTE_END
+                        else time_ms
+                    ),
+                    end_time_ms=(
+                        time_ms
+                        if event.type == EventType.HOLD_NOTE_END
+                        else None
+                    ),
+                    start_origins=(
+                        ()
+                        if event.type == EventType.HOLD_NOTE_END
+                        else (origin,)
+                    ),
+                    event_type=event.type.name,
+                    end_origins=(
+                        (origin,)
+                        if event.type == EventType.HOLD_NOTE_END
+                        else ()
+                    ),
+                )
+            pending_indices.append(index)
+            pending_lane = None
+            pending_indices = []
+            pending_time_ms = None
+            continue
+        if event.type in MANIA_SUSTAIN_TYPES:
+            if pending_lane is None:
+                return index, ManiaTailIssue(
+                    reason="PRE_TRIM_INVALID",
+                    lane=-1,
+                    start_time_ms=int(round(event_times[index])),
+                    end_time_ms=None,
+                    start_origins=(event_origins[index],),
+                    event_type=event.type.name,
+                )
+            pending_lane = None
+            pending_indices = []
+            pending_time_ms = None
+            continue
+        if pending_lane is not None and event.type in TYPE_EVENTS:
+            return incomplete()
+        if pending_lane is not None:
+            pending_indices.append(index)
+
+    if pending_lane is not None:
+        return incomplete()
+    return None, None
+
+
+def _inspect_mania_stream(
+        events: Sequence[Event],
+        event_times: Sequence[float],
+        event_origins: Sequence[EventOrigin],
+        *,
+        keycount: int,
+) -> _ManiaInspection:
+    structural_index, structural_issue = _first_structural_issue(
+        events,
+        event_times,
+        event_origins,
+        keycount=keycount,
+    )
+    parse_error: str | None = None
+    try:
+        groups = canonical_mania_groups(
+            events,
+            event_times,
+            keycount=keycount,
+        )
+    except ValueError as error:
+        parse_error = str(error)
+        if structural_index is None:
+            groups = []
+        else:
+            try:
+                groups = canonical_mania_groups(
+                    events[:structural_index],
+                    event_times[:structural_index],
+                    keycount=keycount,
+                )
+            except ValueError:
+                groups = []
+
+    ordered_groups = _ordered_unique_groups(groups)
+    origins_by_signature: dict[
+        tuple[int, int, EventType], list[EventOrigin]
+    ] = {}
+    for group in groups:
+        signature_origins = origins_by_signature.setdefault(group.signature, [])
+        for index in group.event_indices:
+            origin = event_origins[index]
+            if origin not in signature_origins:
+                signature_origins.append(origin)
+    signature_origins = tuple(
+        (group.signature, tuple(origins_by_signature[group.signature]))
+        for group in ordered_groups
+    )
+    invalid_issues: list[ManiaTailIssue] = []
+    if structural_issue is not None:
+        invalid_issues.append(structural_issue)
+
+    generated_windows_by_signature: dict[
+        tuple[int, int, EventType], set[int]
+    ] = {}
+    for group in groups:
+        current_windows = {
+            origin.source_window_id
+            for origin in _origins_for_group(group, event_origins)
+            if origin.kind == "GENERATED" and origin.source_window_id is not None
+        }
+        previous_windows = generated_windows_by_signature.get(group.signature)
+        if previous_windows is None:
+            generated_windows_by_signature[group.signature] = set(current_windows)
+            continue
+        if (
+                previous_windows
+                and current_windows
+                and previous_windows.isdisjoint(current_windows)
+        ):
+            previous_windows.update(current_windows)
+            continue
+        invalid_issues.append(_invalid_group_issue(group, event_origins))
+
+    active: dict[int, CanonicalManiaGroup] = {}
+    pairs: list[tuple[CanonicalManiaGroup, CanonicalManiaGroup]] = []
+    orphan_ends: list[CanonicalManiaGroup] = []
+    for group in ordered_groups:
+        if group.event_type == EventType.HOLD_NOTE:
+            if group.lane in active:
+                invalid_issues.append(
+                    _invalid_group_issue(group, event_origins)
+                )
+            else:
+                active[group.lane] = group
+        elif group.event_type == EventType.HOLD_NOTE_END:
+            start = active.pop(group.lane, None)
+            if start is None:
+                orphan_ends.append(group)
+            else:
+                pairs.append((start, group))
+        elif group.event_type == EventType.CIRCLE and group.lane in active:
+            invalid_issues.append(_invalid_group_issue(group, event_origins))
+
+    open_starts = tuple(active[lane] for lane in sorted(active))
+    validation_error = parse_error
+    open_lanes = tuple(sorted(active))
+    if validation_error is None:
+        try:
+            open_lanes = replay_mania_hold_state(groups, keycount=keycount)
+        except ValueError as error:
+            validation_error = str(error)
+    if validation_error is None and invalid_issues:
+        validation_error = "retained mania stream has invalid gameplay groups"
+    if validation_error is None and open_lanes:
+        validation_error = (
+            "retained mania stream has unclosed HOLD lanes: "
+            f"{list(open_lanes)}"
+        )
+    return _ManiaInspection(
+        ordered_groups,
+        tuple(pairs),
+        open_starts,
+        tuple(orphan_ends),
+        signature_origins,
+        tuple(invalid_issues),
+        validation_error,
+    )
+
+
+def _generated_windows(origins: Sequence[EventOrigin]) -> list[int]:
+    return [
+        origin.source_window_id
+        for origin in origins
+        if origin.kind == "GENERATED" and origin.source_window_id is not None
+    ]
+
+
+def _earliest_generated_window(inspection: _ManiaInspection) -> int | None:
+    """Earliest GENERATED window among the groups that made a stream invalid.
+
+    Reference-owned groups are skipped: a rewind cannot change them, so they are
+    not a repair target a caller could act on.
+    """
+    windows: list[int] = []
+    for group in inspection.open_starts + inspection.orphan_ends:
+        windows += _generated_windows(inspection.origins_for(group))
+    for issue in inspection.invalid_issues:
+        windows += _generated_windows(issue.start_origins + issue.end_origins)
+    return min(windows) if windows else None
+
+
+def _issue_for_pair(
+        pair: tuple[CanonicalManiaGroup, CanonicalManiaGroup],
+        inspection: _ManiaInspection,
+) -> ManiaTailIssue:
+    start, end = pair
+    return ManiaTailIssue(
+        reason="END_BOUNDARY_CROSSES_HOLD",
+        lane=start.lane,
+        start_time_ms=start.time_ms,
+        end_time_ms=end.time_ms,
+        start_origins=inspection.origins_for(start),
+        event_type=start.event_type.name,
+        end_origins=inspection.origins_for(end),
+    )
+
+
+def _issue_for_open_start(
+        start: CanonicalManiaGroup,
+        inspection: _ManiaInspection,
+) -> ManiaTailIssue:
+    return ManiaTailIssue(
+        reason="PRE_TRIM_INVALID",
+        lane=start.lane,
+        start_time_ms=start.time_ms,
+        end_time_ms=None,
+        start_origins=inspection.origins_for(start),
+        event_type=start.event_type.name,
+    )
+
+
+def _issue_for_unclosed_start(
+        start: CanonicalManiaGroup,
+        inspection: _ManiaInspection,
+) -> ManiaTailIssue:
+    return ManiaTailIssue(
+        reason="UNCLOSED_HOLD_AT_STREAM_END",
+        lane=start.lane,
+        start_time_ms=start.time_ms,
+        end_time_ms=None,
+        start_origins=inspection.origins_for(start),
+        event_type=start.event_type.name,
+    )
+
+
+def _issue_for_orphan_end(
+        end: CanonicalManiaGroup,
+        inspection: _ManiaInspection,
+) -> ManiaTailIssue:
+    return ManiaTailIssue(
+        reason="PRE_TRIM_INVALID",
+        lane=end.lane,
+        start_time_ms=None,
+        end_time_ms=end.time_ms,
+        start_origins=(),
+        event_type=end.event_type.name,
+        end_origins=inspection.origins_for(end),
+    )
+
+
+def _crop_serialization_groups(
+        events: list[Event],
+        event_times: list[float],
+        event_origins: list[EventOrigin],
+        *,
+        effective_cut_ms: int,
+        types_first: bool,
+) -> None:
+    if types_first:
+        raise ValueError(
+            "transactional Mania tail finalization does not support types_first=True"
+        )
+
+    if not any(event.type == EventType.MANIA_COLUMN for event in events):
+        remove_indices = {
+            index
+            for index, time_ms in enumerate(event_times)
+            if time_ms > effective_cut_ms
+        }
+    else:
+        serialization_groups: list[tuple[float, tuple[int, ...]]] = []
+        pending_indices: list[int] = []
+        for index, event in enumerate(events):
+            pending_indices.append(index)
+            if event.type in TYPE_EVENTS:
+                serialization_groups.append((
+                    event_times[index],
+                    tuple(pending_indices),
+                ))
+                pending_indices = []
+        if pending_indices:
+            serialization_groups.append((
+                event_times[pending_indices[-1]],
+                tuple(pending_indices),
+            ))
+
+        remove_indices = {
+            index
+            for group_time, indices in serialization_groups
+            if group_time > effective_cut_ms
+            for index in indices
+        }
+    for index in sorted(remove_indices, reverse=True):
+        del events[index]
+        del event_times[index]
+        del event_origins[index]
+
+
+def _complete_serialization_groups(
+        events: Sequence[Event],
+        event_times: Sequence[float],
+        *,
+        types_first: bool,
+) -> tuple[tuple[float, tuple[int, ...]], ...]:
+    if types_first:
+        raise ValueError(
+            "transactional Mania start rejoin does not support types_first=True"
+        )
+    if len(events) != len(event_times):
+        raise ValueError("events and event_times must have equal length")
+
+    groups: list[tuple[float, tuple[int, ...]]] = []
+    pending_indices: list[int] = []
+    for index, event in enumerate(events):
+        pending_indices.append(index)
+        if event.type in TYPE_EVENTS:
+            groups.append((event_times[index], tuple(pending_indices)))
+            pending_indices = []
+    if pending_indices:
+        if any(
+                events[index].type == EventType.MANIA_COLUMN
+                for index in pending_indices
+        ):
+            raise ValueError("incomplete serialization group at end of stream")
+        if not groups:
+            raise ValueError(
+                "trailing metadata has no complete serialization group"
+            )
+        group_time, group_indices = groups[-1]
+        groups[-1] = (
+            group_time,
+            group_indices + tuple(pending_indices),
+        )
+    return tuple(groups)
+
+
+def finalize_mania_partial_interval(
+        current_events: list[Event],
+        current_times: list[float],
+        current_origins: list[EventOrigin],
+        reference_events: Sequence[Event],
+        reference_times: Sequence[float],
+        reference_origins: Sequence[EventOrigin],
+        *,
+        start_time_ms: int | None,
+        end_time_ms: int | None,
+        keycount: int,
+        types_first: bool,
+) -> None:
+    """Commit one owned partial interval only after a closed canonical replay."""
+    try:
+        if not (
+                len(current_events)
+                == len(current_times)
+                == len(current_origins)
+        ):
+            raise ValueError(
+                "current events, event_times, and origins must have equal length"
+            )
+        if not (
+                len(reference_events)
+                == len(reference_times)
+                == len(reference_origins)
+        ):
+            raise ValueError(
+                "reference events, event_times, and origins must have equal length"
+            )
+        if keycount <= 0:
+            raise ValueError(f"mania keycount must be positive: {keycount}")
+        if start_time_ms is None and end_time_ms is None:
+            raise ValueError("partial interval requires a start or end boundary")
+        if (
+                start_time_ms is not None
+                and end_time_ms is not None
+                and start_time_ms > end_time_ms
+        ):
+            raise ValueError(
+                f"partial interval start exceeds end: "
+                f"{start_time_ms}>{end_time_ms}"
+            )
+
+        reference_groups = _complete_serialization_groups(
+            reference_events,
+            reference_times,
+            types_first=types_first,
+        )
+        current_groups = _complete_serialization_groups(
+            current_events,
+            current_times,
+            types_first=types_first,
+        )
+
+        reference_inspection = _inspect_mania_stream(
+            reference_events,
+            reference_times,
+            reference_origins,
+            keycount=keycount,
+        )
+        if end_time_ms is not None and not reference_inspection.is_closed:
+            raise ManiaPartialRejoinInvalid(
+                scope="REFERENCE",
+                partial_start_ms=start_time_ms,
+                partial_end_ms=end_time_ms,
+                validation_error=(
+                    "reference Mania stream is invalid: "
+                    f"{reference_inspection.validation_error}"
+                ),
+                earliest_generated_source_window_id=_earliest_generated_window(
+                    reference_inspection
+                ),
+            )
+        crossing_end_indices = {
+            index
+            for start, end in reference_inspection.pairs
+            if (
+                end_time_ms is not None
+                and start.time_ms <= end_time_ms < end.time_ms
+            )
+            for index in end.event_indices
+        }
+
+        reference_prefix_indices = tuple(
+            index
+            for group_time, indices in reference_groups
+            if start_time_ms is not None and group_time <= start_time_ms
+            for index in indices
+        )
+        current_indices = tuple(
+            index
+            for group_time, indices in current_groups
+            if (start_time_ms is None or group_time > start_time_ms)
+            and (end_time_ms is None or group_time <= end_time_ms)
+            for index in indices
+        )
+        reference_suffix_indices = tuple(
+            index
+            for group_time, indices in reference_groups
+            if end_time_ms is not None
+            and group_time > end_time_ms
+            and crossing_end_indices.isdisjoint(indices)
+            for index in indices
+        )
+        candidate_events = [
+            reference_events[index] for index in reference_prefix_indices
+        ] + [
+            current_events[index] for index in current_indices
+        ] + [
+            reference_events[index] for index in reference_suffix_indices
+        ]
+        candidate_times = [
+            reference_times[index] for index in reference_prefix_indices
+        ] + [
+            current_times[index] for index in current_indices
+        ] + [
+            reference_times[index] for index in reference_suffix_indices
+        ]
+        candidate_origins = [
+            reference_origins[index] for index in reference_prefix_indices
+        ] + [
+            current_origins[index] for index in current_indices
+        ] + [
+            reference_origins[index] for index in reference_suffix_indices
+        ]
+
+        candidate_inspection = _inspect_mania_stream(
+            candidate_events,
+            candidate_times,
+            candidate_origins,
+            keycount=keycount,
+        )
+        if not candidate_inspection.is_closed:
+            raise ManiaPartialRejoinInvalid(
+                scope="REJOINED",
+                partial_start_ms=start_time_ms,
+                partial_end_ms=end_time_ms,
+                validation_error=(
+                    "rejoined Mania stream is invalid: "
+                    f"{candidate_inspection.validation_error}"
+                ),
+                earliest_generated_source_window_id=_earliest_generated_window(
+                    candidate_inspection
+                ),
+            )
+    except ManiaPartialRejoinInvalid:
+        raise
+    except ValueError as error:
+        raise ValueError(f"partial interval rejoin invalid: {error}") from error
+
+    current_events[:] = candidate_events
+    current_times[:] = candidate_times
+    current_origins[:] = candidate_origins
+
+
+def finalize_mania_partial_start(
+        current_events: list[Event],
+        current_times: list[float],
+        current_origins: list[EventOrigin],
+        reference_events: Sequence[Event],
+        reference_times: Sequence[float],
+        reference_origins: Sequence[EventOrigin],
+        *,
+        start_time_ms: int,
+        keycount: int,
+        types_first: bool,
+) -> None:
+    """Compatibility wrapper for a start-only partial interval."""
+    try:
+        finalize_mania_partial_interval(
+            current_events,
+            current_times,
+            current_origins,
+            reference_events,
+            reference_times,
+            reference_origins,
+            start_time_ms=start_time_ms,
+            end_time_ms=None,
+            keycount=keycount,
+            types_first=types_first,
+        )
+    except ManiaPartialRejoinInvalid:
+        # A typed partial failure is the terminal result itself; re-wrapping it
+        # as a plain ValueError would put it back outside the typed path.
+        raise
+    except ValueError as error:
+        detail = str(error)
+        prefix = "partial interval rejoin invalid: "
+        if detail.startswith(prefix):
+            detail = detail[len(prefix):]
+        raise ValueError(f"partial start rejoin invalid: {detail}") from error
+
+
+def validate_mania_stream_end(
+        events: Sequence[Event],
+        event_times: Sequence[float],
+        event_origins: Sequence[EventOrigin],
+        *,
+        song_end_ms: int,
+        keycount: int,
+        types_first: bool,
+) -> None:
+    """Require a complete, closed Mania stream without mutating caller data."""
+    boundary_ms = (
+        song_end_ms
+        if type(song_end_ms) is int and song_end_ms >= 0
+        else 0
+    )
+
+    def reject(validation_error: str) -> NoReturn:
+        raise ManiaTailRepairRequired(
+            reason="PRE_TRIM_INVALID",
+            requested_end_ms=boundary_ms,
+            effective_cut_ms=boundary_ms,
+            issues=(),
+            validation_error=validation_error,
+        )
+
+    if type(song_end_ms) is not int or song_end_ms < 0:
+        reject("song_end_ms must be an exact non-negative int")
+    if type(keycount) is not int or keycount <= 0:
+        reject("mania keycount must be positive and have exact int type")
+    if type(types_first) is not bool:
+        reject("types_first must be an exact bool")
+    if types_first:
+        reject(
+            "transactional Mania stream-end validation does not support "
+            "types_first=True"
+        )
+
+    try:
+        normalized_events = tuple(events)
+        normalized_times = tuple(event_times)
+        normalized_origins = tuple(event_origins)
+    except Exception as error:
+        reject(
+            "events, event_times, and event_origins must be finite sequences; "
+            f"normalization failed with {type(error).__name__}"
+        )
+    if not (
+            len(normalized_events)
+            == len(normalized_times)
+            == len(normalized_origins)
+    ):
+        reject("events, event_times, and event_origins must have equal length")
+
+    def finite_real(value: object) -> bool:
+        if isinstance(value, bool) or not isinstance(value, Real):
+            return False
+        try:
+            return math.isfinite(value)
+        except (OverflowError, TypeError, ValueError):
+            return False
+
+    for index, event in enumerate(normalized_events):
+        if not isinstance(event, Event) or not isinstance(event.type, EventType):
+            reject(f"events[{index}] must be an Event with a valid EventType")
+        if event.type == EventType.TIME_SHIFT and not finite_real(event.value):
+            reject(f"events[{index}] TIME_SHIFT value must be finite numeric")
+        if (
+                event.type == EventType.MANIA_COLUMN
+                and type(event.value) is not int
+        ):
+            reject(f"events[{index}] MANIA_COLUMN value must be an exact int")
+    for index, time_ms in enumerate(normalized_times):
+        if not finite_real(time_ms):
+            reject(f"event_times[{index}] must be finite numeric")
+
+    def nonnegative_exact_int(value: object) -> bool:
+        return type(value) is int and value >= 0
+
+    for index, origin in enumerate(normalized_origins):
+        if not isinstance(origin, EventOrigin):
+            reject(f"event_origins[{index}] must be an EventOrigin")
+        if type(origin.kind) is not str or origin.kind not in (
+                "GENERATED",
+                "REFERENCE",
+        ):
+            reject(
+                f"event_origins[{index}] kind must be exactly "
+                "GENERATED or REFERENCE"
+            )
+        if origin.kind == "GENERATED":
+            if not nonnegative_exact_int(origin.source_window_id):
+                reject(
+                    f"event_origins[{index}] GENERATED source_window_id "
+                    "must be an exact non-negative int"
+                )
+            if not nonnegative_exact_int(origin.source_token_index):
+                reject(
+                    f"event_origins[{index}] GENERATED source_token_index "
+                    "must be an exact non-negative int"
+                )
+            if origin.reference_event_index is not None:
+                reject(
+                    f"event_origins[{index}] GENERATED "
+                    "reference_event_index must be None"
+                )
+        else:
+            if (
+                    origin.source_window_id is not None
+                    or origin.source_token_index is not None
+            ):
+                reject(
+                    f"event_origins[{index}] REFERENCE source window/token "
+                    "indices must be None"
+                )
+            if not nonnegative_exact_int(origin.reference_event_index):
+                reject(
+                    f"event_origins[{index}] REFERENCE "
+                    "reference_event_index must be an exact non-negative int"
+                )
+
+    try:
+        inspection = _inspect_mania_stream(
+            normalized_events,
+            normalized_times,
+            normalized_origins,
+            keycount=keycount,
+        )
+    except (AttributeError, IndexError, TypeError, ValueError) as error:
+        reject(
+            "mania stream inspection failed with "
+            f"{type(error).__name__}"
+        )
+    unclosed_issues = tuple(
+        _issue_for_unclosed_start(start, inspection)
+        for start in inspection.open_starts
+    )
+    invalid_issues = inspection.invalid_issues + tuple(
+        _issue_for_orphan_end(end, inspection)
+        for end in inspection.orphan_ends
+    )
+    if not invalid_issues and not unclosed_issues:
+        if inspection.validation_error is None:
+            return
+        raise ManiaTailRepairRequired(
+            reason="PRE_TRIM_INVALID",
+            requested_end_ms=song_end_ms,
+            effective_cut_ms=song_end_ms,
+            issues=(),
+            validation_error=inspection.validation_error,
+        )
+
+    issues = tuple(sorted(
+        unclosed_issues + invalid_issues,
+        key=lambda issue: (
+            issue.lane,
+            issue.start_time_ms
+            if issue.start_time_ms is not None
+            else issue.end_time_ms,
+            issue.reason,
+        ),
+    ))
+    reason: ManiaTailReason = (
+        "PRE_TRIM_INVALID"
+        if invalid_issues
+        else "UNCLOSED_HOLD_AT_STREAM_END"
+    )
+    raise ManiaTailRepairRequired(
+        reason=reason,
+        requested_end_ms=song_end_ms,
+        effective_cut_ms=song_end_ms,
+        issues=issues,
+        validation_error=(
+            inspection.validation_error
+            or "mania stream ended with invalid gameplay state"
+        ),
+    )
+
+
+def finalize_mania_end_boundary(
+        events: list[Event],
+        event_times: list[float],
+        event_origins: list[EventOrigin],
+        *,
+        requested_end_ms: int,
+        effective_cut_ms: int,
+        keycount: int,
+        types_first: bool,
+) -> None:
+    """Crop a final Mania MAP stream and commit only if its retained replay closes."""
+    if not (len(events) == len(event_times) == len(event_origins)):
+        raise ManiaTailRepairRequired(
+            reason="PRE_TRIM_INVALID",
+            requested_end_ms=requested_end_ms,
+            effective_cut_ms=effective_cut_ms,
+            issues=(),
+            validation_error=(
+                "events, event_times, and event_origins must have equal length"
+            ),
+        )
+    if keycount <= 0:
+        raise ManiaTailRepairRequired(
+            reason="PRE_TRIM_INVALID",
+            requested_end_ms=requested_end_ms,
+            effective_cut_ms=effective_cut_ms,
+            issues=(),
+            validation_error=f"mania keycount must be positive: {keycount}",
+        )
+    if types_first:
+        raise ManiaTailRepairRequired(
+            reason="PRE_TRIM_INVALID",
+            requested_end_ms=requested_end_ms,
+            effective_cut_ms=effective_cut_ms,
+            issues=(),
+            validation_error=(
+                "transactional Mania tail finalization does not support "
+                "types_first=True"
+            ),
+        )
+
+    candidate_events = list(events)
+    candidate_times = list(event_times)
+    candidate_origins = list(event_origins)
+    try:
+        _crop_serialization_groups(
+            candidate_events,
+            candidate_times,
+            candidate_origins,
+            effective_cut_ms=effective_cut_ms,
+            types_first=types_first,
+        )
+    except (IndexError, ValueError) as error:
+        raise ManiaTailRepairRequired(
+            reason="PRE_TRIM_INVALID",
+            requested_end_ms=requested_end_ms,
+            effective_cut_ms=effective_cut_ms,
+            issues=(),
+            validation_error=str(error),
+        ) from error
+
+    retained = _inspect_mania_stream(
+        candidate_events,
+        candidate_times,
+        candidate_origins,
+        keycount=keycount,
+    )
+    if retained.is_closed:
+        events[:] = candidate_events
+        event_times[:] = candidate_times
+        event_origins[:] = candidate_origins
+        return
+
+    original = _inspect_mania_stream(
+        events,
+        event_times,
+        event_origins,
+        keycount=keycount,
+    )
+    retained_open_signatures = {
+        start.signature for start in retained.open_starts
+    }
+    crossing_pairs = tuple(
+        pair
+        for pair in original.pairs
+        if (
+            pair[0].signature in retained_open_signatures
+            and pair[0].time_ms <= effective_cut_ms < pair[1].time_ms
+        )
+    )
+    crossing_start_signatures = {
+        pair[0].signature for pair in crossing_pairs
+    }
+    crossing_issues = tuple(
+        _issue_for_pair(pair, original)
+        for pair in crossing_pairs
+    )
+    pre_trim_issues = tuple(
+        _issue_for_open_start(start, retained)
+        for start in retained.open_starts
+        if start.signature not in crossing_start_signatures
+    ) + tuple(
+        _issue_for_orphan_end(end, retained)
+        for end in retained.orphan_ends
+    ) + retained.invalid_issues
+    reason: ManiaTailReason = (
+        "PRE_TRIM_INVALID"
+        if pre_trim_issues or not crossing_issues
+        else "END_BOUNDARY_CROSSES_HOLD"
+    )
+    issues = crossing_issues + pre_trim_issues
+    issues = tuple(sorted(
+        issues,
+        key=lambda issue: (
+            issue.lane,
+            issue.start_time_ms
+            if issue.start_time_ms is not None
+            else issue.end_time_ms,
+        ),
+    ))
+    raise ManiaTailRepairRequired(
+        reason=reason,
+        requested_end_ms=requested_end_ms,
+        effective_cut_ms=effective_cut_ms,
+        issues=issues,
+        validation_error=(
+            retained.validation_error or "retained mania stream is invalid"
+        ),
+    )
