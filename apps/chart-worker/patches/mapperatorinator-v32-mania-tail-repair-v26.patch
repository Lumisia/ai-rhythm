+    @staticmethod
+    def _hash_tensor(hasher: Any, label: str, tensor: torch.Tensor) -> None:
+        value = tensor.detach().cpu().contiguous()
+        byte_view = (
+            value.reshape(1).view(torch.uint8)
+            if value.ndim == 0
+            else value.view(torch.uint8)
+        )
+        hasher.update(label.encode("utf-8"))
+        hasher.update(str(value.dtype).encode("ascii"))
+        hasher.update(json.dumps(list(value.shape)).encode("ascii"))
+        hasher.update(byte_view.numpy().tobytes(order="C"))
+
+    def _mania_tail_identity_digest(
+            self,
+            *,
+            sequences: tuple[torch.Tensor, torch.Tensor, float],
+            in_context: list[dict[str, Any]],
+            out_context: list[dict[str, Any]],
+            model_kwargs: dict[str, Any],
+            mania_keycount: int,
+    ) -> str:
+        """Bind RAM-only checkpoints to this exact one-shot invocation."""
+        hasher = hashlib.sha256(b"osuT5-mania-tail-invocation-v1\0")
+        self._hash_tensor(hasher, "frames", sequences[0])
+        self._hash_tensor(hasher, "frame-times", sequences[1])
+        hasher.update(repr((type(sequences[2]).__name__, sequences[2])).encode())
+        hasher.update(repr((type(mania_keycount).__name__, mania_keycount)).encode())
+        for name in ("seed", "model_path", "precision", "device"):
+            value = getattr(self.args, name, None)
+            hasher.update(repr((name, type(value).__name__, value)).encode())
+        hasher.update(
+            repr((type(self.model).__module__, type(self.model).__qualname__)).encode()
+        )
+        hasher.update(
+            repr((type(self.tokenizer).__module__, type(self.tokenizer).__qualname__)).encode()
+        )
+        for name, value in sorted(model_kwargs.items()):
+            if isinstance(value, torch.Tensor):
+                self._hash_tensor(hasher, f"model-kwarg:{name}", value)
+            else:
+                hasher.update(repr((name, type(value).__name__, value)).encode())
+        for collection_name, contexts in (
+                ("in", in_context),
+                ("out", out_context),
+        ):
+            for index, context in enumerate(contexts):
+                hasher.update(
+                    repr((
+                        collection_name,
+                        index,
+                        context.get("context_type"),
+                        context.get("finished"),
+                    )).encode()
                 )
+                events = context.get("events", ())
+                event_times = context.get("event_times", ())
+                event_origins = context.get("event_origins", ())
+                if not (
+                        len(events) == len(event_times) == len(event_origins)
+                ):
+                    raise ValueError(
+                        "checkpoint identity requires aligned parallel event streams"
+                    )
+                for event, event_time, origin in zip(
+                        events,
+                        event_times,
+                        event_origins,
+                ):
+                    hasher.update(repr((
+                        event.type.value,
+                        type(event.value).__name__,
+                        event.value,
+                        type(event_time).__name__,
+                        event_time,
+                        origin.kind,
+                        origin.source_window_id,
+                        origin.source_token_index,
+                        origin.reference_event_index,
+                    )).encode())
+        return hasher.hexdigest()
+
+    @staticmethod
+    def _mania_tail_repair_target(
+            error: ManiaDomainError | ManiaTailRepairRequired,
+            context: dict[str, Any],
+            mania_keycount: int,
+    ) -> tuple[str, int | None]:
+        """Reason plus the window a repair must rewind to, not merely detect at.
+
+        ``ManiaTailRepairRequired`` already carries the earliest origin of the
+        issues it found.  ``ManiaDomainError`` carries only the window that was
+        decoding when the grammar blocked, so an open HOLD from an earlier
+        window has to be resolved against the committed stream: restarting after
+        that window would freeze the fault inside the restored prefix.
+        """
+        if not isinstance(error, ManiaDomainError):
+            return error.reason, error.earliest_generated_source_window_id
+        fault_window = mania_domain_fault_window(
+            error,
+            open_hold_origin_windows(
+                context["events"],
+                context["event_times"],
+                context["event_origins"],
+                keycount=mania_keycount,
+            ),
+        )
+        if fault_window is not None:
+            return error.reason, fault_window
