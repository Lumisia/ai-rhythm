+def _sequential_fixture(
+        monkeypatch,
+        *,
+        fail_domain=True,
+        open_last_hold=False,
+        failure_plan: dict[int, set[int]] | None = None,
+        domain_reason: str = "NO_LEGAL_MANIA_GROUP_COMPLETION",
+        domain_lane: int | None = None,
+        domain_context: dict[str, object] | None = None,
+        open_hold_at: int | None = None,
+        hold_lane: int = 3,
+        n_windows: int = 6,
+        end_time: int | None = 500,
+):
+    processor = processor_module.Processor.__new__(processor_module.Processor)
+    processor.args = SimpleNamespace(seed=1234, model_path="fixture-model")
+    processor.model = SimpleNamespace(config={"fixture": "model-v1"})
+    processor.tokenizer = _FakeTokenizer()
+    processor.do_song_position_embed = False
+    processor.max_batch_size = 8
+    processor.miliseconds_per_sequence = 100
+    processor.lookback_time = 0
+    processor.lookahead_time = 0
+    processor.lookahead_max_time = 1_000
+    processor.eos_time = 1_000
+    processor.lookahead_time_range = range(0)
+    processor.lookback_time_range = range(0)
+    processor.last_attack_time = None
+    processor.types_first = False
+    processor.parallel = False
+    processor.add_to_beatmap = False
+    processor.start_time = None
+    processor.end_time = end_time
+    processor.prepare_frames = lambda frames: frames
+    processor.prepare_context_sequences = lambda *_args, **_kwargs: []
+    processor.get_prompts = lambda *_args, **_kwargs: (
+        torch.tensor([[11]], dtype=torch.long),
+        None,
+    )
+    processor.pad_prompts = lambda prompts: (prompts, 1)
+    processor._mania_prompt_open_hold_columns = lambda *_args: ()
+    processor._mania_prompt_group_signatures = lambda *_args: ()
+    processor._mania_prompt_current_time_token = lambda *_args: 0
+
+    encoder_calls = []
+    window_calls: list[int] = []
+    per_window_calls: dict[int, int] = {}
+
+    def precompute(_model, frames, _cond, _positions, *, batch_size):
+        encoder_calls.append((frames.clone(), batch_size))
+        return torch.arange(frames.shape[0], dtype=torch.float32).view(-1, 1, 1)
+
+    monkeypatch.setattr(processor_module, "precompute_encoder_outputs", precompute)
+
+    def model_generate(model_kwargs, **_kwargs):
+        window_id = int(model_kwargs["encoder_outputs"][0, 0, 0].item())
+        window_calls.append(window_id)
+        per_window_calls[window_id] = per_window_calls.get(window_id, 0) + 1
+        plan = ({5: {1}} if fail_domain else {}) if failure_plan is None else failure_plan
+        if per_window_calls[window_id] in plan.get(window_id, set()):
+            raise ManiaDomainError(
+                reason=domain_reason,
+                message="fixture domain failure",
+                lane=domain_lane,
+                context=domain_context,
+            )
+        return torch.tensor([[11, 77]], dtype=torch.long), {
+            "generated_tokens": 2,
+            "elapsed_seconds": 0.25,
+        }
+
+    processor.model_generate = model_generate
+
+    def decode(_tokens, frame_time):
+        window_id = int(frame_time // 100)
+        lane = 0
+        event_type = EventType.CIRCLE
+        if (
+                open_last_hold
+                and window_id == 5
+                and per_window_calls.get(window_id) == 1
+        ):
+            event_type = EventType.HOLD_NOTE
+        elif open_hold_at is not None and window_id == open_hold_at:
+            # One HOLD start that no later window ever closes: the fault window.
+            lane = hold_lane
+            event_type = EventType.HOLD_NOTE
+        return [
+            Event(EventType.TIME_SHIFT, int(frame_time) + 10),
+            Event(EventType.MANIA_COLUMN, lane),
+            Event(event_type, 0),
+        ], [0, 1, 2]
+
+    processor._decode_indexed = decode
+    processor._reset_generation_stats()
+    context = _context(ContextType.MAP, finished=False)
+    sequences = (
+        torch.arange(n_windows * 2, dtype=torch.float32).view(n_windows, 2),
+        torch.arange(n_windows, dtype=torch.float32) * 100,
+        float(n_windows * 100),
+    )
+    return processor, context, sequences, encoder_calls, window_calls
+
