+# --- typed partial rejoin --------------------------------------------------
+#
+# PARTIAL_REMAP has no repair budget and no window controller, so its failures
+# never reach the tail-repair terminal.  They must still leave the process as a
+# structured result instead of a stderr string chart-worker can only classify as
+# a generic crash.
+
+
+def _reference_stream(*groups):
+    events, event_times, _ = _origin_stream(*groups)
+    return events, event_times, [
+        EventOrigin.reference(index) for index in range(len(events))
+    ]
+
+
+def test_partial_rejoin_reports_an_invalid_reference_as_typed_reference_scope():
+    reference = _reference_stream(
+        (100, 0, EventType.HOLD_NOTE, 0),  # opened and never closed
+    )
+    current_events, current_times, current_origins = _origin_stream(
+        (200, 1, EventType.CIRCLE, 5),
+    )
+
+    with pytest.raises(tail_repair.ManiaPartialRejoinInvalid) as caught:
+        tail_repair.finalize_mania_partial_interval(
+            current_events,
+            current_times,
+            current_origins,
+            *reference,
+            start_time_ms=150,
+            end_time_ms=250,
+            keycount=4,
+            types_first=False,
+        )
+
+    assert caught.value.scope == "REFERENCE"
+    assert caught.value.partial_start_ms == 150
+    assert caught.value.partial_end_ms == 250
+    assert caught.value.earliest_generated_source_window_id is None
+    assert "unclosed HOLD" in caught.value.validation_error
+
+
+def test_partial_rejoin_reports_an_invalid_candidate_as_typed_rejoined_scope():
