+def _configure_partial_generate(
+        monkeypatch,
+        reference_events,
+        reference_times,
+        generated_groups,
+        *,
+        start_time,
+        end_time,
+):
+    from osuT5.osuT5.inference import processor as processor_module
+
+    class FakeParser:
+        position_precision = 1
+        position_split_axes = True
+
+        def parse(self, _beatmap, *, song_length=None):
+            return list(reference_events), list(reference_times)
+
+    monkeypatch.setattr(
+        processor_module.Beatmap,
+        "from_path",
+        lambda _path: object(),
+    )
+    monkeypatch.setattr(
+        processor_module.Path,
+        "is_file",
+        lambda _path: True,
+    )
+    monkeypatch.setattr(
+        processor_module,
+        "OsuParser",
+        lambda *_args, **_kwargs: FakeParser(),
+    )
+
+    processor = make_processor()
+    processor.parser = FakeParser()
+    processor.args = SimpleNamespace(train=object())
+    processor._get_viable_template = lambda **_kwargs: (
+        [], [ContextType.MAP], []
+    )
+    processor._get_model_cond_kwargs = lambda _config: {}
+    processor.get_in_context = lambda **_kwargs: []
+    processor.get_class_vector = lambda *_args, **_kwargs: torch.empty(0)
+    processor.add_out_context_types = False
+    processor.add_pre_tokens = False
+    processor.parallel = False
+    processor.model = object()
+    processor.start_time = start_time
+    processor.end_time = end_time
+    processor.add_positions = False
+    processor.add_to_beatmap = True
+    processor.last_generation_stats = None
+
+    def append_generated(**kwargs):
+        context = kwargs["out_context"][0]
+        events, _, origins = _mania_tail_stream(*generated_groups)
+        context["events"].extend(events)
+        context["event_origins"].extend(origins)
+
+    processor.generate_sequential = append_generated
+    return processor
