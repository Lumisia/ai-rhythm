+++ b/tests/test_mania_reference_sustain.py
@@ -0,0 +1,261 @@
+"""Parser-produced Mania reference streams must satisfy the Mania grammar.
+
+``OsuParser`` is the second producer of Mania event streams: window decoding
+produces one alphabet, and re-parsing an exported ``.osu`` for ``add_to_beatmap``
+partial regeneration produces another.  ``_add_sustain_groups`` emits an extra
+``MANIA_COLUMN`` + ``HOLD_NOTE_SUSTAIN`` group every ``data.sustain_interval``
+milliseconds inside a hold, so any hold longer than that interval yields groups
+that only the parser can produce.  These tests pin both producers against the
+single grammar that consumes them.
+"""
+
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import pytest
+from slider import Beatmap
+
+from osuT5.osuT5.dataset.osu_parser import OsuParser
+from osuT5.osuT5.event import Event, EventType
+from osuT5.osuT5.inference.mania_grammar import (
+    canonical_mania_groups,
+    replay_mania_hold_state,
+)
+from osuT5.osuT5.inference.origin import EventOrigin
+from osuT5.osuT5.inference.tail_repair import (
+    ManiaTailRepairRequired,
+    finalize_mania_partial_interval,
+    validate_mania_stream_end,
+)
+
+# configs/train/v32.yaml -> data.sustain_interval (the shipped checkpoint value).
+SUSTAIN_INTERVAL_MS = 8_000
+# osu_parser._add_sustain_groups stops at ``end_time - 10ms``.
+SUSTAIN_GUARD_MS = 10
+KEYCOUNT = 4
+LANE_X = {0: 64, 1: 192, 2: 320, 3: 448}
+
+
+def _v32_mania_parser() -> OsuParser:
+    """Build the parser with configs/train/v32.yaml's parser-visible settings."""
+    args = SimpleNamespace(
+        data=SimpleNamespace(
+            types_first=False,
+            add_timing=False,
+            add_snapping=True,
+            add_timing_points=True,
+            add_hitsounds=True,
+            add_distances=False,
+            add_positions=True,
+            add_kiai=False,
+            add_sv=True,
+            add_mania_sv=False,
+            mania_bpm_normalized_scroll_speed=True,
+            position_precision=32,
+            position_split_axes=False,
+            position_refinement=2,
+            position_range=[-256, 768, -256, 640],
+            slider_version=2,
+            sustain_interval=SUSTAIN_INTERVAL_MS,
+        )
+    )
+    return OsuParser(args, tokenizer=None)
+
+
+def _mania_beatmap(hit_objects: list[str]) -> Beatmap:
+    lines = [
+        "osu file format v14",
+        "",
+        "[General]",
+        "AudioFilename: game.flac",
+        "AudioLeadIn: 0",
+        "PreviewTime: 0",
+        "Countdown: 0",
+        "SampleSet: All",
+        "StackLeniency: 0.7",
+        "Mode: 3",
+        "",
+        "[Editor]",
+        "DistanceSpacing: 1.0",
+        "BeatDivisor: 4",
+        "GridSize: 8",
+        "TimelineZoom: 1.0",
+        "",
+        "[Metadata]",
+        "Title:t",
+        "TitleUnicode:t",
+        "Artist:a",
+        "ArtistUnicode:a",
+        "Creator:c",
+        "Version:v",
+        "Source:",
+        "Tags:",
+        "BeatmapID:0",
+        "BeatmapSetID:-1",
+        "",
+        "[Difficulty]",
+        f"CircleSize:{KEYCOUNT}",
+        "OverallDifficulty:8",
+        "HPDrainRate:8",
+        "ApproachRate:5",
+        "SliderMultiplier:1.4",
+        "SliderTickRate:1",
+        "",
+        "[TimingPoints]",
+        "0,500,4,2,0,60,1,0",
+        "",
+        "[HitObjects]",
+        *hit_objects,
+    ]
+    return Beatmap.parse("\n".join(lines))
+
+
+def _parse_reference(hold_ms: int) -> tuple[list[Event], list[int]]:
+    """Parse one lane-0 hold of ``hold_ms`` followed by one lane-1 tap."""
+    start = 1_000
+    beatmap = _mania_beatmap(
+        [
+            f"{LANE_X[0]},192,{start},128,0,{start + hold_ms}:0:0:0:0:",
+            f"{LANE_X[1]},192,{start + hold_ms + 500},1,0,0:0:0:0:",
+        ]
+    )
+    events, event_times = _v32_mania_parser().parse(beatmap)
+    return list(events), list(event_times)
+
+
+def _sustain_count(events: list[Event]) -> int:
+    return sum(1 for event in events if event.type == EventType.HOLD_NOTE_SUSTAIN)
+
+
+def _reference_origins(events: list[Event]) -> list[EventOrigin]:
+    return [EventOrigin.reference(index) for index in range(len(events))]
+
+
+def _gameplay_shape(events: list[Event], event_times: list[int]):
+    groups = canonical_mania_groups(events, event_times, keycount=KEYCOUNT)
+    return [(group.time_ms, group.lane, group.event_type) for group in groups]
+
+
+def test_parser_emits_no_sustain_group_below_the_sustain_interval():
+    """Control: the threshold is the producer's, not an arbitrary length."""
+    events, _ = _parse_reference(SUSTAIN_INTERVAL_MS + SUSTAIN_GUARD_MS)
+
+    assert _sustain_count(events) == 0
+
+
+@pytest.mark.parametrize(
+    "hold_ms",
+    [
+        SUSTAIN_INTERVAL_MS + SUSTAIN_GUARD_MS + 1,  # first hold that sustains
+        19_811,  # observed 7K EASY partial-remap reference, lane 0
+        29_716,  # observed 7K EASY partial-remap reference, lane 2
+    ],
+)
+def test_parsed_long_hold_reference_is_canonically_groupable(hold_ms):
+    events, event_times = _parse_reference(hold_ms)
+    assert _sustain_count(events) > 0
+
+    groups = canonical_mania_groups(events, event_times, keycount=KEYCOUNT)
+
+    assert replay_mania_hold_state(groups, keycount=KEYCOUNT) == ()
+
+
+def test_sustain_groups_are_transparent_to_canonical_gameplay():
+    """A hold's canonical groups must not depend on how long the hold is."""
+    short_events, short_times = _parse_reference(
+        SUSTAIN_INTERVAL_MS + SUSTAIN_GUARD_MS
+    )
+    long_events, long_times = _parse_reference(SUSTAIN_INTERVAL_MS * 3)
+    assert _sustain_count(short_events) == 0
+    assert _sustain_count(long_events) > 0
+
+    short_shape = _gameplay_shape(short_events, short_times)
+    long_shape = _gameplay_shape(long_events, long_times)
+
+    assert [(lane, kind) for _, lane, kind in short_shape] == [
+        (0, EventType.HOLD_NOTE),
+        (0, EventType.HOLD_NOTE_END),
+        (1, EventType.CIRCLE),
+    ]
+    assert [(lane, kind) for _, lane, kind in long_shape] == [
+        (0, EventType.HOLD_NOTE),
+        (0, EventType.HOLD_NOTE_END),
+        (1, EventType.CIRCLE),
+    ]
+
+
+def test_stream_end_validation_accepts_a_parsed_long_hold_reference():
+    events, event_times = _parse_reference(SUSTAIN_INTERVAL_MS * 3)
+    assert _sustain_count(events) > 0
+
+    validate_mania_stream_end(
+        events,
+        event_times,
+        _reference_origins(events),
+        song_end_ms=max(event_times) + 1_000,
+        keycount=KEYCOUNT,
+        types_first=False,
+    )
+
+
+def test_partial_interval_rejoin_accepts_a_parsed_long_hold_reference():
+    """The 7K EASY PARTIAL_REMAP path: reference is a re-parsed exported .osu."""
+    reference_events, reference_times = _parse_reference(SUSTAIN_INTERVAL_MS * 3)
+    reference_origins = _reference_origins(reference_events)
+    assert _sustain_count(reference_events) > 0
+
+    tap_time = reference_times[-1]
+    current_events = [
+        Event(EventType.TIME_SHIFT, tap_time),
+        Event(EventType.MANIA_COLUMN, 2),
+        Event(EventType.CIRCLE, 0),
+    ]
+    current_times = [tap_time, tap_time, tap_time]
+    current_origins = [EventOrigin.generated(0, index) for index in range(3)]
+
+    finalize_mania_partial_interval(
+        current_events,
+        current_times,
+        current_origins,
+        reference_events,
+        reference_times,
+        reference_origins,
+        start_time_ms=tap_time - 1,
+        end_time_ms=tap_time,
+        keycount=KEYCOUNT,
+        types_first=False,
+    )
+
+    assert [origin.kind for origin in current_origins].count("GENERATED") == 3
+    groups = canonical_mania_groups(current_events, current_times, keycount=KEYCOUNT)
+    assert replay_mania_hold_state(groups, keycount=KEYCOUNT) == ()
+
+
+def test_sustains_never_stand_in_for_a_missing_hold_end():
+    """Transparency must not become permissiveness: a sustain closes nothing."""
+    events = [
+        Event(EventType.TIME_SHIFT, 100),
+        Event(EventType.MANIA_COLUMN, 0),
+        Event(EventType.HOLD_NOTE, 0),
+        Event(EventType.TIME_SHIFT, 8_100),
+        Event(EventType.MANIA_COLUMN, 0),
+        Event(EventType.HOLD_NOTE_SUSTAIN, 0),
+        Event(EventType.TIME_SHIFT, 16_100),
+        Event(EventType.MANIA_COLUMN, 0),
+        Event(EventType.HOLD_NOTE_SUSTAIN, 0),
+    ]
+    event_times = [100, 100, 100, 8_100, 8_100, 8_100, 16_100, 16_100, 16_100]
+
+    with pytest.raises(ManiaTailRepairRequired) as caught:
+        validate_mania_stream_end(
+            events,
+            event_times,
+            _reference_origins(events),
+            song_end_ms=20_000,
+            keycount=KEYCOUNT,
+            types_first=False,
+        )
+
+    assert caught.value.reason == "UNCLOSED_HOLD_AT_STREAM_END"
+    assert [issue.lane for issue in caught.value.issues] == [0]
