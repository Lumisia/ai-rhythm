+# --- fault-site addressing -------------------------------------------------
+#
+# ManiaDomainError.source_window_id is the window being decoded when the grammar
+# noticed the problem.  When an earlier window left a HOLD open, that window is
+# the fault and the detection window is only where the fault became visible.
+# Rewinding to the detection window freezes the fault inside the restored
+# prefix, so such a repair provably cannot succeed.
+
+_HOLD_LANE = 3
+
+
+def _closure_budget_context(lanes):
+    return {"remainingTokens": 1, "requiredTokens": 4, "openLanes": list(lanes)}
+
+
+def _origin_stream(*groups):
+    events, event_times, event_origins = [], [], []
+    for time_ms, lane, event_type, window in groups:
+        events.extend([
+            Event(EventType.TIME_SHIFT, time_ms),
+            Event(EventType.MANIA_COLUMN, lane),
+            Event(event_type, 0),
+        ])
+        event_times.extend([time_ms] * 3)
+        event_origins.extend(EventOrigin.generated(window, i) for i in range(3))
+    return events, event_times, event_origins
+
+
+def test_open_hold_origin_windows_maps_each_open_lane_to_its_start_window():
+    stream = _origin_stream(
+        (100, 0, EventType.HOLD_NOTE, 4),
+        (200, 1, EventType.HOLD_NOTE, 7),
+        (300, 0, EventType.HOLD_NOTE_END, 9),
+        (400, 2, EventType.CIRCLE, 11),
+    )
+
+    assert tail_repair.open_hold_origin_windows(*stream, keycount=4) == {1: 7}
+
+
+def test_open_hold_origin_windows_is_empty_when_every_hold_closed():
+    stream = _origin_stream(
+        (100, 0, EventType.HOLD_NOTE, 4),
+        (300, 0, EventType.HOLD_NOTE_END, 9),
+    )
+
+    assert tail_repair.open_hold_origin_windows(*stream, keycount=4) == {}
+
+
+def test_open_hold_origin_windows_ignores_reference_provenance():
+    events, event_times, _ = _origin_stream((100, 0, EventType.HOLD_NOTE, 4))
+    reference_origins = [EventOrigin.reference(i) for i in range(len(events))]
+
+    assert tail_repair.open_hold_origin_windows(
+        events, event_times, reference_origins, keycount=4
+    ) == {}
+
