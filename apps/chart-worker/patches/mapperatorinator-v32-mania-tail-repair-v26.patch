+            context["events"] = restored.events
+            context["event_times"] = restored.event_times
+            context["event_origins"] = restored.event_origins
+            self._record_tail_repair_start(
+                repair_attempt=repair_attempt,
+                repair_start=repair_start,
+                derived_seed=derived_seed,
+            )
+            last_trigger_reason = reason
+            last_trigger_window = source_window
