+    ordinary_stream = TrackingStream()
+    ordinary = RuntimeError("not a tail failure")
+    with pytest.raises(RuntimeError) as ordinary_captured:
+        tail_repair.run_with_mania_tail_terminal(
+            lambda: (_ for _ in ()).throw(ordinary),
