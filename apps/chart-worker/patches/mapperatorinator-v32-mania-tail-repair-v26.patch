+    torch.manual_seed(2003)
+    target = capture_rng_state()
+    restore_rng_state(before)
+
+    original_numpy_set_state = np.random.set_state
+    calls = 0
+
+    def fail_target_then_allow_rollback(state):
+        nonlocal calls
+        calls += 1
+        if calls == 1:
+            raise RuntimeError("injected global NumPy setter failure")
+        return original_numpy_set_state(state)
+
+    monkeypatch.setattr(np.random, "set_state", fail_target_then_allow_rollback)
+    with pytest.raises(CheckpointIntegrityError, match="injected global"):
+        restore_rng_state(target)
+
+    assert calls == 2
+    _assert_rng_snapshots_equal(capture_rng_state(), before)
