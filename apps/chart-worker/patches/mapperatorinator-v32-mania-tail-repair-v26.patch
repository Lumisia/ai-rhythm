+class _FakeTokenizer:
+    pad_id = 0
+    eos_id = 999
+    context_eos: dict[ContextType, int] = {}
+    event_range = {
+        EventType.TIME_SHIFT: SimpleNamespace(min_value=-512, max_value=512),
+    }
+
+    @staticmethod
+    def state_dict():
+        return {"fixture": "tail-repair-v1"}
