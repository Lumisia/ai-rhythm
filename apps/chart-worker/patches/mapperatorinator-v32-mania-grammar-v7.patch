+def test_pending_column_forces_a_legal_note_type_in_last_sequence_slot():
+    processor = ManiaHoldStateLogitsProcessor(
+        FakeTokenizer(), (), max_sequence_length=5
+    )
+
+    result = processor(
+        torch.tensor([[keycount_token(4), 1, 30, 12]]), scores()
+    )
+
+    assert not torch.isneginf(result[0, 50])
+    assert not torch.isneginf(result[0, 51])
+    assert torch.isneginf(result[0, 52])
+    assert torch.isneginf(result[0, 70])
+    assert processor.telemetry()["forcedGroupCompletionSteps"] == 1
+
+
+def test_pending_open_lane_forces_hold_end_in_last_sequence_slot():
+    processor = ManiaHoldStateLogitsProcessor(
+        FakeTokenizer(), (2,), max_sequence_length=5
+    )
+
+    result = processor(
+        torch.tensor([[keycount_token(4), 1, 30, 12]]), scores()
+    )
+
+    assert torch.isneginf(result[0, 50])
+    assert torch.isneginf(result[0, 51])
+    assert not torch.isneginf(result[0, 52])
+    assert torch.isneginf(result[0, 70])
+
