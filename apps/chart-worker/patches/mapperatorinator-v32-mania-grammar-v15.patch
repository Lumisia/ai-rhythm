+def test_group_without_prompt_or_generated_timeshift_requires_time_before_column():
+    processor = ManiaHoldStateLogitsProcessor(FakeTokenizer(), ())
+
+    without_time = processor(
+        torch.tensor([[keycount_token(4), 1]]), scores()
+    )
+    after_time = processor(
+        torch.tensor([[keycount_token(4), 1, 30]]), scores()
+    )
+
+    assert torch.isneginf(without_time[0, 10:28]).all()
+    assert not torch.isneginf(without_time[0, 30:40]).all()
+    assert not torch.isneginf(after_time[0, 10:14]).any()
+
+
+def test_final_hold_closure_budget_includes_missing_timeshift():
+    processor = ManiaHoldStateLogitsProcessor(
+        FakeTokenizer(),
+        (1, 3),
+        require_closed_holds_at_eos=True,
+        max_sequence_length=7,
+    )
+
+    result = processor(
+        torch.tensor([[keycount_token(4), 1]]), scores()
+    )
+
+    assert torch.isneginf(result[0, 10:28]).all()
+    assert not torch.isneginf(result[0, 30:40]).all()
+
+    insufficient = ManiaHoldStateLogitsProcessor(
+        FakeTokenizer(),
+        (1, 3),
+        require_closed_holds_at_eos=True,
+        max_sequence_length=6,
+    )
+    with pytest.raises(ValueError, match="insufficient sequence budget"):
+        insufficient(torch.tensor([[keycount_token(4), 1]]), scores())
+
+
