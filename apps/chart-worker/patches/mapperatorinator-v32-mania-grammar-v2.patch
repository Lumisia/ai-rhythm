diff --git a/osuT5/osuT5/inference/mania_grammar.py b/osuT5/osuT5/inference/mania_grammar.py
new file mode 100644
index 0000000..e04eecd
--- /dev/null
+++ b/osuT5/osuT5/inference/mania_grammar.py
@@ -0,0 +1,161 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Iterable, Sequence
+
+from ..event import Event, EventType
+
+
+MANIA_NOTE_TYPES = frozenset(
+    {
+        EventType.CIRCLE,
+        EventType.HOLD_NOTE,
+        EventType.HOLD_NOTE_END,
+    }
+)
+
+
+@dataclass(frozen=True)
+class CanonicalManiaGroup:
+    """One complete, serializable mania gameplay group."""
+
+    time_ms: int
+    lane: int
+    event_type: EventType
+    event_indices: tuple[int, ...]
+
+    @property
+    def signature(self) -> tuple[int, int, EventType]:
+        return self.time_ms, self.lane, self.event_type
+
+
+def apply_mania_hold_transition(
+        open_columns: set[int],
+        lane: int,
+        event_type: EventType,
+) -> None:
+    """Apply one serializable lane transition or fail explicitly."""
+    if event_type == EventType.CIRCLE:
+        if lane in open_columns:
+            raise ValueError(f"TAP while HOLD is active in lane {lane}")
+        return
+    if event_type == EventType.HOLD_NOTE:
+        if lane in open_columns:
+            raise ValueError(f"overlapping HOLD_START in lane {lane}")
+        open_columns.add(lane)
+        return
+    if event_type == EventType.HOLD_NOTE_END:
+        if lane not in open_columns:
+            raise ValueError(f"HOLD_END without HOLD_START in lane {lane}")
+        open_columns.remove(lane)
+
+
+def canonical_mania_groups(
+        events: Sequence[Event],
+        event_times: Sequence[float] | None = None,
+        *,
+        keycount: int | None = None,
+) -> list[CanonicalManiaGroup]:
+    """Parse complete mania gameplay groups without silently dropping fragments.
+
+    A MANIA_COLUMN is a pending gameplay group. It must be followed by exactly
+    one TAP/HOLD_START/HOLD_END before another column, a new time, or the end of
+    the stream. Non-gameplay attributes between the column and note type remain
+    part of that group.
+    """
+    if event_times is not None and len(events) != len(event_times):
+        raise ValueError("events and event_times must have equal length")
+
+    groups: list[CanonicalManiaGroup] = []
+    current_time = 0
+    pending_lane: int | None = None
+    pending_indices: list[int] = []
+
+    for index, event in enumerate(events):
+        if event.type == EventType.TIME_SHIFT:
+            if pending_lane is not None:
+                raise ValueError(
+                    f"incomplete mania group before time shift at event {index}: "
+                    f"lane={pending_lane}"
+                )
+            current_time = int(round(event.value))
+            continue
+
+        if event.type == EventType.MANIA_COLUMN:
+            if pending_lane is not None:
+                raise ValueError(
+                    f"incomplete mania group before column at event {index}: "
+                    f"lane={pending_lane}"
+                )
+            pending_lane = int(event.value)
+            pending_indices = [index]
+            if keycount is not None and not 0 <= pending_lane < keycount:
+                raise ValueError(
+                    f"mania lane {pending_lane} is outside keycount {keycount}"
+                )
+            continue
+
+        if event.type in MANIA_NOTE_TYPES:
+            if pending_lane is None:
+                time_ms = (
+                    int(round(event_times[index]))
+                    if event_times is not None
+                    else current_time
+                )
+                raise ValueError(
+                    f"mania note has no gameplay column: "
+                    f"type={event.type.name}, time={time_ms}"
+                )
+            pending_indices.append(index)
+            time_ms = (
+                int(round(event_times[index]))
+                if event_times is not None
+                else current_time
+            )
+            groups.append(
+                CanonicalManiaGroup(
+                    time_ms=time_ms,
+                    lane=pending_lane,
+                    event_type=event.type,
+                    event_indices=tuple(pending_indices),
+                )
+            )
+            pending_lane = None
+            pending_indices = []
+            continue
+
+        if pending_lane is not None:
+            pending_indices.append(index)
+
+    if pending_lane is not None:
+        raise ValueError(
+            f"incomplete mania group at end of stream: lane={pending_lane}"
+        )
+
+    return groups
+
+
+def replay_mania_hold_state(
+        groups: Iterable[CanonicalManiaGroup],
+        *,
+        keycount: int,
+) -> tuple[int, ...]:
+    """Replay canonical groups and return lanes left open at stream end."""
+    open_columns: set[int] = set()
+    order = {
+        EventType.HOLD_NOTE_END: 0,
+        EventType.HOLD_NOTE: 1,
+        EventType.CIRCLE: 2,
+    }
+    unique_groups = {group.signature: group for group in groups}
+    for group in sorted(
+            unique_groups.values(),
+            key=lambda item: (item.time_ms, item.lane, order[item.event_type]),
+    ):
+        if not 0 <= group.lane < keycount:
+            raise ValueError(
+                f"mania lane {group.lane} is outside keycount {keycount} "
+                f"at {group.time_ms}"
+            )
+        apply_mania_hold_transition(open_columns, group.lane, group.event_type)
+    return tuple(sorted(open_columns))
