+def test_compiled_sampling_bucket_retry_restores_rng_and_reports_restart(monkeypatch):
+    events = []
+
+    class Cache:
+        @staticmethod
+        def reset():
+            return None
+
+    class FakeDecoder:
+        @staticmethod
+        def set_encoder_hidden(_hidden):
+            return None
+
+        @staticmethod
+        def replay(_token, _cache_position):
+            return scores()
+
+    class FakeModel:
+        device = torch.device("cpu")
+        dtype = torch.float32
+        config = SimpleNamespace(max_target_positions=5)
+
+        @staticmethod
+        def prepare_inputs_for_generation(*_args, **_kwargs):
+            return {}
+
+        @staticmethod
+        def __call__(**_kwargs):
+            return SimpleNamespace(logits=scores().unsqueeze(1))
+
+    sampled_tokens = iter((30, FakeTokenizer.eos_id))
+    sentinel = object()
+    monkeypatch.setattr(
+        compiled_decode_module, "neutralize_dynamic_rope", lambda _model: None
+    )
+    monkeypatch.setattr(
+        compiled_decode_module,
+        "build_logits_processors",
+        lambda *_args: compiled_decode_module.LogitsProcessorList(),
+    )
+    monkeypatch.setattr(compiled_decode_module, "_pick_bucket", lambda *_args: 4)
+    monkeypatch.setattr(compiled_decode_module, "_bucket_ceil", lambda *_args: 5)
+    monkeypatch.setattr(
+        compiled_decode_module,
+        "_get_decoder",
+        lambda *_args: (FakeDecoder(), Cache()),
+    )
+    monkeypatch.setattr(
+        compiled_decode_module,
+        "capture_rng_state",
+        lambda: events.append("capture") or sentinel,
+        raising=False,
+    )
+    monkeypatch.setattr(
+        compiled_decode_module,
+        "restore_rng_state",
+        lambda snapshot: events.append(("restore", snapshot)),
+        raising=False,
+    )
+    monkeypatch.setattr(
+        compiled_decode_module,
+        "_sample",
+        lambda *_args: torch.tensor([[next(sampled_tokens)]], dtype=torch.long),
+    )
+
+    result, stats = compiled_decode_module.model_generate_compiled(
+        FakeModel(),
+        FakeTokenizer(),
+        {
+            "encoder_outputs": torch.zeros((1, 1, 1)),
+            "decoder_input_ids": torch.tensor(
+                [[keycount_token(4), FakeTokenizer.sos_id, 30]]
+            ),
+        },
+        {
+            "context_type": "map",
+            "mania_open_hold_columns": (),
+            "max_length": 5,
+            "do_sample": True,
+        },
+    )
+
+    assert events == ["capture", ("restore", sentinel)]
+    assert torch.equal(
+        result,
+        torch.tensor(
+            [[keycount_token(4), FakeTokenizer.sos_id, 30, FakeTokenizer.eos_id]]
+        ),
+    )
+    assert stats["compiledDecode"] == {
+        "initialBucket": 4,
+        "finalBucket": 5,
+        "bucketRestarted": True,
+        "generatedBeforeRestart": 1,
+        "terminationReason": "EOS",
+    }
