+            return scores()
+
+    class FakeModel:
+        device = torch.device("cpu")
+        dtype = torch.float32
+        config = SimpleNamespace(max_target_positions=5)
+
+        @staticmethod
+        def prepare_inputs_for_generation(*_args, **_kwargs):
+            return {}
+
+        @staticmethod
+        def __call__(**_kwargs):
+            return SimpleNamespace(logits=scores().unsqueeze(1))
+
+    monkeypatch.setattr(
+        compiled_decode_module, "neutralize_dynamic_rope", lambda _model: None
+    )
+    monkeypatch.setattr(
+        compiled_decode_module,
+        "build_logits_processors",
+        lambda *_args: compiled_decode_module.LogitsProcessorList(),
+    )
+    monkeypatch.setattr(
+        compiled_decode_module,
+        "_get_decoder",
+        lambda *_args: (FakeDecoder(), Cache()),
+    )
+    monkeypatch.setattr(
+        compiled_decode_module,
+        "_sample",
+        lambda *_args: torch.tensor([[30]], dtype=torch.long),
