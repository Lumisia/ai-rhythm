+def test_start_boundary_allows_only_open_hold_lanes_to_form_a_new_group():
+    closed = ManiaHoldStateLogitsProcessor(
+        FakeTokenizer(), (), max_note_start_time_token=30
+    )
+    one_open = ManiaHoldStateLogitsProcessor(
+        FakeTokenizer(), (2,), max_note_start_time_token=30
+    )
+    after_boundary = torch.tensor([[keycount_token(4), 1, 31]])
+
+    closed_result = closed(after_boundary, scores())
+    open_result = one_open(after_boundary, scores())
+
+    assert torch.isneginf(closed_result[0, 10:28]).all()
+    assert not torch.isneginf(closed_result[0, 2])
+    assert torch.isneginf(open_result[0, 10:28][[0, 1, *range(3, 18)]]).all()
+    assert not torch.isneginf(open_result[0, 12])
+    assert closed.telemetry()["startBoundaryColumnRestrictionSteps"] == 1
+
+
