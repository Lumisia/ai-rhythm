 MILISECONDS_PER_SECOND = 1000
 MILISECONDS_PER_STEP = 10
+
+
+def _max_decoded_time_shift_value(max_time_ms: float) -> int:
+    """Largest token value whose decoded center does not exceed a boundary."""
+    half_step = MILISECONDS_PER_STEP // 2
+    if max_time_ms < half_step:
+        # Non-negative tokens decode at +5ms, while negative tokens do not
+        # receive the centering offset. There is no token in (-10ms, +5ms).
+        return min(-1, math.floor(max_time_ms / MILISECONDS_PER_STEP))
+    return math.floor((max_time_ms - half_step) / MILISECONDS_PER_STEP)
 
 
