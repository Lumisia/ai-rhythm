+def test_resnap_restores_tap_when_snap_crosses_note_start_boundary():
+    events = [
+        Event(EventType.TIME_SHIFT, 110), Event(EventType.SNAPPING, 4),
+        Event(EventType.POS_X, 64), Event(EventType.POS_Y, 192),
+        Event(EventType.CIRCLE, 0),
+    ]
+
+    snapped_events, snapped_times, diagnostics = make_postprocessor().resnap_events(
+        events,
+        [110] * 5,
+        make_timing(),
+        key_count=4,
+        max_note_start_time=120,
+    )
+
+    assert snapped_events[0].value == 110
+    assert snapped_times == [110] * 5
+    assert diagnostics == [{
+        "lane": 0,
+        "noteKind": "TAP",
+        "preTimeMs": 110,
+        "postTimeMs": 125,
+        "snapDivisor": 4,
+        "reason": "START_BOUNDARY_RAW_RESTORED",
+    }]
+
+
+def test_resnap_restores_hold_pair_atomically_when_start_snap_crosses_boundary():
+    events = [
+        Event(EventType.TIME_SHIFT, 110), Event(EventType.SNAPPING, 4),
+        Event(EventType.POS_X, 64), Event(EventType.POS_Y, 192),
+        Event(EventType.HOLD_NOTE, 0), Event(EventType.TIME_SHIFT, 260),
+        Event(EventType.SNAPPING, 4), Event(EventType.POS_X, 64),
+        Event(EventType.POS_Y, 192), Event(EventType.HOLD_NOTE_END, 0),
+    ]
+
+    snapped_events, snapped_times, diagnostics = make_postprocessor().resnap_events(
+        events,
+        [110] * 5 + [260] * 5,
+        make_timing(),
+        key_count=4,
+        max_note_start_time=120,
+    )
+
+    assert [
+        event.value for event in snapped_events
+        if event.type == EventType.TIME_SHIFT
+    ] == [110, 260]
+    assert snapped_times == [110] * 5 + [260] * 5
+    assert diagnostics == [{
+        "lane": 0,
+        "noteKind": "HOLD_PAIR",
+        "rawStartMs": 110,
+        "rawEndMs": 260,
+        "proposedStartMs": 125,
+        "proposedEndMs": 375,
+        "reason": "HOLD_PAIR_START_BOUNDARY_RAW_RESTORED",
+    }]
+
