+from types import SimpleNamespace
+
+import torch
+
+from osuT5.osuT5.event import EventType
+from osuT5.osuT5.inference.logit_processors import (
+    ManiaHoldStateLogitsProcessor,
+)
+from osuT5.osuT5.inference.required_gameplay_enforcement import (
+    RequiredGameplayIntervalLogitsProcessor,
+)
+from osuT5.osuT5.inference.server import (
+    build_logits_processors,
+    get_required_gameplay_enforcement_telemetry,
+    reset_required_gameplay_enforcement_state,
+)
+
+
+class _Tokenizer:
+    sos_id = 1
+    eos_id = 2
+    context_eos = {"map": 3, "timing": 4}
+    event_start = {
+        EventType.MANIA_COLUMN: 10,
+        EventType.TIME_SHIFT: 30,
+        EventType.CIRCLE: 50,
+        EventType.HOLD_NOTE: 51,
+        EventType.HOLD_NOTE_END: 52,
+        EventType.HOLD_NOTE_SUSTAIN: 53,
+        EventType.MANIA_KEYCOUNT: 100,
+    }
+    event_end = {
+        EventType.MANIA_COLUMN: 14,
+        EventType.TIME_SHIFT: 40,
+        EventType.MANIA_KEYCOUNT: 104,
+    }
+    event_range = {
+        EventType.MANIA_KEYCOUNT: SimpleNamespace(min_value=1),
+        EventType.TIME_SHIFT: SimpleNamespace(min_value=-2, max_value=7),
+    }
+
+
+def _build(**overrides):
+    kwargs = dict(
+        tokenizer=_Tokenizer(),
+        cfg_scale=1.0,
+        timeshift_bias=0,
+        types_first=False,
+        temperature=1.0,
+        timing_temperature=1.0,
+        mania_column_temperature=1.0,
+        taiko_hit_temperature=1.0,
+        lookback_time=0,
+        device="cpu",
+        mania_open_hold_columns=(),
+        mania_max_sequence_length=20,
+    )
+    kwargs.update(overrides)
+    return build_logits_processors(**kwargs)
+
+
+def test_ordinary_stack_has_no_required_gameplay_processor():
+    processors = _build()
+
+    assert not any(
+        isinstance(item, RequiredGameplayIntervalLogitsProcessor)
+        for item in processors
+    )
+
+
+def test_required_gameplay_processor_is_composed_after_existing_grammar():
+    processors = _build(
+        mania_required_gameplay_interval_time_tokens=(32, 34),
+        mania_required_gameplay_initial_time_token=32,
+        mania_required_gameplay_allowed_group_types=("TAP", "HOLD_START"),
+        mania_required_gameplay_initial_satisfied=False,
+        mania_required_gameplay_eos_token_ids=(2, 3),
+    )
+
+    hold_index = next(
+        index
+        for index, item in enumerate(processors)
+        if isinstance(item, ManiaHoldStateLogitsProcessor)
+    )
+    required_index = next(
+        index
+        for index, item in enumerate(processors)
+        if isinstance(item, RequiredGameplayIntervalLogitsProcessor)
+    )
+    assert hold_index < required_index
+    assert required_index == len(processors) - 1
+
+    scores = torch.zeros((1, 128), dtype=torch.float32)
+    prefix_without_lane = torch.tensor([[103, 1, 32]])
+    processed = processors(prefix_without_lane, scores)
+
+    assert torch.isneginf(processed[0, 50])
+    assert torch.isneginf(processed[0, 51])
+    assert torch.isneginf(processed[0, 2])
+    assert torch.isneginf(processed[0, 3])
+    assert processed[0, 4] == scores[0, 4]
+
+
+def test_required_gameplay_telemetry_and_reset_are_explicit():
+    processors = _build(
+        mania_required_gameplay_interval_time_tokens=(32, 34),
+        mania_required_gameplay_initial_time_token=32,
+        mania_required_gameplay_allowed_group_types=("TAP",),
+        mania_required_gameplay_initial_satisfied=False,
+        mania_required_gameplay_eos_token_ids=(2,),
+        mania_hold_state_mode="incremental",
+    )
+    required = next(
+        item
+        for item in processors
+        if isinstance(item, RequiredGameplayIntervalLogitsProcessor)
+    )
+    prompt = torch.tensor([[103, 1]])
+    required(prompt, torch.zeros((1, 128)))
+    required(torch.tensor([[103, 1, 10, 50]]), torch.zeros((1, 128)))
+    assert required.snapshot().phase.value == "SATISFIED"
+    assert get_required_gameplay_enforcement_telemetry(processors)[
+        "phase"
+    ] == "SATISFIED"
+
+    reset_required_gameplay_enforcement_state(processors)
+
+    assert required.snapshot().phase.value == "UNSATISFIED"
