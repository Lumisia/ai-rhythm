@@ -0,0 +1,353 @@
+import importlib
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from osuT5.osuT5.event import EventType
+from osuT5.osuT5.inference.mania_domain import ManiaDomainError
+class _Tokenizer:
+    sos_id = 1
+    eos_id = 2
+    context_eos = {"map": 3}
+    event_start = {
+        EventType.MANIA_COLUMN: 10,
+        EventType.TIME_SHIFT: 30,
+        EventType.CIRCLE: 50,
+        EventType.HOLD_NOTE: 51,
+        EventType.HOLD_NOTE_END: 52,
+        EventType.HOLD_NOTE_SUSTAIN: 53,
+        EventType.MANIA_KEYCOUNT: 100,
+    }
+    event_end = {
+        EventType.MANIA_COLUMN: 14,
+        EventType.TIME_SHIFT: 40,
+        EventType.MANIA_KEYCOUNT: 104,
+    }
+    event_range = {
+        EventType.MANIA_KEYCOUNT: SimpleNamespace(min_value=1),
+        EventType.TIME_SHIFT: SimpleNamespace(min_value=-2, max_value=7),
+    }
+
+
+PROMPT = torch.tensor([[100, 1]], dtype=torch.long)
+
+
+def _scores(*, all_masked: bool = False) -> torch.Tensor:
+    if all_masked:
+        return torch.full((1, 128), -torch.inf, dtype=torch.float32)
+    return torch.arange(128, dtype=torch.float32).reshape(1, 128)
+
+
+def _enforcement():
+    return importlib.import_module(
+        "osuT5.osuT5.inference.required_gameplay_enforcement"
+    )
+
+
+def _phase(name: str):
+    return getattr(_enforcement().RequiredGameplayEnforcementPhase, name)
+
+
+def _processor(
+    *,
+    initial_satisfied: bool = False,
+    max_sequence_length: int = 20,
+    hold_start_closure_addressable: bool = True,
+    **kwargs,
+):
+    kwargs.setdefault("initial_time_token", 32)
+    return _enforcement().RequiredGameplayIntervalLogitsProcessor(
+        _Tokenizer(),
+        interval_start_time_token=32,
+        interval_end_time_token=34,
+        initial_satisfied=initial_satisfied,
+        max_sequence_length=max_sequence_length,
+        hold_start_closure_addressable=hold_start_closure_addressable,
+        **kwargs,
+    )
+
+
+def test_unsatisfied_masks_only_termination_and_time_strictly_after_interval():
+    processor = _processor()
+    scores = _scores()
+
+    processed = processor(PROMPT, scores)
+
+    assert torch.isneginf(processed[0, 2])
+    assert torch.isneginf(processed[0, 3])
+    assert processed[0, 34] == scores[0, 34]
+    assert torch.isneginf(processed[0, 35:40]).all()
+    allowed = torch.ones(128, dtype=torch.bool)
+    allowed[[2, 3]] = False
+    allowed[35:40] = False
+    assert torch.equal(processed[0, allowed], scores[0, allowed])
+    assert processed[0, 10] == scores[0, 10]
+    assert processed[0, 50] == scores[0, 50]
+    assert processed[0, 51] == scores[0, 51]
+    assert processor.snapshot().phase == _phase("UNSATISFIED")
+
+
+def test_generated_complete_tap_satisfies_and_becomes_an_exact_noop():
+    processor = _processor()
+    processor(PROMPT, _scores())
+    generated_tap = torch.tensor([[100, 1, 32, 10, 50]], dtype=torch.long)
+    scores = _scores()
+
+    processed = processor(generated_tap, scores)
+
+    assert torch.equal(processed, scores)
+    snapshot = processor.snapshot()
+    assert snapshot.phase == _phase("SATISFIED")
+    assert snapshot.complete_group_count == 1
+    assert snapshot.current_time_token == 32
+
+
+def test_prompt_group_never_satisfies_generated_origin_obligation():
+    processor = _processor()
+    prompt_with_group = torch.tensor([[100, 1, 32, 10, 50]], dtype=torch.long)
+
+    processed = processor(prompt_with_group, _scores())
+
+    assert torch.isneginf(processed[0, 2])
+    assert processor.snapshot().phase == _phase("UNSATISFIED")
+    assert processor.snapshot().complete_group_count == 0
+
+
+def test_prompt_time_can_be_inherited_without_prompt_group_satisfying():
+    processor = _processor(initial_time_token=33)
+    processor(PROMPT, _scores())
+
+    processed = processor(
+        torch.tensor([[100, 1, 10, 50]], dtype=torch.long),
+        _scores(),
+    )
+
+    assert torch.equal(processed, _scores())
+    assert processor.snapshot().phase == _phase("SATISFIED")
+    assert processor.snapshot().current_time_token == 33
+
+
+def test_explicit_termination_tokens_do_not_mask_unrelated_context_eos():
+    processor = _processor(eos_token_ids=(2,))
+
+    processed = processor(PROMPT, _scores())
+
+    assert torch.isneginf(processed[0, 2])
+    assert processed[0, 3] == _scores()[0, 3]
+
+
+def test_allowed_group_types_are_respected_without_type_score_boosting():
+    processor = _processor(allowed_group_types=("TAP",))
+    processor(PROMPT, _scores())
+    scores = _scores()
+
+    after_hold = processor(
+        torch.tensor([[100, 1, 32, 10, 51]], dtype=torch.long),
+        scores,
+    )
+
+    assert processor.snapshot().phase == _phase("UNSATISFIED")
+    assert after_hold[0, 50] == scores[0, 50]
+    assert after_hold[0, 51] == scores[0, 51]
+
+
+def test_hold_sustain_completes_structure_but_never_satisfies_obligation():
+    processor = _processor()
+    processor(PROMPT, _scores())
+
+    processed = processor(
+        torch.tensor([[100, 1, 32, 10, 53]], dtype=torch.long),
+        _scores(),
+    )
+
+    assert processor.snapshot().phase == _phase("UNSATISFIED")
+    assert processor.snapshot().pending_lane is None
+    assert torch.isneginf(processed[0, 2])
+
+
+@pytest.mark.parametrize("mode", ["full_scan", "incremental", "incremental_verify"])
+def test_state_modes_make_identical_decisions_across_connected_prefixes(mode):
+    processor = _processor(state_mode=mode)
+    prefixes = [
+        PROMPT,
+        torch.tensor([[100, 1, 32]], dtype=torch.long),
+        torch.tensor([[100, 1, 32, 10]], dtype=torch.long),
+        torch.tensor([[100, 1, 32, 10, 50]], dtype=torch.long),
+    ]
+    phases = []
+
+    for prefix in prefixes:
+        processor(prefix, _scores())
+        phases.append(processor.snapshot().phase)
+
+    assert phases == [
+        _phase("UNSATISFIED"),
+        _phase("UNSATISFIED"),
+        _phase("GROUP_PENDING"),
+        _phase("SATISFIED"),
+    ]
+    telemetry = processor.telemetry()
+    expected_incremental = 0 if mode == "full_scan" else len(prefixes)
+    assert telemetry["incrementalRows"] == expected_incremental
+    assert telemetry["verificationRows"] == (
+        len(prefixes) if mode == "incremental_verify" else 0
+    )
+
+
+def test_incremental_mode_reset_does_not_leak_satisfaction_to_next_attempt():
+    processor = _processor(state_mode="incremental")
+    processor(PROMPT, _scores())
+    processor(torch.tensor([[100, 1, 32, 10, 50]]), _scores())
+    assert processor.snapshot().phase == _phase("SATISFIED")
+
+    processor.reset_incremental_state()
+    processed = processor(PROMPT, _scores())
+
+    assert processor.snapshot().phase == _phase("UNSATISFIED")
+    assert torch.isneginf(processed[0, 2])
+
+
+def test_pending_generated_group_preserves_note_scores_and_masks_escape():
+    processor = _processor()
+    processor(PROMPT, _scores())
+    pending = torch.tensor([[100, 1, 33, 11]], dtype=torch.long)
+    scores = _scores()
+
+    processed = processor(pending, scores)
+
+    assert processor.snapshot().phase == _phase("GROUP_PENDING")
+    assert processed[0, 50] == scores[0, 50]
+    assert processed[0, 51] == scores[0, 51]
+    assert torch.isneginf(processed[0, 2])
+    assert torch.isneginf(processed[0, 35:40]).all()
+
+
+@pytest.mark.parametrize("time_token", [32, 34])
+def test_closed_interval_boundaries_allow_a_complete_tap(time_token):
+    processor = _processor()
+    processor(PROMPT, _scores())
+
+    processor(
+        torch.tensor([[100, 1, time_token, 10, 50]], dtype=torch.long),
+        _scores(),
+    )
+
+    assert processor.snapshot().phase == _phase("SATISFIED")
+
+
+def test_group_before_interval_does_not_satisfy():
+    processor = _processor()
+    processor(PROMPT, _scores())
+
+    processed = processor(
+        torch.tensor([[100, 1, 31, 10, 50]], dtype=torch.long),
+        _scores(),
+    )
+
+    assert processor.snapshot().phase == _phase("UNSATISFIED")
+    assert torch.isneginf(processed[0, 2])
+
+
+@pytest.mark.parametrize(
+    ("addressable", "expected_phase"),
+    [
+        (True, "SATISFIED"),
+        (False, "UNSATISFIED"),
+    ],
+)
+def test_hold_start_satisfies_only_when_closure_is_addressable(
+    addressable,
+    expected_phase,
+):
+    processor = _processor(hold_start_closure_addressable=addressable)
+    processor(PROMPT, _scores())
+
+    processed = processor(
+        torch.tensor([[100, 1, 32, 10, 51]], dtype=torch.long),
+        _scores(),
+    )
+
+    assert processor.snapshot().phase == _phase(expected_phase)
+    if addressable:
+        assert torch.equal(processed, _scores())
+    else:
+        assert torch.isneginf(processed[0, 2])
+
+
+def test_initial_satisfaction_is_an_exact_noop_and_does_not_scan_prompt():
+    processor = _processor(initial_satisfied=True)
+    scores = _scores()
+
+    processed = processor(PROMPT, scores)
+
+    assert torch.equal(processed, scores)
+    assert processor.snapshot().phase == _phase("SATISFIED")
+    assert processor.snapshot().complete_group_count == 1
+
+
+def test_unsatisfied_preflight_rejects_insufficient_group_and_eos_budget():
+    processor = _processor(max_sequence_length=PROMPT.shape[1] + 2)
+
+    with pytest.raises(ManiaDomainError) as caught:
+        processor(PROMPT, _scores())
+
+    assert caught.value.reason == "REQUIRED_GAMEPLAY_INTERVAL_TOKEN_BUDGET_EXHAUSTED"
+    assert caught.value.context == {
+        "remainingTokens": 2,
+        "requiredTokens": 3,
+        "phase": "UNSATISFIED",
+    }
+
+
+def test_preflight_reserves_time_transition_when_current_time_is_outside():
+    processor = _processor(
+        initial_time_token=31,
+        max_sequence_length=PROMPT.shape[1] + 3,
+    )
+
+    with pytest.raises(ManiaDomainError) as caught:
+        processor(PROMPT, _scores())
+
+    assert caught.value.reason == "REQUIRED_GAMEPLAY_INTERVAL_TOKEN_BUDGET_EXHAUSTED"
+    assert caught.value.context["requiredTokens"] == 4
+
+
+def test_all_masked_after_obligation_mask_is_no_legal_group_not_fallback():
+    processor = _processor()
+
+    with pytest.raises(ManiaDomainError) as caught:
+        processor(PROMPT, _scores(all_masked=True))
+
+    assert caught.value.reason == "REQUIRED_GAMEPLAY_INTERVAL_NO_LEGAL_GROUP"
+    assert caught.value.context["phase"] == "UNSATISFIED"
+
+
+def test_unrelated_finite_token_does_not_hide_no_legal_group():
+    processor = _processor(initial_time_token=31)
+    scores = _scores(all_masked=True)
+    scores[0, 120] = 0.0
+
+    with pytest.raises(ManiaDomainError) as caught:
+        processor(PROMPT, scores)
+
+    assert caught.value.reason == "REQUIRED_GAMEPLAY_INTERVAL_NO_LEGAL_GROUP"
+
+
+@pytest.mark.parametrize(
+    ("start", "end"),
+    [(34, 32), (29, 32), (32, 40), (True, 34)],
+)
+def test_non_addressable_or_malformed_token_interval_fails_closed(start, end):
+    with pytest.raises((TypeError, ManiaDomainError)) as caught:
+        _enforcement().RequiredGameplayIntervalLogitsProcessor(
+            _Tokenizer(),
+            interval_start_time_token=start,
+            interval_end_time_token=end,
+            initial_satisfied=False,
+            max_sequence_length=20,
+            hold_start_closure_addressable=True,
+        )
+
+    if isinstance(caught.value, ManiaDomainError):
+        assert caught.value.reason == "REQUIRED_GAMEPLAY_INTERVAL_NOT_ADDRESSABLE"
