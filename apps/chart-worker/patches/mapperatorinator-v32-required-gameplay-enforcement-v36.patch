@@ -0,0 +1,98 @@
+from types import SimpleNamespace
+
+import pytest
+
+from osuT5.osuT5.event import EventType
+from osuT5.osuT5.inference.mania_domain import ManiaDomainError
+from osuT5.osuT5.inference.required_gameplay_enforcement import (
+    addressable_required_gameplay_time_tokens,
+)
+
+
+class _Tokenizer:
+    event_start = {EventType.TIME_SHIFT: 30}
+    event_end = {EventType.TIME_SHIFT: 133}
+    event_range = {
+        EventType.TIME_SHIFT: SimpleNamespace(min_value=-2, max_value=100)
+    }
+
+
+def _tokens(**overrides):
+    kwargs = dict(
+        tokenizer=_Tokenizer(),
+        frame_time_ms=0.0,
+        interval_start_ms=409,
+        interval_end_ms=549,
+        accepted_start_ms=0.0,
+        accepted_end_ms=1_000.0,
+        accepted_end_inclusive=False,
+        effective_cut_ms=1_000.0,
+        max_note_start_ms=900.0,
+    )
+    kwargs.update(overrides)
+    return addressable_required_gameplay_time_tokens(**kwargs)
+
+
+def test_translation_uses_exact_decoder_half_step_semantics():
+    # Values 41..54 decode to 415..545ms. Value 40 decodes to 405ms and
+    # value 55 to 555ms, so neither belongs to the closed 409..549ms interval.
+    assert _tokens() == (73, 86)
+
+
+def test_negative_relative_tokens_do_not_receive_positive_half_step():
+    assert _tokens(
+        frame_time_ms=100.0,
+        interval_start_ms=80,
+        interval_end_ms=95,
+        accepted_start_ms=0,
+        accepted_end_ms=100,
+        effective_cut_ms=100,
+        max_note_start_ms=100,
+    ) == (30, 31)
+
+
+def test_adjacent_windows_assign_midpoint_once_using_half_open_core():
+    first = _tokens(
+        interval_start_ms=490,
+        interval_end_ms=510,
+        accepted_start_ms=0,
+        accepted_end_ms=500,
+    )
+    second = _tokens(
+        interval_start_ms=490,
+        interval_end_ms=510,
+        accepted_start_ms=500,
+        accepted_end_ms=1_000,
+    )
+
+    assert first is None
+    assert second == (82, 82)
+
+
+def test_final_window_can_own_interval_center_on_closed_end():
+    assert _tokens(
+        interval_start_ms=990,
+        interval_end_ms=1_010,
+        accepted_start_ms=500,
+        accepted_end_ms=1_000,
+        accepted_end_inclusive=True,
+        effective_cut_ms=1_000,
+        max_note_start_ms=1_000,
+    ) == (131, 131)
+
+
+@pytest.mark.parametrize(
+    "override",
+    [
+        {"effective_cut_ms": 408},
+        {"max_note_start_ms": 408},
+        {"interval_start_ms": True},
+        {"frame_time_ms": float("nan")},
+    ],
+)
+def test_designated_but_unreachable_interval_fails_closed(override):
+    with pytest.raises((TypeError, ValueError, ManiaDomainError)) as caught:
+        _tokens(**override)
+
+    if isinstance(caught.value, ManiaDomainError):
+        assert caught.value.reason == "REQUIRED_GAMEPLAY_INTERVAL_NOT_ADDRESSABLE"
