diff --git a/osuT5/osuT5/inference/required_gameplay_enforcement.py b/osuT5/osuT5/inference/required_gameplay_enforcement.py
new file mode 100644
index 0000000..96ee800
--- /dev/null
+++ b/osuT5/osuT5/inference/required_gameplay_enforcement.py
@@ -0,0 +1,482 @@
+"""Bounded decoder obligation for a generated Mania gameplay interval."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from enum import Enum
+import math
+
+import torch
+from transformers import LogitsProcessor
+
+from ..event import EventType
+from .mania_domain import ManiaDomainError
+
+
+_MILLISECONDS_PER_STEP = 10
+
+
+def _finite_number(value: object, name: str) -> float:
+    if type(value) not in {int, float}:
+        raise TypeError(f"{name} must be an exact finite int or float")
+    if not math.isfinite(value):
+        raise ValueError(f"{name} must be finite")
+    return float(value)
+
+
+def addressable_required_gameplay_time_tokens(
+    *,
+    tokenizer,
+    frame_time_ms: int | float,
+    interval_start_ms: int,
+    interval_end_ms: int,
+    accepted_start_ms: int | float,
+    accepted_end_ms: int | float,
+    accepted_end_inclusive: bool,
+    effective_cut_ms: int | float,
+    max_note_start_ms: int | float,
+) -> tuple[int, int] | None:
+    """Map one absolute interval to the sole accepted decoder window.
+
+    Adjacent accepted cores are half-open except for the final core. Token
+    addressability is evaluated using the decoder's actual 10ms/+5ms decode
+    semantics rather than by rounding the interval endpoints.
+    """
+    if type(interval_start_ms) is not int or type(interval_end_ms) is not int:
+        raise TypeError("required gameplay interval bounds must be exact ints")
+    if interval_start_ms >= interval_end_ms:
+        raise ValueError("required gameplay interval start must precede end")
+    if type(accepted_end_inclusive) is not bool:
+        raise TypeError("accepted_end_inclusive must be an exact bool")
+    frame_time = _finite_number(frame_time_ms, "frame_time_ms")
+    accepted_start = _finite_number(accepted_start_ms, "accepted_start_ms")
+    accepted_end = _finite_number(accepted_end_ms, "accepted_end_ms")
+    effective_cut = _finite_number(effective_cut_ms, "effective_cut_ms")
+    max_note_start = _finite_number(max_note_start_ms, "max_note_start_ms")
+    if accepted_start >= accepted_end:
+        raise ValueError("accepted window start must precede end")
+
+    midpoint = (interval_start_ms + interval_end_ms) / 2
+    owns_midpoint = accepted_start <= midpoint < accepted_end or (
+        accepted_end_inclusive and midpoint == accepted_end
+    )
+    if not owns_midpoint:
+        return None
+
+    time_start = tokenizer.event_start[EventType.TIME_SHIFT]
+    time_end = tokenizer.event_end[EventType.TIME_SHIFT]
+    time_range = tokenizer.event_range[EventType.TIME_SHIFT]
+    expected_size = time_range.max_value - time_range.min_value + 1
+    if time_end - time_start != expected_size:
+        raise ManiaDomainError(
+            reason="REQUIRED_GAMEPLAY_INTERVAL_NOT_ADDRESSABLE",
+            message="Tokenizer time token domain is not contiguous",
+            context={
+                "tokenCount": time_end - time_start,
+                "valueCount": expected_size,
+            },
+        )
+
+    candidates: list[int] = []
+    for token in range(time_start, time_end):
+        value = time_range.min_value + token - time_start
+        decoded_ms = (
+            frame_time
+            + value * _MILLISECONDS_PER_STEP
+            + (_MILLISECONDS_PER_STEP // 2 if value >= 0 else 0)
+        )
+        accepted = accepted_start <= decoded_ms < accepted_end or (
+            accepted_end_inclusive and decoded_ms == accepted_end
+        )
+        if (
+            accepted
+            and interval_start_ms <= decoded_ms <= interval_end_ms
+            and decoded_ms <= effective_cut
+            and decoded_ms <= max_note_start
+        ):
+            candidates.append(token)
+
+    if not candidates:
+        raise ManiaDomainError(
+            reason="REQUIRED_GAMEPLAY_INTERVAL_NOT_ADDRESSABLE",
+            message=(
+                "Designated decoder window has no accepted time token in the "
+                "required gameplay interval"
+            ),
+            context={
+                "intervalStartMs": interval_start_ms,
+                "intervalEndMs": interval_end_ms,
+                "acceptedStartMs": accepted_start,
+                "acceptedEndMs": accepted_end,
+                "effectiveCutMs": effective_cut,
+                "maxNoteStartMs": max_note_start,
+            },
+        )
+    return candidates[0], candidates[-1]
+
+
+class RequiredGameplayEnforcementPhase(str, Enum):
+    UNSATISFIED = "UNSATISFIED"
+    GROUP_PENDING = "GROUP_PENDING"
+    SATISFIED = "SATISFIED"
+
+
+@dataclass(frozen=True)
+class RequiredGameplayEnforcementSnapshot:
+    phase: RequiredGameplayEnforcementPhase
+    current_time_token: int | None
+    pending_lane: int | None
+    complete_group_count: int
+
+
+class RequiredGameplayIntervalLogitsProcessor(LogitsProcessor):
+    """Prevent early escape until one generated gameplay group is complete.
+
+    This processor is deliberately incapable of choosing a lane or note type.
+    While the obligation is pending it masks only termination tokens and time
+    tokens strictly after the closed required interval.
+    """
+
+    def __init__(
+        self,
+        tokenizer,
+        *,
+        interval_start_time_token: int,
+        interval_end_time_token: int,
+        initial_satisfied: bool,
+        max_sequence_length: int,
+        hold_start_closure_addressable: bool,
+        initial_time_token: int | None = None,
+        eos_token_ids: tuple[int, ...] | None = None,
+        allowed_group_types: tuple[str, ...] = ("TAP", "HOLD_START"),
+        state_mode: str = "full_scan",
+    ) -> None:
+        if type(interval_start_time_token) is not int:
+            raise TypeError("interval_start_time_token must be an exact int")
+        if type(interval_end_time_token) is not int:
+            raise TypeError("interval_end_time_token must be an exact int")
+        if type(initial_satisfied) is not bool:
+            raise TypeError("initial_satisfied must be an exact bool")
+        if type(max_sequence_length) is not int or max_sequence_length <= 0:
+            raise TypeError("max_sequence_length must be a positive exact int")
+        if type(hold_start_closure_addressable) is not bool:
+            raise TypeError(
+                "hold_start_closure_addressable must be an exact bool"
+            )
+        if initial_time_token is not None and type(initial_time_token) is not int:
+            raise TypeError("initial_time_token must be an exact int or None")
+        if type(allowed_group_types) is not tuple or (
+            not allowed_group_types
+            or len(set(allowed_group_types)) != len(allowed_group_types)
+            or any(
+                type(item) is not str
+                or item not in {"TAP", "HOLD_START"}
+                for item in allowed_group_types
+            )
+        ):
+            raise ValueError("allowed_group_types must be a supported exact tuple")
+        if type(state_mode) is not str or state_mode not in {
+            "full_scan",
+            "incremental",
+            "incremental_verify",
+        }:
+            raise ValueError("state_mode is unsupported")
+
+        self._time_start = tokenizer.event_start[EventType.TIME_SHIFT]
+        self._time_end = tokenizer.event_end[EventType.TIME_SHIFT]
+        if not (
+            self._time_start <= interval_start_time_token
+            <= interval_end_time_token < self._time_end
+        ):
+            raise ManiaDomainError(
+                reason="REQUIRED_GAMEPLAY_INTERVAL_NOT_ADDRESSABLE",
+                message="Required gameplay interval is outside decoder time tokens",
+                context={
+                    "intervalStartTimeToken": interval_start_time_token,
+                    "intervalEndTimeToken": interval_end_time_token,
+                    "timeTokenStart": self._time_start,
+                    "timeTokenEndExclusive": self._time_end,
+                },
+            )
+
+        self._interval_start = interval_start_time_token
+        self._interval_end = interval_end_time_token
+        if initial_time_token is not None and not (
+            self._time_start <= initial_time_token < self._time_end
+        ):
+            raise ManiaDomainError(
+                reason="REQUIRED_GAMEPLAY_INTERVAL_NOT_ADDRESSABLE",
+                message="Initial time token is outside decoder time tokens",
+                context={"initialTimeToken": initial_time_token},
+            )
+        self._column_start = tokenizer.event_start[EventType.MANIA_COLUMN]
+        self._column_end = tokenizer.event_end[EventType.MANIA_COLUMN]
+        self._tap_token = tokenizer.event_start[EventType.CIRCLE]
+        self._hold_start_token = tokenizer.event_start[EventType.HOLD_NOTE]
+        self._hold_end_token = tokenizer.event_start[EventType.HOLD_NOTE_END]
+        self._hold_sustain_token = tokenizer.event_start.get(
+            EventType.HOLD_NOTE_SUSTAIN
+        )
+        if eos_token_ids is None:
+            eos_token_ids = tuple(
+                dict.fromkeys(
+                    [tokenizer.eos_id, *tokenizer.context_eos.values()]
+                )
+            )
+        if type(eos_token_ids) is not tuple or any(
+            type(token) is not int or token < 0 for token in eos_token_ids
+        ):
+            raise TypeError("eos_token_ids must be an exact non-negative int tuple")
+        self._termination_tokens = tuple(dict.fromkeys(eos_token_ids))
+        self._max_sequence_length = max_sequence_length
+        self._hold_start_closure_addressable = hold_start_closure_addressable
+        self._initial_time_token = initial_time_token
+        self._allowed_group_types = frozenset(allowed_group_types)
+        self._state_mode = state_mode
+        self._prompt_length: int | None = None
+        self._processed_length: int | None = None
+        self._initial_satisfied = initial_satisfied
+        self._snapshot = self._initial_snapshot()
+        self._telemetry = {
+            "fullScanRows": 0,
+            "incrementalRows": 0,
+            "verificationRows": 0,
+            "suffixTokensParsed": 0,
+        }
+
+    def _initial_snapshot(self) -> RequiredGameplayEnforcementSnapshot:
+        return RequiredGameplayEnforcementSnapshot(
+            phase=(
+                RequiredGameplayEnforcementPhase.SATISFIED
+                if self._initial_satisfied
+                else RequiredGameplayEnforcementPhase.UNSATISFIED
+            ),
+            current_time_token=self._initial_time_token,
+            pending_lane=None,
+            complete_group_count=1 if self._initial_satisfied else 0,
+        )
+
+    def snapshot(self) -> RequiredGameplayEnforcementSnapshot:
+        return self._snapshot
+
+    def telemetry(self) -> dict[str, int]:
+        return dict(self._telemetry)
+
+    def reset_incremental_state(self) -> None:
+        self._prompt_length = None
+        self._processed_length = None
+        self._snapshot = self._initial_snapshot()
+
+    def _advance(
+        self,
+        snapshot: RequiredGameplayEnforcementSnapshot,
+        raw_tokens: list[int],
+    ) -> RequiredGameplayEnforcementSnapshot:
+        current_time = snapshot.current_time_token
+        pending_lane = snapshot.pending_lane
+        complete_group_count = snapshot.complete_group_count
+
+        for raw_token in raw_tokens:
+            if complete_group_count:
+                break
+            token = int(raw_token)
+            if self._time_start <= token < self._time_end:
+                if pending_lane is not None:
+                    self._accounting_mismatch(
+                        "Time transition encountered before group completion"
+                    )
+                current_time = token
+                continue
+            if self._column_start <= token < self._column_end:
+                if pending_lane is not None:
+                    self._accounting_mismatch(
+                        "Second lane encountered before group completion"
+                    )
+                pending_lane = token - self._column_start
+                continue
+            if token in {
+                self._tap_token,
+                self._hold_start_token,
+                self._hold_end_token,
+                self._hold_sustain_token,
+            }:
+                if pending_lane is None:
+                    self._accounting_mismatch(
+                        "Gameplay type encountered without a lane"
+                    )
+                in_interval = (
+                    current_time is not None
+                    and self._interval_start <= current_time <= self._interval_end
+                )
+                group_type = {
+                    self._tap_token: "TAP",
+                    self._hold_start_token: "HOLD_START",
+                }.get(token)
+                closes_obligation = group_type in self._allowed_group_types and (
+                    token == self._tap_token or (
+                    token == self._hold_start_token
+                    and self._hold_start_closure_addressable
+                    )
+                )
+                if in_interval and closes_obligation:
+                    complete_group_count += 1
+                pending_lane = None
+
+        if complete_group_count:
+            phase = RequiredGameplayEnforcementPhase.SATISFIED
+        elif pending_lane is not None:
+            phase = RequiredGameplayEnforcementPhase.GROUP_PENDING
+        else:
+            phase = RequiredGameplayEnforcementPhase.UNSATISFIED
+        return RequiredGameplayEnforcementSnapshot(
+            phase=phase,
+            current_time_token=current_time,
+            pending_lane=pending_lane,
+            complete_group_count=complete_group_count,
+        )
+
+    def _full_replay(
+        self, input_ids: torch.LongTensor
+    ) -> RequiredGameplayEnforcementSnapshot:
+        assert self._prompt_length is not None
+        return self._advance(
+            self._initial_snapshot(),
+            [int(token) for token in input_ids[0, self._prompt_length:].tolist()],
+        )
+
+    def _update_snapshot(self, input_ids: torch.LongTensor) -> None:
+        assert self._prompt_length is not None
+        current_length = int(input_ids.shape[1])
+        if self._state_mode == "full_scan":
+            self._snapshot = self._full_replay(input_ids)
+            self._telemetry["fullScanRows"] += 1
+            self._telemetry["suffixTokensParsed"] += (
+                current_length - self._prompt_length
+            )
+            return
+
+        if self._processed_length is None:
+            self._processed_length = self._prompt_length
+        if current_length < self._processed_length:
+            self._accounting_mismatch(
+                "Connected generation prefix shrank without an explicit reset"
+            )
+        suffix = [
+            int(token)
+            for token in input_ids[0, self._processed_length:current_length].tolist()
+        ]
+        self._snapshot = self._advance(self._snapshot, suffix)
+        self._processed_length = current_length
+        self._telemetry["incrementalRows"] += 1
+        self._telemetry["suffixTokensParsed"] += len(suffix)
+        if self._state_mode == "incremental_verify":
+            oracle = self._full_replay(input_ids)
+            self._telemetry["verificationRows"] += 1
+            if oracle != self._snapshot:
+                self._accounting_mismatch(
+                    "Incremental required-gameplay state disagrees with full replay"
+                )
+
+    def _accounting_mismatch(self, message: str) -> None:
+        raise ManiaDomainError(
+            reason="REQUIRED_GAMEPLAY_INTERVAL_ACCOUNTING_MISMATCH",
+            message=message,
+            context={"phase": self._snapshot.phase.value},
+        )
+
+    @staticmethod
+    def _any_finite(
+        scores: torch.FloatTensor,
+        token_ids: tuple[int, ...] | range,
+    ) -> bool:
+        ids = tuple(token for token in token_ids if token is not None)
+        return bool(ids) and bool(torch.isfinite(scores[0, list(ids)]).any())
+
+    def _has_legal_progress(self, scores: torch.FloatTensor) -> bool:
+        if (
+            self._snapshot.phase
+            is RequiredGameplayEnforcementPhase.GROUP_PENDING
+        ):
+            return self._any_finite(
+                scores,
+                tuple(
+                    token
+                    for token in (
+                        self._tap_token,
+                        self._hold_start_token,
+                        self._hold_end_token,
+                        self._hold_sustain_token,
+                    )
+                    if token is not None
+                ),
+            )
+        interval_times = range(
+            self._interval_start,
+            self._interval_end + 1,
+        )
+        current_in_interval = (
+            self._snapshot.current_time_token is not None
+            and self._interval_start
+            <= self._snapshot.current_time_token
+            <= self._interval_end
+        )
+        return self._any_finite(scores, interval_times) or (
+            current_in_interval
+            and self._any_finite(
+                scores,
+                range(self._column_start, self._column_end),
+            )
+        )
+
+    def __call__(
+        self,
+        input_ids: torch.LongTensor,
+        scores: torch.FloatTensor,
+    ) -> torch.FloatTensor:
+        if input_ids.ndim != 2 or input_ids.shape[0] != 1:
+            raise ValueError("required gameplay enforcement supports batch size 1")
+        if self._initial_satisfied:
+            return scores
+        if self._prompt_length is None:
+            self._prompt_length = int(input_ids.shape[1])
+        self._update_snapshot(input_ids)
+        if self._snapshot.phase is RequiredGameplayEnforcementPhase.SATISFIED:
+            return scores
+
+        remaining_tokens = self._max_sequence_length - int(input_ids.shape[1])
+        if (
+            self._snapshot.phase
+            is RequiredGameplayEnforcementPhase.GROUP_PENDING
+        ):
+            required_tokens = 2
+        elif (
+            self._snapshot.current_time_token is not None
+            and self._interval_start
+            <= self._snapshot.current_time_token
+            <= self._interval_end
+        ):
+            required_tokens = 3
+        else:
+            required_tokens = 4
+        if remaining_tokens < required_tokens:
+            raise ManiaDomainError(
+                reason="REQUIRED_GAMEPLAY_INTERVAL_TOKEN_BUDGET_EXHAUSTED",
+                message="Insufficient decoder budget for required gameplay group",
+                context={
+                    "remainingTokens": remaining_tokens,
+                    "requiredTokens": required_tokens,
+                    "phase": self._snapshot.phase.value,
+                },
+            )
+
+        processed = scores.clone()
+        for token in self._termination_tokens:
+            processed[:, token] = -torch.inf
+        processed[:, self._interval_end + 1:self._time_end] = -torch.inf
+        if not self._has_legal_progress(processed):
+            raise ManiaDomainError(
+                reason="REQUIRED_GAMEPLAY_INTERVAL_NO_LEGAL_GROUP",
+                message="Existing decoder constraints leave no legal token",
+                context={"phase": self._snapshot.phase.value},
+            )
+        return processed
