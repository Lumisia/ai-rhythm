new file mode 100644
index 0000000..d7da6c2
--- /dev/null
+++ b/tests/test_required_gameplay_processor_window.py
@@ -0,0 +1,158 @@
+from dataclasses import replace
+from types import MethodType, SimpleNamespace
+
+import torch
+import pytest
+
+from osuT5.osuT5.event import ContextType, EventType
+from osuT5.osuT5.inference.processor import Processor
+from osuT5.osuT5.inference.mania_domain import ManiaDomainError
+from osuT5.osuT5.inference.required_gameplay_observation import (
+    RequiredGameplayIntervalObservation,
+)
+
+
+class _Tokenizer:
+    pad_id = 0
+    eos_id = 2
+    context_eos = {ContextType.MAP: 3}
+    event_start = {
+        EventType.TIME_SHIFT: 30,
+        EventType.MANIA_COLUMN: 140,
+        EventType.CIRCLE: 160,
+        EventType.HOLD_NOTE: 161,
+        EventType.HOLD_NOTE_END: 162,
+    }
+    event_end = {
+        EventType.TIME_SHIFT: 133,
+        EventType.MANIA_COLUMN: 144,
+    }
+    event_range = {
+        EventType.TIME_SHIFT: SimpleNamespace(min_value=-2, max_value=100)
+    }
+
+
+def _interval(mode="SHADOW_ENFORCE"):
+    return RequiredGameplayIntervalObservation(
+        start_ms=409,
+        end_ms=549,
+        minimum_complete_groups=1,
+        allowed_group_types=("HOLD_START", "TAP"),
+        evidence_class="BROADBAND_ATTACK",
+        evidence_digest="a" * 64,
+        mode=mode,
+    )
+
+
+def _processor(interval):
+    processor = Processor.__new__(Processor)
+    processor.required_gameplay_interval = interval
+    processor.tokenizer = _Tokenizer()
+    processor.lookback_time = 0.0
+    processor.lookahead_time = 0.0
+    processor.lookahead_max_time = 1_000.0
+    processor.miliseconds_per_sequence = 1_000.0
+    processor.last_attack_time = 900
+    processor.end_time = 1_000
+    processor.types_first = False
+    processor.prepare_context_sequences = MethodType(
+        lambda self, *_args, **_kwargs: None,
+        processor,
+    )
+    processor.get_prompts = MethodType(
+        lambda self, *_args, **_kwargs: (torch.tensor([[1]]), None),
+        processor,
+    )
+    processor._mania_prompt_open_hold_columns = MethodType(
+        lambda self, *_args: (), processor
+    )
+    processor._mania_prompt_group_signatures = MethodType(
+        lambda self, *_args: (), processor
+    )
+    processor._mania_prompt_current_time_token = MethodType(
+        lambda self, *_args: 32, processor
+    )
+    processor._record_generation_stats = MethodType(
+        lambda self, _stats: None, processor
+    )
+    processor.add_predicted_tokens_to_context = MethodType(
+        lambda self, *_args, **_kwargs: None, processor
+    )
+    return processor
+
+
+def _run_window(processor):
+    captured = {}
+
+    def model_generate(self, _model_kwargs, **kwargs):
+        captured.update(kwargs)
+        return torch.tensor([[1, 2]]), {
+            "required_gameplay_enforcement": {
+                "phase": "SATISFIED",
+                "completeGroupCount": 1,
+            }
+        }
+
+    processor.model_generate = MethodType(model_generate, processor)
+    processor._generate_sequential_window(
+        context={"context_type": ContextType.MAP},
+        context_index=0,
+        in_context=[],
+        out_context=[],
+        req_special_tokens=[],
+        model_kwargs={},
+        enc_hidden=torch.zeros((1, 1, 1)),
+        wi=0,
+        frame_time=0.0,
+        n_windows=1,
+        song_length=1_000.0,
+        mania_keycount=4,
+        progress_bar=None,
+        tokens_per_second_meter={},
+    )
+    return captured
+
+
+def test_shadow_window_threads_exact_addressable_contract():
+    processor = _processor(_interval())
+    captured = _run_window(processor)
+
+    assert captured["mania_required_gameplay_interval_time_tokens"] == (73, 86)
+    assert captured["mania_required_gameplay_initial_time_token"] == 32
+    assert captured["mania_required_gameplay_allowed_group_types"] == (
+        "HOLD_START",
+        "TAP",
+    )
+    assert captured["mania_required_gameplay_initial_satisfied"] is False
+    assert processor._required_gameplay_enforcement_windows == {0}
+
+
+def test_observe_window_does_not_thread_enforcement_kwargs():
+    captured = _run_window(_processor(replace(_interval(), mode="OBSERVE")))
+
+    assert not any(
+        key.startswith("mania_required_gameplay_") for key in captured
+    )
+
+
+def test_shadow_invocation_without_one_owned_window_fails_closed():
+    processor = _processor(_interval())
+    processor._required_gameplay_enforcement_windows = set()
+
+    with pytest.raises(ManiaDomainError) as caught:
+        processor._validate_required_gameplay_enforcement_dispatch()
+
+    assert caught.value.reason == "REQUIRED_GAMEPLAY_INTERVAL_NOT_ADDRESSABLE"
+
+
+@pytest.mark.parametrize(
+    ("reason", "expected"),
+    [
+        ("REQUIRED_GAMEPLAY_INTERVAL_NO_LEGAL_GROUP", True),
+        ("TOKEN_BUDGET_EXHAUSTED", False),
+    ],
+)
+def test_required_gameplay_failure_is_not_consumed_by_tail_retry(reason, expected):
+    error = ManiaDomainError(reason=reason, message="failure")
+
+    assert Processor._is_required_gameplay_domain_error(error) is expected
