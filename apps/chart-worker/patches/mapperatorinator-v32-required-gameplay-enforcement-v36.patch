+    event_end = {EventType.TIME_SHIFT: 40}
+
+
+def test_stock_decode_threads_exact_required_contract_and_termination_ids(
+    monkeypatch,
+):
+    captured = {}
+
+    def capture_build(*args):
+        captured["args"] = args
+        return []
+
+    class _Model:
