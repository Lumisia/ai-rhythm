+        generation_config = SimpleNamespace(max_length=20)
+
+        @staticmethod
+        def generate(**kwargs):
+            return kwargs["decoder_input_ids"]
+
+    monkeypatch.setattr(server, "build_logits_processors", capture_build)
+    monkeypatch.setattr(server, "get_cache", lambda *_args: None)
+
+    server.model_generate(
+        _Model(),
+        _Tokenizer(),
+        {
+            "inputs": torch.zeros((1, 1, 1)),
