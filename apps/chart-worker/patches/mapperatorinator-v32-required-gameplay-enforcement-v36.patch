+            "mania_required_gameplay_allowed_group_types": ("TAP",),
+            "mania_required_gameplay_initial_satisfied": False,
+        },
+    )
+
+    args = captured["args"]
+    assert args[19:24] == (
+        (32, 34),
+        32,
+        ("TAP",),
+        False,
+        (2, 3),
