diff --git a/osuT5/osuT5/inference/required_gameplay_observation.py b/osuT5/osuT5/inference/required_gameplay_observation.py
new file mode 100644
index 0000000..8cf44a0
--- /dev/null
+++ b/osuT5/osuT5/inference/required_gameplay_observation.py
@@ -0,0 +1,485 @@
+"""Observe-only generated-origin accounting for a bounded gameplay interval."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import re
+import uuid
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Iterable, Sequence
+
+
+GENERATION_ORIGIN_DIAGNOSTICS_VERSION = "generation-origin-diagnostics-v1"
+GENERATION_ORIGIN_DIAGNOSTICS_SUFFIX = ".origin.json"
+REQUIRED_GAMEPLAY_INVOCATION_VERSION = "required-gameplay-invocation-v1"
+_MAX_DIAGNOSTICS_BYTES = 1_048_576
+_SHA256_PATTERN = re.compile(r"[0-9a-f]{64}\Z")
+_INTERVAL_FIELDS = (
+    "required_gameplay_interval_start_time",
+    "required_gameplay_interval_end_time",
+    "required_gameplay_interval_minimum_complete_groups",
+    "required_gameplay_interval_allowed_group_types",
+    "required_gameplay_interval_evidence_class",
+    "required_gameplay_interval_evidence_digest",
+)
+_SUPPORTED_GROUP_TYPES = frozenset({"TAP", "HOLD_START"})
+_SUPPORTED_EVIDENCE_CLASSES = frozenset(
+    {"BROADBAND_ATTACK", "PULSE_FAMILY_CORROBORATED"}
+)
+_STAGE_NAMES = (
+    "decoder",
+    "windowMerge",
+    "canonical",
+    "resnap",
+    "finalSerialization",
+)
+
+
+def _exact_int(value: Any, name: str, *, minimum: int = 0) -> int:
+    if type(value) is not int:
+        raise TypeError(f"{name} must be an exact integer")
+    if value < minimum:
+        raise ValueError(f"{name} must be at least {minimum}")
+    return value
+
+
+def _sha256(value: Any, name: str) -> str:
+    if type(value) is not str or _SHA256_PATTERN.fullmatch(value) is None:
+        raise ValueError(f"{name} must be a lowercase SHA-256 digest")
+    return value
+
+
+def _sha256_path(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _regular_file(path: Path, name: str) -> Path:
+    path = Path(path)
+    if path.is_symlink() or not path.is_file():
+        raise FileNotFoundError(f"{name} must be an existing regular file")
+    return path.resolve()
+
+
+def _context_values(values: Any, name: str) -> list[str]:
+    if type(values) is not list:
+        raise TypeError(f"{name} must be an exact list")
+    result = []
+    for value in values:
+        if type(value) is str:
+            item = value
+        else:
+            enum_name = getattr(value, "name", None)
+            item = enum_name if type(enum_name) is str else getattr(value, "value", None)
+        if type(item) is not str:
+            raise TypeError(f"{name} contains an unsupported context value")
+        result.append(item.upper())
+    return result
+
+
+@dataclass(frozen=True, slots=True)
+class RequiredGameplayIntervalObservation:
+    start_ms: int
+    end_ms: int
+    minimum_complete_groups: int
+    allowed_group_types: tuple[str, ...]
+    evidence_class: str
+    evidence_digest: str
+    mode: str = "OBSERVE"
+
+    def __post_init__(self) -> None:
+        _exact_int(self.start_ms, "required interval start")
+        _exact_int(self.end_ms, "required interval end")
+        if self.start_ms >= self.end_ms:
+            raise ValueError("required interval start must be before end")
+        _exact_int(
+            self.minimum_complete_groups,
+            "required interval minimum complete groups",
+            minimum=1,
+        )
+        if type(self.allowed_group_types) is not tuple:
+            raise TypeError("required interval allowed group types must be a tuple")
+        if (
+            not self.allowed_group_types
+            or len(set(self.allowed_group_types)) != len(self.allowed_group_types)
+            or any(item not in _SUPPORTED_GROUP_TYPES for item in self.allowed_group_types)
+        ):
+            raise ValueError("required interval allowed group types are invalid")
+        object.__setattr__(
+            self,
+            "allowed_group_types",
+            tuple(sorted(self.allowed_group_types)),
+        )
+        if self.evidence_class not in _SUPPORTED_EVIDENCE_CLASSES:
+            raise ValueError("required interval evidence class is unsupported")
+        _sha256(self.evidence_digest, "required interval evidence digest")
+        if self.mode != "OBSERVE":
+            raise ValueError("required interval runtime is observe-only")
+
+    def to_dict(self) -> dict[str, Any]:
+        return {
+            "startMs": self.start_ms,
+            "endMs": self.end_ms,
+            "minimumCompleteGroups": self.minimum_complete_groups,
+            "allowedGroupTypes": list(self.allowed_group_types),
+            "evidenceClass": self.evidence_class,
+            "mode": self.mode,
+        }
+
+
+@dataclass(frozen=True, slots=True)
+class _ObservedGroup:
+    identity: str
+    group_type: str
+    start_ms: int
+    in_required_interval: bool
+
+
+@dataclass(frozen=True, slots=True)
+class GameplayGroupStageSnapshot:
+    groups: tuple[_ObservedGroup, ...]
+
+    def __post_init__(self) -> None:
+        by_identity: dict[str, _ObservedGroup] = {}
+        for group in self.groups:
+            if type(group) is not _ObservedGroup:
+                raise TypeError("stage snapshot groups must be observed groups")
+            previous = by_identity.get(group.identity)
+            if previous is not None and previous != group:
+                raise ValueError("one generated-origin identity changed semantics")
+            by_identity[group.identity] = group
+        object.__setattr__(
+            self,
+            "groups",
+            tuple(by_identity[key] for key in sorted(by_identity)),
+        )
+
+    @classmethod
+    def empty(cls) -> "GameplayGroupStageSnapshot":
+        return cls(())
+
+    def merge(
+        self, other: "GameplayGroupStageSnapshot"
+    ) -> "GameplayGroupStageSnapshot":
+        if type(other) is not GameplayGroupStageSnapshot:
+            raise TypeError("stage snapshot merge requires the same type")
+        return GameplayGroupStageSnapshot(self.groups + other.groups)
+
+    def to_count_dict(self) -> dict[str, int]:
+        interval = [group for group in self.groups if group.in_required_interval]
+        return {
+            "totalGeneratedCompleteGroups": len(self.groups),
+            "intervalGeneratedCompleteGroups": len(interval),
+            "tapGroups": sum(group.group_type == "TAP" for group in interval),
+            "holdStartGroups": sum(
+                group.group_type == "HOLD_START" for group in interval
+            ),
+        }
+
+
+def required_gameplay_interval_from_args(
+    args: Any,
+) -> RequiredGameplayIntervalObservation | None:
+    mode = getattr(args, "required_gameplay_interval_mode", "OFF")
+    if type(mode) is not str or mode not in {"OFF", "OBSERVE", "SHADOW_ENFORCE"}:
+        raise ValueError("required gameplay interval mode is unsupported")
+    values = {name: getattr(args, name, None) for name in _INTERVAL_FIELDS}
+    if mode == "OFF":
+        if any(value is not None for value in values.values()):
+            raise ValueError("required gameplay interval OFF rejects stray values")
+        return None
+    if mode == "SHADOW_ENFORCE":
+        raise ValueError("required gameplay interval v35 is observe-only")
+
+    interval = RequiredGameplayIntervalObservation(
+        start_ms=values["required_gameplay_interval_start_time"],
+        end_ms=values["required_gameplay_interval_end_time"],
+        minimum_complete_groups=values[
+            "required_gameplay_interval_minimum_complete_groups"
+        ],
+        allowed_group_types=tuple(
+            values["required_gameplay_interval_allowed_group_types"]
+            if type(values["required_gameplay_interval_allowed_group_types"]) is list
+            else ()
+        ),
+        evidence_class=values["required_gameplay_interval_evidence_class"],
+        evidence_digest=values["required_gameplay_interval_evidence_digest"],
+    )
+    if getattr(args, "gamemode", None) != 3:
+        raise ValueError("required gameplay observation requires mania")
+    if getattr(args, "add_to_beatmap", None) is not True:
+        raise ValueError("required gameplay observation requires partial generation")
+    start_time = getattr(args, "start_time", None)
+    end_time = getattr(args, "end_time", None)
+    if type(start_time) is not int or type(end_time) is not int:
+        raise ValueError("required gameplay observation requires a partial range")
+    if not start_time <= interval.start_ms < interval.end_ms <= end_time:
+        raise ValueError("required gameplay interval must fit the partial range")
+    seed = getattr(args, "seed", None)
+    if type(seed) is not int or not 0 <= seed < 2**32:
+        raise ValueError("required gameplay observation requires an exact uint32 seed")
+    if getattr(args, "resnap_events", None) is not True:
+        raise ValueError("required gameplay observation requires resnap events")
+    if getattr(args, "parallel", None) is not False:
+        raise ValueError("required gameplay observation requires sequential generation")
+    if getattr(args, "super_timing", None) is not False:
+        raise ValueError("required gameplay observation does not support super timing")
+    if "MAP" not in _context_values(getattr(args, "output_type", None), "output_type"):
+        raise ValueError("required gameplay observation requires MAP output")
+    if "TIMING" not in _context_values(getattr(args, "in_context", None), "in_context"):
+        raise ValueError("required gameplay observation requires TIMING context")
+    return interval
+
+
+def _origin_value(origin: Any, name: str) -> Any:
+    if type(origin) is dict:
+        mapping = {
+            "kind": "kind",
+            "source_window_id": "sourceWindowId",
+            "source_token_index": "sourceTokenIndex",
+        }
+        return origin.get(mapping[name])
+    return getattr(origin, name, None)
+
+
+def _generated_identity(origins: Iterable[Any]) -> str | None:
+    generated = set()
+    for origin in origins:
+        if _origin_value(origin, "kind") != "GENERATED":
+            continue
+        window = _origin_value(origin, "source_window_id")
+        token = _origin_value(origin, "source_token_index")
+        if type(window) is not int or window < 0 or type(token) is not int or token < 0:
+            raise ValueError("generated origin identity is malformed")
+        generated.add((window, token))
+    if not generated:
+        return None
+    canonical = json.dumps(
+        sorted(generated),
+        ensure_ascii=True,
+        separators=(",", ":"),
+    ).encode("ascii")
+    return hashlib.sha256(b"required-gameplay-group-origin-v1\0" + canonical).hexdigest()
+
+
+def _observed_group(
+    *,
+    origins: Iterable[Any],
+    group_type: str,
+    start_ms: int,
+    interval: RequiredGameplayIntervalObservation,
+) -> _ObservedGroup | None:
+    identity = _generated_identity(origins)
+    if identity is None:
+        return None
+    return _ObservedGroup(
+        identity=identity,
+        group_type=group_type,
+        start_ms=start_ms,
+        in_required_interval=(
+            group_type in interval.allowed_group_types
+            and interval.start_ms <= start_ms <= interval.end_ms
+        ),
+    )
+
+
+def count_canonical_groups(
+    groups: Sequence[Any],
+    event_origins: Sequence[Any],
+    interval: RequiredGameplayIntervalObservation,
+) -> GameplayGroupStageSnapshot:
+    if type(interval) is not RequiredGameplayIntervalObservation:
+        raise TypeError("canonical group counting requires a typed interval")
+    observed = []
+    event_origins = list(event_origins)
+    for group in groups:
+        name = getattr(getattr(group, "event_type", None), "name", None)
+        group_type = {"CIRCLE": "TAP", "HOLD_NOTE": "HOLD_START"}.get(name)
+        if group_type is None:
+            continue
+        indices = getattr(group, "event_indices", None)
+        if type(indices) is not tuple or not indices:
+            raise ValueError("canonical group event indices are missing")
+        if any(type(index) is not int or not 0 <= index < len(event_origins) for index in indices):
+            raise ValueError("canonical group event indices are outside origins")
+        start_ms = _exact_int(getattr(group, "time_ms", None), "group start")
+        item = _observed_group(
+            origins=(event_origins[index] for index in indices),
+            group_type=group_type,
+            start_ms=start_ms,
+            interval=interval,
+        )
+        if item is not None:
+            observed.append(item)
+    return GameplayGroupStageSnapshot(tuple(observed))
+
+
+def count_mania_objects(
+    objects: Sequence[Any],
+    interval: RequiredGameplayIntervalObservation,
+) -> GameplayGroupStageSnapshot:
+    observed = []
+    for obj in objects:
+        if type(obj) is dict:
+            kind = obj.get("kind")
+            start_ms = obj.get("startTimeMs")
+            origins = obj.get("startOrigins")
+        else:
+            kind = getattr(obj, "kind", None)
+            start_ms = getattr(obj, "start_time_ms", None)
+            origins = getattr(obj, "start_origins", None)
+        group_type = {"TAP": "TAP", "HOLD": "HOLD_START"}.get(kind)
+        if group_type is None or type(origins) not in (list, tuple):
+            raise ValueError("mania object origin accounting is malformed")
+        item = _observed_group(
+            origins=origins,
+            group_type=group_type,
+            start_ms=_exact_int(start_ms, "mania object start"),
+            interval=interval,
+        )
+        if item is not None:
+            observed.append(item)
+    return GameplayGroupStageSnapshot(tuple(observed))
+
+
+def first_loss_stage(stages: Sequence[GameplayGroupStageSnapshot]) -> str | None:
+    if len(stages) != len(_STAGE_NAMES):
+        raise ValueError("origin accounting requires exactly five stages")
+    counts = [
+        stage.to_count_dict()["intervalGeneratedCompleteGroups"] for stage in stages
+    ]
+    for index in range(1, len(counts)):
+        if counts[index] < counts[index - 1]:
+            return _STAGE_NAMES[index]
+    return None
+
+
+def required_gameplay_invocation_digest(
+    args: Any,
+    *,
+    audio_path: Path,
+    reference_path: Path,
+    interval: RequiredGameplayIntervalObservation,
+) -> str:
+    audio_path = _regular_file(audio_path, "audio_path")
+    reference_path = _regular_file(reference_path, "reference_path")
+    descriptors = getattr(args, "descriptors", None)
+    if type(descriptors) is not list or any(type(item) is not str for item in descriptors):
+        raise TypeError("descriptors must be an exact string list")
+    payload = {
+        "version": REQUIRED_GAMEPLAY_INVOCATION_VERSION,
+        "input": {
+            "audioSha256": _sha256_path(audio_path),
+            "referenceSha256": _sha256_path(reference_path),
+        },
+        "runtime": {
+            "configName": "v32",
+            "fastDecoderLoop": getattr(args, "fast_decoder_loop"),
+            "maniaHoldStateMode": getattr(args, "mania_hold_state_mode"),
+            "precision": getattr(args, "precision"),
+            "resnapEvents": getattr(args, "resnap_events"),
+        },
+        "generation": {
+            "addToBeatmap": getattr(args, "add_to_beatmap"),
+            "cfgScale": getattr(args, "cfg_scale"),
+            "descriptors": list(descriptors),
+            "difficulty": getattr(args, "difficulty"),
+            "endTimeMs": getattr(args, "end_time"),
+            "gamemode": getattr(args, "gamemode"),
+            "inContext": _context_values(getattr(args, "in_context"), "in_context"),
+            "keycount": getattr(args, "keycount"),
+            "lastAttackTimeMs": getattr(args, "last_attack_time"),
+            "outputType": _context_values(getattr(args, "output_type"), "output_type"),
+            "parallel": getattr(args, "parallel"),
+            "seed": getattr(args, "seed"),
+            "startTimeMs": getattr(args, "start_time"),
+            "superTiming": getattr(args, "super_timing"),
+            "year": getattr(args, "year"),
+        },
+        "requiredGameplayInterval": {
+            "allowedGroupTypes": list(interval.allowed_group_types),
+            "endTimeMs": interval.end_ms,
+            "evidenceClass": interval.evidence_class,
+            "evidenceDigest": interval.evidence_digest,
+            "minimumCompleteGroups": interval.minimum_complete_groups,
+            "mode": interval.mode,
+            "startTimeMs": interval.start_ms,
+        },
+    }
+    canonical = json.dumps(
+        payload,
+        ensure_ascii=True,
+        sort_keys=True,
+        separators=(",", ":"),
+        allow_nan=False,
+    ).encode("ascii")
+    return hashlib.sha256(canonical).hexdigest()
+
+
+def write_generation_origin_diagnostics(
+    output_path: Path,
+    *,
+    evidence_digest: str,
+    invocation_digest: str,
+    interval: RequiredGameplayIntervalObservation,
+    stages: Sequence[GameplayGroupStageSnapshot],
+) -> Path:
+    output_path = _regular_file(output_path, "output_path")
+    _sha256(evidence_digest, "evidence digest")
+    _sha256(invocation_digest, "invocation digest")
+    if len(stages) != len(_STAGE_NAMES) or any(
+        type(stage) is not GameplayGroupStageSnapshot for stage in stages
+    ):
+        raise ValueError("origin accounting requires five typed stages")
+    counts = [stage.to_count_dict() for stage in stages]
+    for previous, current in zip(counts, counts[1:]):
+        if (
+            current["totalGeneratedCompleteGroups"]
+            > previous["totalGeneratedCompleteGroups"]
+            or current["intervalGeneratedCompleteGroups"]
+            > previous["intervalGeneratedCompleteGroups"]
+        ):
+            raise ValueError("generated-origin stage counts must not increase")
+    payload = {
+        "version": GENERATION_ORIGIN_DIAGNOSTICS_VERSION,
+        "output": {
+            "fileName": output_path.name,
+            "size": output_path.stat().st_size,
+            "sha256": _sha256_path(output_path),
+        },
+        "evidenceDigest": evidence_digest,
+        "invocationDigest": invocation_digest,
+        "requiredInterval": interval.to_dict(),
+        "stages": dict(zip(_STAGE_NAMES, counts)),
+        "firstLossStage": first_loss_stage(stages),
+    }
+    encoded = (
+        json.dumps(
+            payload,
+            ensure_ascii=True,
+            sort_keys=True,
+            separators=(",", ":"),
+            allow_nan=False,
+        )
+        + "\n"
+    ).encode("utf-8")
+    if len(encoded) > _MAX_DIAGNOSTICS_BYTES:
+        raise ValueError("generation-origin diagnostics exceeds 1 MiB")
+    sidecar = output_path.with_suffix(GENERATION_ORIGIN_DIAGNOSTICS_SUFFIX)
+    temporary = sidecar.with_name(f".{sidecar.name}.{uuid.uuid4().hex}.tmp")
+    try:
+        with temporary.open("xb") as stream:
+            stream.write(encoded)
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(temporary, sidecar)
+    finally:
+        if temporary.exists():
+            temporary.unlink()
+    return sidecar
