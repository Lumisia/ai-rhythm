+
+def test_first_loss_is_counted_only_after_decoder():
+    interval = required_gameplay_interval_from_args(_observe_args())
+    assert interval is not None
+    groups, origins = _events()
+    full = count_canonical_groups(groups, origins, interval)
+    empty = GameplayGroupStageSnapshot.empty()
+
+    assert first_loss_stage((full, full, empty, empty, empty)) == "canonical"
