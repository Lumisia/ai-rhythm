+import hashlib
+import importlib.util
+import json
+import sys
+from enum import Enum
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+from omegaconf import OmegaConf
+
+MODULE_PATH = (
+    Path(__file__).parents[1]
+    / "osuT5"
+    / "osuT5"
+    / "inference"
+    / "required_gameplay_observation.py"
+)
+SPEC = importlib.util.spec_from_file_location(
+    "required_gameplay_observation_under_test",
+    MODULE_PATH,
+)
+assert SPEC is not None and SPEC.loader is not None
+MODULE = importlib.util.module_from_spec(SPEC)
+sys.modules[SPEC.name] = MODULE
+SPEC.loader.exec_module(MODULE)
+
+GENERATION_ORIGIN_DIAGNOSTICS_VERSION = (
+    MODULE.GENERATION_ORIGIN_DIAGNOSTICS_VERSION
+)
+GameplayGroupStageSnapshot = MODULE.GameplayGroupStageSnapshot
+count_canonical_groups = MODULE.count_canonical_groups
+first_loss_stage = MODULE.first_loss_stage
+required_gameplay_invocation_digest = MODULE.required_gameplay_invocation_digest
+required_gameplay_interval_from_args = MODULE.required_gameplay_interval_from_args
+write_generation_origin_diagnostics = MODULE.write_generation_origin_diagnostics
+
+
+def _context(value):
+    return SimpleNamespace(value=value)
+
+
+class _HydraContext(Enum):
+    TIMING = "timing"
+    MAP = "map"
+
+
+def _origin(kind, window=None, token=None, reference=None):
+    return SimpleNamespace(
+        kind=kind,
+        source_window_id=window,
+        source_token_index=token,
+        reference_event_index=reference,
+    )
+
+
+def _group(time_ms, lane, event_type, *indices):
+    return SimpleNamespace(
+        time_ms=time_ms,
+        lane=lane,
+        event_type=SimpleNamespace(name=event_type),
+        event_indices=indices,
+    )
+
+
+def _args(**overrides):
+    values = {
+        "required_gameplay_interval_mode": "OFF",
+        "required_gameplay_interval_start_time": None,
+        "required_gameplay_interval_end_time": None,
+        "required_gameplay_interval_minimum_complete_groups": None,
+        "required_gameplay_interval_allowed_group_types": None,
+        "required_gameplay_interval_evidence_class": None,
+        "required_gameplay_interval_evidence_digest": None,
+        "gamemode": 3,
+        "keycount": 4,
+        "difficulty": 2.0,
+        "year": 2023,
+        "seed": 17,
+        "precision": "fp16",
+        "add_to_beatmap": True,
+        "start_time": 4000,
+        "end_time": 8000,
+        "last_attack_time": 18000,
+        "mania_hold_state_mode": "incremental",
+        "in_context": [_context("TIMING")],
+        "output_type": [_context("MAP")],
+        "cfg_scale": 1.0,
+        "descriptors": ["style/mixed rice", "streams/bursts"],
+        "parallel": False,
+        "super_timing": False,
+        "fast_decoder_loop": True,
+        "resnap_events": True,
+    }
+    return SimpleNamespace(**(values | overrides))
+
+
+def _observe_args(**overrides):
+    values = {
+        "required_gameplay_interval_mode": "OBSERVE",
+        "required_gameplay_interval_start_time": 5000,
+        "required_gameplay_interval_end_time": 6000,
+        "required_gameplay_interval_minimum_complete_groups": 1,
+        "required_gameplay_interval_allowed_group_types": ["HOLD_START", "TAP"],
+        "required_gameplay_interval_evidence_class": "BROADBAND_ATTACK",
+        "required_gameplay_interval_evidence_digest": "a" * 64,
+    }
+    return _args(**(values | overrides))
+
+
+def test_off_has_no_observer_and_rejects_a_half_contract():
+    assert required_gameplay_interval_from_args(_args()) is None
+
+    with pytest.raises(ValueError, match="OFF.*stray"):
+        required_gameplay_interval_from_args(
+            _args(required_gameplay_interval_start_time=5000)
+        )
+
+
+def test_default_yaml_preserves_off_as_a_string_not_yaml_boolean():
+    config = OmegaConf.load(Path(__file__).parents[1] / "configs" / "inference" / "default.yaml")
+
+    assert config.required_gameplay_interval_mode == "OFF"
+    assert type(config.required_gameplay_interval_mode) is str
+
+
+def test_hydra_context_enums_are_normalized_to_contract_names():
+    interval = required_gameplay_interval_from_args(
+        _observe_args(
+            in_context=[_HydraContext.TIMING],
+            output_type=[_HydraContext.MAP],
+        )
+    )
+
+    assert interval is not None
+
+
+@pytest.mark.parametrize(
+    ("override", "message"),
+    [
+        ({"required_gameplay_interval_mode": "SHADOW_ENFORCE"}, "observe-only"),
+        ({"required_gameplay_interval_mode": "UNKNOWN"}, "mode"),
+        ({"required_gameplay_interval_start_time": True}, "start"),
+        ({"required_gameplay_interval_end_time": 5000}, "before"),
+        ({"required_gameplay_interval_minimum_complete_groups": 0}, "minimum"),
+        ({"required_gameplay_interval_allowed_group_types": ["TAP", "TAP"]}, "allowed"),
+        ({"required_gameplay_interval_allowed_group_types": ["HOLD_END"]}, "allowed"),
+        ({"required_gameplay_interval_evidence_class": "UNKNOWN"}, "evidence class"),
+        ({"required_gameplay_interval_evidence_digest": "bad"}, "digest"),
+        ({"gamemode": 0}, "mania"),
+        ({"add_to_beatmap": False}, "partial"),
+        ({"start_time": None}, "partial"),
+        ({"end_time": None}, "partial"),
+        ({"start_time": 5500}, "fit"),
+        ({"end_time": 5500}, "fit"),
+        ({"seed": None}, "seed"),
+        ({"resnap_events": False}, "resnap"),
+    ],
+)
+def test_observe_contract_rejects_ambiguous_or_unsupported_values(override, message):
+    with pytest.raises((TypeError, ValueError), match=message):
+        required_gameplay_interval_from_args(_observe_args(**override))
+
+
+def _events():
+    groups = [
+        _group(5000, 0, "CIRCLE", 0, 1),
+        _group(5000, 1, "CIRCLE", 2, 3),
+        _group(6000, 2, "HOLD_NOTE", 4, 5),
+        _group(6500, 2, "HOLD_NOTE_END", 6, 7),
+    ]
+    origins = [_origin("GENERATED", 7, index) for index in range(8)]
+    return groups, origins
+
+
+def test_group_snapshot_counts_chords_boundaries_and_hold_starts_not_ends():
+    interval = required_gameplay_interval_from_args(_observe_args())
+    assert interval is not None
+    groups, origins = _events()
+
+    snapshot = count_canonical_groups(groups, origins, interval)
+
+    assert snapshot.to_count_dict() == {
+        "totalGeneratedCompleteGroups": 3,
+        "intervalGeneratedCompleteGroups": 3,
+        "tapGroups": 2,
+        "holdStartGroups": 1,
+    }
+
+
+def test_reference_groups_do_not_satisfy_and_origin_identity_deduplicates():
+    interval = required_gameplay_interval_from_args(_observe_args())
+    assert interval is not None
+    groups, origins = _events()
+    reference = list(origins)
+    for index in groups[0].event_indices:
+        reference[index] = _origin("REFERENCE", reference=index)
+
+    first = count_canonical_groups(groups, reference, interval)
+    second = count_canonical_groups(groups, reference, interval)
+    merged = first.merge(second)
+
+    assert first.to_count_dict()["intervalGeneratedCompleteGroups"] == 2
+    assert merged == first
+
+
+def test_incomplete_group_fails_instead_of_being_hidden():
+    interval = required_gameplay_interval_from_args(_observe_args())
+    assert interval is not None
+    groups = [_group(5000, 0, "CIRCLE")]
+    with pytest.raises(ValueError, match="event indices"):
+        count_canonical_groups(
+            groups,
+            [],
+            interval,
+        )
