+
+def test_writer_binds_output_and_emits_first_loss_without_mutation(tmp_path: Path):
+    output = tmp_path / "out.osu"
+    output.write_bytes(b"osu file format v14\n")
+    interval = required_gameplay_interval_from_args(_observe_args())
