+def test_serialized_mania_rebind_updates_only_reference_objects():
+    events = [
+        Event(EventType.TIME_SHIFT, 1_000),
+        Event(EventType.POS_X, 64),
+        Event(EventType.POS_Y, 192),
+        Event(EventType.HOLD_NOTE, 0),
+        Event(EventType.TIME_SHIFT, 2_000),
+        Event(EventType.POS_X, 64),
+        Event(EventType.POS_Y, 192),
+        Event(EventType.HOLD_NOTE_END, 0),
+        Event(EventType.TIME_SHIFT, 2_500),
+        Event(EventType.POS_X, 192),
+        Event(EventType.POS_Y, 192),
+        Event(EventType.CIRCLE, 0),
+    ]
+    origins = [
+        *[EventOrigin.reference(index) for index in range(8)],
+        *[EventOrigin.generated(0, index) for index in range(4)],
+    ]
+    postprocessor = make_postprocessor()
+    result = postprocessor.generate(
+        events,
+        BeatmapConfig(mode=3, circle_size=4),
+        event_times=[1_000] * 4 + [2_000] * 4 + [2_500] * 4,
+        event_origins=origins,
+    )
+    rebound_result = result.replace(
+        "64,192,1000,128,0,2000:",
+        "64,192,1000,128,0,2500:",
+    )
+
+    postprocessor.rebind_mania_objects_to_serialized_result(
+        rebound_result,
+        key_count=4,
+    )
+
+    objects = postprocessor.last_mania_objects_report["maniaObjects"]
+    assert [(item["kind"], item["startTimeMs"], item["endTimeMs"]) for item in objects] == [
+        ("HOLD", 1_000, 2_500),
+        ("TAP", 2_500, None),
+    ]
+    assert {origin["kind"] for origin in objects[0]["startOrigins"]} == {
+        "REFERENCE"
+    }
+    assert {origin["kind"] for origin in objects[1]["startOrigins"]} == {
+        "GENERATED"
+    }
+
+
+def test_serialized_mania_rebind_rejects_generated_drift_transactionally():
+    events = [
+        Event(EventType.TIME_SHIFT, 1_000),
+        Event(EventType.POS_X, 64),
+        Event(EventType.POS_Y, 192),
+        Event(EventType.CIRCLE, 0),
+    ]
+    postprocessor = make_postprocessor()
+    result = postprocessor.generate(
+        events,
+        BeatmapConfig(mode=3, circle_size=4),
+        event_times=[1_000] * 4,
+        event_origins=[EventOrigin.generated(0, index) for index in range(4)],
+    )
+    report_before = json.loads(json.dumps(postprocessor.last_mania_objects_report))
+    rebound_result = result.replace(",1000,1,", ",1100,1,")
+
+    with pytest.raises(ValueError, match="generated Mania object changed"):
+        postprocessor.rebind_mania_objects_to_serialized_result(
+            rebound_result,
+            key_count=4,
+        )
+
+    assert postprocessor.last_mania_objects_report == report_before
+
+
