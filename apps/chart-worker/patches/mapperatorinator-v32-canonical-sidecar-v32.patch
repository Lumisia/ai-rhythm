+    def rebind_mania_objects_to_serialized_result(
+            self,
+            serialized_result: str,
+            *,
+            key_count: int,
+    ) -> None:
+        """Bind provenance records to the final serialized Mania objects.
+
+        Partial generation serializes a generated/reference composite and then
+        ``add_to_beatmap`` restores reference-owned objects outside the replaced
+        interval.  That second serialization may change reference timestamps,
+        so the pre-serialization object report cannot be published unchanged.
+        Generated or mixed-provenance objects must remain byte-equivalent; a
+        change there is a generation defect and fails before the sidecar is
+        written.
+        """
+        if type(serialized_result) is not str:
+            raise TypeError("serialized_result must be an exact string")
+        if type(key_count) is not int or key_count <= 0:
+            raise TypeError("key_count must be an exact positive integer")
+
+        source_objects = self.last_mania_objects_report.get("maniaObjects")
+        duplicates = self.last_mania_objects_report.get("duplicates")
+        if type(source_objects) is not list or type(duplicates) is not list:
+            raise TypeError("mania object report must contain exact arrays")
+
+        serialized_objects = []
+        for hit_object in Beatmap.parse(serialized_result)._hit_objects:
+            if isinstance(hit_object, HoldNote):
+                kind = "HOLD"
+                end_time_ms = int(round(hit_object.end_time.total_seconds() * 1000))
+            elif isinstance(hit_object, Circle):
+                kind = "TAP"
+                end_time_ms = None
+            else:
+                raise ValueError(
+                    "serialized Mania result contains an unsupported hit object: "
+                    f"{type(hit_object).__name__}"
+                )
+            serialized_objects.append({
+                "lane": self._mania_lane(hit_object.position.x, key_count),
+                "kind": kind,
+                "startTimeMs": int(round(hit_object.time.total_seconds() * 1000)),
+                "endTimeMs": end_time_ms,
+            })
+
+        source_by_lane = {}
+        for item in source_objects:
+            if type(item) is not dict:
+                raise TypeError("mania object report entries must be exact objects")
+            source_by_lane.setdefault(item.get("lane"), []).append(item)
+        serialized_by_lane = {}
+        for item in serialized_objects:
+            serialized_by_lane.setdefault(item["lane"], []).append(item)
+        if set(source_by_lane) != set(serialized_by_lane):
+            raise ValueError("serialized Mania lane set changed before sidecar binding")
+
+        rebound = []
+        for lane in sorted(source_by_lane):
+            source_lane = sorted(
+                source_by_lane[lane],
+                key=lambda item: (
+                    item.get("startTimeMs"),
+                    0 if item.get("kind") == "HOLD" else 1,
+                    item.get("objectId"),
+                ),
+            )
+            serialized_lane = sorted(
+                serialized_by_lane[lane],
+                key=lambda item: (
+                    item["startTimeMs"],
+                    0 if item["kind"] == "HOLD" else 1,
+                ),
+            )
+            if len(source_lane) != len(serialized_lane):
+                raise ValueError(
+                    "serialized Mania object count changed before sidecar binding: "
+                    f"lane={lane}, source={len(source_lane)}, "
+                    f"serialized={len(serialized_lane)}"
+                )
+            if [item.get("kind") for item in source_lane] != [
+                item["kind"] for item in serialized_lane
+            ]:
+                raise ValueError(
+                    "serialized Mania object kinds changed before sidecar binding: "
+                    f"lane={lane}"
+                )
+
+            for source, serialized in zip(source_lane, serialized_lane):
+                changed = (
+                    source.get("startTimeMs") != serialized["startTimeMs"]
+                    or source.get("endTimeMs") != serialized["endTimeMs"]
+                )
+                if changed:
+                    origins = [
+                        *source.get("startOrigins", []),
+                        *source.get("endOrigins", []),
+                    ]
+                    if not origins or any(
+                            type(origin) is not dict
+                            or origin.get("kind") != "REFERENCE"
+                            for origin in origins
+                    ):
+                        raise ValueError(
+                            "generated Mania object changed during final serialization: "
+                            f"lane={lane}, kind={source.get('kind')}, "
+                            f"source={source.get('startTimeMs')}.."
+                            f"{source.get('endTimeMs')}, "
+                            f"serialized={serialized['startTimeMs']}.."
+                            f"{serialized['endTimeMs']}"
+                        )
+                rebound_item = dict(source)
+                rebound_item["startTimeMs"] = serialized["startTimeMs"]
+                rebound_item["endTimeMs"] = serialized["endTimeMs"]
+                rebound.append(rebound_item)
+
+        rebound.sort(key=lambda item: (
+            item["startTimeMs"],
+            item["lane"],
+            0 if item["kind"] == "HOLD" else 1,
+            item["startGroupId"],
+        ))
+        rebound = [
+            {**item, "objectId": object_id}
+            for object_id, item in enumerate(rebound)
+        ]
+        self.last_mania_objects_report = {
+            "maniaObjects": rebound,
+            "duplicates": [dict(item) for item in duplicates],
+        }
+
