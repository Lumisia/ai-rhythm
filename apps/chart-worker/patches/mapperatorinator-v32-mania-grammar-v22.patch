+def test_column_conversion_discards_conflicting_legacy_position_attributes():
+    processor = make_processor()
+    events = [
+        Event(EventType.TIME_SHIFT, 100),
+        Event(EventType.MANIA_COLUMN, 0),
+        Event(EventType.POS_X, -48),
+        Event(EventType.POS_Y, 192),
+        Event(EventType.HOLD_NOTE, 0),
+    ]
+    times = [100] * len(events)
+    origins = [EventOrigin.generated(8, i) for i in range(len(events))]
+
+    converted_events, converted_times, converted_origins = (
+        processor._convert_column_to_position(events, times, 6, origins)
+    )
+
+    assert [(event.type, event.value) for event in converted_events] == [
+        (EventType.TIME_SHIFT, 100),
+        (EventType.POS_X, 42),
+        (EventType.POS_Y, 192),
+        (EventType.HOLD_NOTE, 0),
+    ]
+    assert converted_times == [100, 100, 100, 100]
+    assert converted_origins == [origins[0], origins[1], origins[1], origins[4]]
+
+
