+def test_prompt_hold_start_is_not_replayed_over_prompt_end_state():
+    processor = ManiaHoldStateLogitsProcessor(FakeTokenizer(), (2,))
+    prompt = torch.tensor(
+        [[keycount_token(4), 1, 30, 12, 51]]
+    )
+
+    first_generated_group = processor(prompt, scores())
+    pending_same_lane = processor(
+        torch.tensor([[keycount_token(4), 1, 30, 12, 51, 31, 12]]),
+        scores(),
+    )
+
+    assert torch.isneginf(first_generated_group[0, 50:53]).all()
+    assert torch.isneginf(pending_same_lane[0, 50])
+    assert torch.isneginf(pending_same_lane[0, 51])
+    assert not torch.isneginf(pending_same_lane[0, 52])
+
+
+def test_prompt_hold_end_is_not_replayed_over_prompt_end_state():
+    processor = ManiaHoldStateLogitsProcessor(FakeTokenizer(), ())
+    prompt = torch.tensor(
+        [[keycount_token(4), 1, 30, 12, 52]]
+    )
+
+    first_generated_group = processor(prompt, scores())
+    pending_same_lane = processor(
+        torch.tensor([[keycount_token(4), 1, 30, 12, 52, 31, 12]]),
+        scores(),
+    )
+
+    assert torch.isneginf(first_generated_group[0, 50:53]).all()
+    assert not torch.isneginf(pending_same_lane[0, 50])
+    assert not torch.isneginf(pending_same_lane[0, 51])
+    assert torch.isneginf(pending_same_lane[0, 52])
+
