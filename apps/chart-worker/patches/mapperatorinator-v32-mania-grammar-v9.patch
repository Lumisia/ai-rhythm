+
+
+def test_canonical_replay_allows_release_then_tap_at_same_time():
+    groups = [
+        CanonicalManiaGroup(100, 1, EventType.HOLD_NOTE_END, (0,)),
+        CanonicalManiaGroup(100, 1, EventType.CIRCLE, (1,)),
+    ]
