+def test_prompt_timeline_blocks_generated_tap_inside_an_existing_hold():
+    processor = ManiaHoldStateLogitsProcessor(FakeTokenizer(), ())
+    prompt = torch.tensor(
+        [[
+            keycount_token(4), 1,
+            30, 12, 51,
+            32, 12, 52,
+        ]]
+    )
+    processor(prompt, scores())
+
+    pending_inside_hold = torch.tensor(
+        [[
+            keycount_token(4), 1,
+            30, 12, 51,
+            32, 12, 52,
+            31, 12,
+        ]]
+    )
+    result = processor(pending_inside_hold, scores())
+
+    assert torch.isneginf(result[0, 50])
+
+
+def test_prompt_timeline_blocks_different_note_on_at_same_time_and_lane():
+    processor = ManiaHoldStateLogitsProcessor(FakeTokenizer(), ())
+    prompt = torch.tensor(
+        [[
+            keycount_token(4), 1,
+            30, 12, 51,
+            32, 12, 52,
+        ]]
+    )
+    processor(prompt, scores())
+
+    pending_same_position = torch.tensor(
+        [[
+            keycount_token(4), 1,
+            30, 12, 51,
+            32, 12, 52,
+            30, 12,
+        ]]
+    )
+    result = processor(pending_same_position, scores())
+
+    assert torch.isneginf(result[0, 50])
+    # An exact cross-window duplicate remains idempotent and is resolved by
+    # origin-aware canonical merging. Only a different note-on is forbidden.
+    assert not torch.isneginf(result[0, 51])
+
+
+def test_prompt_timeline_allows_release_then_tap_at_same_time_and_lane():
+    processor = ManiaHoldStateLogitsProcessor(FakeTokenizer(), (2,))
+    prompt = torch.tensor(
+        [[keycount_token(4), 1, 30, 12, 52]]
+    )
+    processor(prompt, scores())
+
+    pending_after_release = torch.tensor(
+        [[keycount_token(4), 1, 30, 12, 52, 30, 12]]
+    )
+    result = processor(pending_after_release, scores())
+
+    assert not torch.isneginf(result[0, 50])
+    assert not torch.isneginf(result[0, 51])
+    assert not torch.isneginf(result[0, 52])
+
+
+def test_canonical_replay_rejects_two_note_ons_at_same_time_and_lane():
+    groups = [
