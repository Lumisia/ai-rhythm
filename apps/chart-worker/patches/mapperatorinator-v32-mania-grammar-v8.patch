diff --git a/osuT5/osuT5/inference/mania_grammar.py b/osuT5/osuT5/inference/mania_grammar.py
index a4e0c0d..25bf739 100644
--- a/osuT5/osuT5/inference/mania_grammar.py
+++ b/osuT5/osuT5/inference/mania_grammar.py
@@ -155,6 +155,7 @@ def replay_mania_hold_state(
         EventType.CIRCLE: 2,
     }
     unique_groups = {group.signature: group for group in groups}
+    lane_history: dict[int, list[CanonicalManiaGroup]] = {}
     for group in sorted(
             unique_groups.values(),
             key=lambda item: (item.time_ms, item.lane, order[item.event_type]),
@@ -164,5 +165,22 @@ def replay_mania_hold_state(
                 f"mania lane {group.lane} is outside keycount {keycount} "
                 f"at {group.time_ms}"
             )
-        apply_mania_hold_transition(open_columns, group.lane, group.event_type)
+        try:
+            apply_mania_hold_transition(
+                open_columns,
+                group.lane,
+                group.event_type,
+            )
+        except ValueError as error:
+            history = ",".join(
+                f"{item.time_ms}:{item.event_type.name}"
+                for item in lane_history.get(group.lane, [])[-8:]
+            )
+            raise ValueError(
+                f"{error}; offending=time={group.time_ms},lane={group.lane},"
+                f"type={group.event_type.name}; laneHistory=[{history}]"
+            ) from error
+        history = lane_history.setdefault(group.lane, [])
+        history.append(group)
+        del history[:-8]
     return tuple(sorted(open_columns))
